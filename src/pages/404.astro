---
import Base from "../layouts/Base.astro";
import { SERVICES } from "../lib/nav";
const base = import.meta.env.BASE_URL;
---
<Base title="페이지를 찾을 수 없습니다" description="요청한 페이지가 없습니다. 숫자 너머의 서비스 목록에서 원하는 통계를 찾아보세요." noindex>
  <div class="wrap">
    <section class="hero">
      <div class="eyebrow">404</div>
      <h1>이 숫자는 통계에 없습니다</h1>
      <p class="lede">주소가 바뀌었거나 없는 페이지입니다. 시군구 페이지라면 행정구역 개편으로 코드가 달라졌을 수 있으니 목록에서 다시 찾아 주세요.</p>
      <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:18px">
        <a class="btn btn-primary" href={base}>홈으로</a>
        <a class="btn" href={`${base}dongne/`}>우리 동네 찾기</a>
      </div>
    </section>
    <section class="section">
      <h2>서비스</h2>
      <div class="grid grid-2">
        {SERVICES.map((s) => (
          <a class="card svc" href={`${base}${s.slug}/`}>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>
