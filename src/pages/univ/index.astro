---
import Base from "../../layouts/Base.astro";
import Chart from "../../components/Chart.astro";
import ChartSwitch from "../../components/ChartSwitch.astro";
import Stat from "../../components/Stat.astro";
import BarList from "../../components/BarList.astro";
import KoreaMap from "../../components/KoreaMap.astro";
import data from "../../data/univ.json";
import { pts, val } from "../../lib/series";
import { int, compact, pct } from "../../lib/format";

const d = data as any;
const base = import.meta.env.BASE_URL;
const h = d.headline;
const n = d.national;
const { last: L, projEnd, ratio, ratioLow, ratioHigh, bornCutoff } = d.meta;
const emptyOf10 = Math.round((1 - h.fill2040) * 10);

// 히어로: 입학 자리 100칸
const wYears = [L, 2030, 2033, 2035, 2037, 2040, 2042, 2045];
const waffle = {
  type: "waffle" as const, caption: "칸", autoplay: true, speed: 1000, start: 0,
  groups: [{ name: "채워지는 자리", color: "var(--series-1)" }, { name: "비는 자리", color: "var(--neutral-series)" }],
  frames: wYears.map((y) => {
    const f = y === L ? 1 : val(n.fill, y) ?? 1;
    return { label: y, values: [f * 100, 100 - f * 100] };
  }),
};

// 18세 인구 vs 입학 규모
const age18 = { ...n.age18, ...n.age18Proj.mid };
const demandSpec = {
  type: "line" as const, yFormat: "man" as const, height: 360, projStart: L,
  series: [
    { name: "입학자 (실측)", color: "var(--series-1)", data: pts(n.entrantsTotal, 2005), width: 2.5, label: false },
    { name: "입학 수요 (기준)", color: "var(--series-1)", data: [[L, n.entrantsTotal[String(L)]], ...pts(n.demand.mid)] as [number, number | null][], dash: true, label: true },
    { name: "18세 인구 (전년 말)", color: "var(--series-2)", data: pts(age18), label: true },
  ],
  bands: [{ name: `수요 범위 (18세 1명당 ${ratioLow}~${ratioHigh}명)`, color: "var(--series-1)", lower: pts(n.demand.low), upper: pts(n.demand.high) }],
  hLines: [{ y: h.cap, label: `지금 입학 규모 ${compact(h.cap)}` }],
  markers: [{ x: bornCutoff, label: `${bornCutoff}년 입학생까지 이미 태어남` }],
};
const seatSpec = {
  type: "line" as const, yFormat: "dec2" as const, height: 360, projStart: L, zeroBased: false,
  series: [
    { name: "18세 1명당 입학 자리", color: "var(--series-2)", data: pts(n.seatsPer18), label: true },
    { name: "18세 1명당 실제 입학자", color: "var(--series-1)", data: pts(n.ratioHist), label: true },
    { name: "고교 졸업자 1명당 입학자", color: "var(--series-3)", data: pts(n.gradRatioHist), label: true },
  ],
  hLines: [{ y: 1, label: "1명당 1자리" }],
};
const tYears = [2005, 2010, 2015, 2020, 2024, L, 2030, 2035, 2038, 2040, 2042, 2045, 2050];
const demandTable = {
  headers: ["입학 연도", "18세 인구", "입학자·수요(기준)", "수요 범위", "자리 채움률"],
  rows: tYears.map((y) => [
    `${y}${y > L ? " (추계)" : ""}`,
    int(val(age18, y)),
    int(y <= L ? val(n.entrantsTotal, y) : val(n.demand.mid, y)),
    y > L ? `${compact(val(n.demand.low, y))}~${compact(val(n.demand.high, y))}` : "–",
    y > L ? pct(val(n.fill, y), 0) : "–",
  ]),
};

// 4년제 vs 전문대
const typeYears = Object.keys(n.byType.u).map(Number);
const typeSpec = {
  type: "line" as const, yFormat: "pct" as const, height: 300, projStart: L, yMax: 1.02,
  series: [
    { name: "4년제", color: "var(--series-1)", data: [[L, 1], ...typeYears.map((y) => [y, n.byType.u[String(y)] / n.capByType.u])] as [number, number][], label: true },
    { name: "전문대", color: "var(--series-2)", data: [[L, 1], ...typeYears.map((y) => [y, n.byType.c[String(y)] / n.capByType.c])] as [number, number][], label: true },
  ],
};
const histTypeSpec = {
  type: "line" as const, yFormat: "man" as const, height: 300,
  series: [
    { name: "4년제 입학자", color: "var(--series-1)", data: pts(n.entrants.u), label: true },
    { name: "전문대 입학자", color: "var(--series-2)", data: pts(n.entrants.c), label: true },
  ],
};

// 시도
const sidos = d.sidos as any[];
const sidoNames = Object.fromEntries(sidos.map((s) => [s.id, s.name]));
const mapYears = Object.keys(sidos[0].fill).map(Number).filter((y) => y <= 2045);
const sidoMetrics = [
  { key: "fill", label: "입학 자리 채움률", format: "pct" as const, kind: "seq" as const, breaks: [0.4, 0.5, 0.6, 0.7, 0.8, 0.9], desc: `지금 입학 규모 대비 채워지는 비율(기준 시나리오). ▶ 를 누르면 ${mapYears[0]}→2045년을 재생합니다.`,
    frames: { labels: mapYears, values: mapYears.map((y) => Object.fromEntries(sidos.map((s) => [s.id, s.fill[String(y)]]))), start: mapYears.indexOf(2040) } },
  { key: "local", label: "지역 18세 1명당 지역 대학 자리", format: "dec1" as const, kind: "seq" as const, breaks: [0.6, 0.9, 1.2, 1.5, 2, 2.5], desc: "1보다 크면 다른 지역 학생을 데려와야 정원이 찹니다(지금 기준).", values: Object.fromEntries(sidos.map((s) => [s.id, s.localRatio])) },
  { key: "local40", label: "같은 값, 2040년", format: "dec1" as const, kind: "seq" as const, breaks: [0.6, 0.9, 1.2, 1.5, 2, 2.5, 3], desc: "입학 규모가 그대로이고 18세 인구만 줄어들 때.", values: Object.fromEntries(sidos.map((s) => [s.id, s.localRatio2040])) },
];
const fillBars = [...sidos].sort((a, b) => a.fill2040 - b.fill2040).map((s) => ({ name: s.name, value: s.fill2040 }));
const shock = (d.backtest.shock2021 as any[]).slice().sort((a, b) => a.change - b.change).map((s) => ({ name: s.name, value: s.change }));
const capShock = (() => {
  const c = d.backtest.shock2021.filter((s: any) => ["11", "28", "41"].includes(s.id));
  return c.reduce((a: number, s: any) => a + s.change, 0) / c.length;
})();
const bt = d.backtest.regional as any[];
---
<Base title="대학은 얼마나 남을까?" active="univ" description={`18세 인구 추계와 대학·전문대 입학자 통계를 결합한 시도별 대학 충원 전망. 지금 입학 규모(${compact(h.cap)}명)가 그대로라면 2040년에는 자리의 약 ${pct(1 - h.fill2040)}가 빕니다.`}>
  <div class="wrap">
    <section class="hero hero-split">
      <div>
        <div class="eyebrow">대학은 얼마나 남을까? · 18세 인구 × 대학 입학자 × 고교 졸업자</div>
        <h1>2040년, 대학 입학 자리 10개 중 {emptyOf10}개가 빕니다</h1>
        <p class="lede">
          {bornCutoff}년 대학 입학생까지는 이미 태어났습니다. 그래서 대학 입학 연령 인구는 출산율 가정과 상관없이 거의 확정된 숫자입니다.
          지금 4년제·전문대 입학자는 <strong>{compact(h.cap)}명</strong>인데, 18세 인구는 {compact(h.age18Now)}명에서 2040년 <strong>{compact(h.age18_2040)}명</strong>으로 줄어듭니다.
        </p>
        <p class="lede" style="font-size:16px">줄어드는 학생이 어디서 먼저 빠지는지는 과거 충원 자료로 시도·학교 유형마다 따로 추정했습니다.</p>
      </div>
      <Chart spec={waffle} title={`입학 자리 100칸: ${L} → 2045`} sub="지금 입학 규모 대비 채워지는 자리 (기준 시나리오)" />
    </section>

    <div class="grid grid-4">
      <Stat label={`입학 규모 (${L})`} value={compact(h.cap)} unit="명" note={`4년제 ${compact(h.capU)} · 전문대 ${compact(h.capC)}`} />
      <Stat label="18세 인구" value={`${compact(h.age18Now)} → ${compact(h.age18_2040)}`} note={`${L}년 입학 세대 → 2040년 입학 세대`} tone="down" />
      <Stat label="2040년 빈 자리" value={compact(h.empty2040)} unit="개" note={`범위 ${compact(h.empty2040Range[0])}~${compact(h.empty2040Range[1])}`} tone="down" />
      <Stat label="채움률 90% 아래" value={`${h.first90}년`} note={`70% 아래 ${h.first70 ?? "–"}년 · 가장 적은 해 ${h.minYear}년`} />
    </div>

    <section class="section">
      <h2>자리는 그대로, 사람은 반으로</h2>
      <p class="section-desc">실선은 실제 입학자, 점선은 18세 인구로 계산한 입학 수요입니다. 2030년대 초반까지는 2007~2012년생(황금돼지띠·흑룡띠)이 받쳐 주지만, 2035년부터 2016년 이후 출생 급감 세대가 입학하면서 수요가 빠르게 줄어듭니다.</p>
      <ChartSwitch views={[{ label: "입학 수요", spec: demandSpec }, { label: "1명당 자리", spec: seatSpec, note: `18세 인구가 줄던 2020~2025년, 실제 입학자는 18세 1명당 ${n.ratioHist["2019"].toFixed(2)}명에서 ${n.ratioHist["2025"].toFixed(2)}명으로 늘었습니다. 재수생·만학도·외국인 유학생으로 메운 결과입니다.` }]} table={demandTable} title="대학 입학 수요와 18세 인구" sub={`2005~${projEnd}년, 4년제(교육대·산업대 포함)와 전문대 합계`} />
    </section>

    <section class="section grid grid-2">
      <div class="card">
        <h3 class="card-title">"18세 1명당 입학자"는 이미 1을 넘었다</h3>
        <p class="card-sub">이 사이트가 가장 크게 가정하는 부분입니다</p>
        <p class="small">입학자에는 그해 고교 졸업생뿐 아니라 재수생, 성인 학습자, 외국인 유학생이 섞여 있습니다. 18세 인구가 줄면 대학은 이들로 자리를 메워 왔고, 그 결과 18세 1명당 입학자가 {pct(n.ratioHist["2019"], 0)}에서 {pct(n.ratioHist["2025"], 0)}까지 올랐습니다.</p>
        <p class="small">그래서 미래 입학 수요는 한 숫자로 못 박지 않고 범위로 둡니다.</p>
        <ul class="small">
          <li><strong>기준:</strong> 최근 3년 평균 {ratio.toFixed(2)}명</li>
          <li><strong>낮음:</strong> {ratioLow.toFixed(2)}명 (2021~2023년 수준)</li>
          <li><strong>높음:</strong> {ratioHigh.toFixed(2)}명 (유학생·성인 학습자 유치를 지금보다 더 늘린 경우)</li>
        </ul>
        <p class="small muted">높음 시나리오에서도 2040년 채움률은 {pct(h.fill2040Range[1], 0)}입니다. 메울 방법을 아무리 넓혀도 인구 감소의 크기를 이기기 어렵다는 뜻입니다.</p>
      </div>
      <ChartSwitch views={[{ label: "채움률 전망", spec: typeSpec }, { label: "과거 입학자", spec: histTypeSpec }]} title="4년제와 전문대" sub={`2040년 채움률: 4년제 ${pct(h.fillU2040)} · 전문대 ${pct(h.fillC2040)} (기준)`} />
    </section>

    <section class="section" id="map">
      <h2>어느 지역이 먼저 비나</h2>
      <p class="section-desc">2020→2021년처럼 입학자가 갑자기 줄었던 해, 수도권(서울·인천·경기 평균 {pct(capShock, 1, true)})보다 지방에서 더 많이 줄었습니다. 이런 과거 반응을 시도 × 학교 유형마다 탄력성으로 추정해 미래 수요를 나눴습니다. 그 결과 2040년 채움률은 {fillBars.at(-1)!.name}이 {pct(fillBars.at(-1)!.value)}로 가장 높고, {fillBars[0].name}이 {pct(fillBars[0].value)}로 가장 낮습니다.</p>
      <div class="grid grid-2">
        <KoreaMap level="sido" metrics={sidoMetrics} names={sidoNames} rank={false} compact title="시도별 대학 충원 전망" sub="기준 시나리오" />
        <div class="card">
          <h3 class="card-title">2040년 입학 자리 채움률</h3>
          <p class="card-sub">지금 입학 규모가 그대로일 때</p>
          <BarList items={fillBars} format="pct" />
        </div>
      </div>
      <div class="table-wrap" style="margin-top:16px">
        <table>
          <thead><tr><th>시도</th><th class="num">입학 규모 {L}</th><th class="num">4년제</th><th class="num">전문대</th><th class="num">2016→{L}</th><th class="num">채움률 2035</th><th class="num">채움률 2040</th><th class="num">빈 자리 2040</th><th class="num">지역 18세 1명당 자리</th></tr></thead>
          <tbody>
            {[...sidos].sort((a, b) => a.fill2040 - b.fill2040).map((s) => (
              <tr><td>{s.name}{s.capital ? " (수도권)" : ""}</td><td class="num">{int(s.cap)}</td><td class="num">{int(s.capU)}</td><td class="num">{int(s.capC)}</td><td class="num">{pct(s.change2016, 0, true)}</td><td class="num">{pct(s.fill2035)}</td><td class="num">{pct(s.fill2040)}</td><td class="num">{int(s.empty2040)}</td><td class="num">{s.localRatio?.toFixed(2)} → {s.localRatio2040?.toFixed(2)}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section grid grid-2" id="backtest">
      <div class="card">
        <h3 class="card-title">2020→2021년 입학자 변화</h3>
        <p class="card-sub">18세 인구가 한 해 만에 {pct(-(n.age18["2021"] / n.age18["2020"] - 1), 1)} 줄었을 때, 시도별로 얼마나 줄었나</p>
        <BarList items={shock} format="pct1S" diverging />
      </div>
      <div class="card">
        <h3 class="card-title">과거 검증: 지역 배분이 맞았나</h3>
        <p class="card-sub">그 해까지 자료로 탄력성을 추정하고, 몇 년 뒤의 전국 입학자 수를 주면 시도별 입학자를 얼마나 맞히는지</p>
        <div class="table-wrap">
          <table>
            <thead><tr><th>추정 → 예측</th><th class="num">전국 변화</th><th class="num">이 모형</th><th class="num">모두 같은 비율</th></tr></thead>
            <tbody>{bt.map((b) => <tr><td>{b.fitEnd} → {b.target}</td><td class="num">{pct(b.natChange, 1, true)}</td><td class="num"><strong>{pct(b.mae, 1)}</strong></td><td class="num">{pct(b.naiveMae, 1)}</td></tr>)}</tbody>
          </table>
        </div>
        <p class="small muted" style="margin-top:10px">시도별 평균 절대오차. 전국 입학자가 줄었던 시기에는 "모든 지역이 같은 비율로 줄어든다"고 볼 때보다 오차가 작습니다. 18세 인구 자체는 이미 태어난 세대라 오차가 거의 없지만, 18세 1명당 입학자 비율은 위의 범위만큼 불확실합니다.</p>
      </div>
    </section>

    <section class="section card method" id="method">
      <h2>방법론</h2>
      <h3>1. 입학 수요</h3>
      <pre class="formula">입학 수요(Y) = r × 18세 인구(Y−1년 말)
r = 최근 3년({d.meta.ratioYears[0]}~{L}) 입학자 ÷ 18세 인구 = {ratio.toFixed(3)}   (범위 {ratioLow}~{ratioHigh})</pre>
      <p>18세 인구는 주민등록 1세별 인구와 이 사이트의 인구 추계(중위)에서 가져옵니다. {bornCutoff}년 입학생까지는 이미 태어난 아이들이라 사망·이동만 반영되며, 그 뒤로는 출산율 시나리오가 영향을 줍니다.</p>
      <h3>2. 입학 규모 (정원 대용)</h3>
      <p>KOSIS에는 대학별 입학정원 표가 없어, {L}년 실제 입학자 수(대학·교육대학·산업대학·전문대학, 정원 외 포함)를 "지금 입학 규모"로 썼습니다. 미충원이 이미 있는 대학은 실제 정원이 더 크므로, 빈 자리는 적게 잡힌 값입니다.</p>
      <h3>3. 지역·학교 유형 배분</h3>
      <pre class="formula">Δlog 입학자(시도 i, 유형 t, Y) = β(i,t) × Δlog 전국 입학자(Y)     (2006~{L}년, 원점 회귀, β는 0.2~3으로 제한)
입학자(i,t,Y) = 규모(i,t) × (수요/전국 규모)^β(i,t),  전국 합이 수요가 되도록 비례 조정</pre>
      <p>β가 작을수록 전국 입학자가 줄어도 버티는 칸입니다(서울 4년제 β = {sidos.find((s) => s.id === "11")?.betaU}). 전국 입학자가 줄었던 세 시기에 대해 같은 방법으로 검증한 결과를 위에 공개했습니다.</p>
      <h3>한계</h3>
      <ul>
        <li>대학의 정원 감축·통폐합, 외국인 유학생 정책, 수도권 정원 규제 변화는 반영하지 않습니다. "지금 규모가 그대로라면"의 계산입니다.</li>
        <li>시도는 대학 소재지 기준입니다. 같은 시도 안에서도 대학별 차이는 매우 큽니다.</li>
      </ul>
      <h3>데이터 출처</h3>
      <ul>{d.meta.sources.map((s: string) => <li>{s}</li>)}</ul>
    </section>
  </div>
</Base>
