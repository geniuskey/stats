---
import Base from "../layouts/Base.astro";
import { SERVICES } from "../lib/nav";
import korea from "../data/korea.json";
import school from "../data/school.json";
import dongne from "../data/dongne.json";
import wage from "../data/wage.json";
import housing from "../data/housing.json";
import industry from "../data/industry.json";
import commerce from "../data/commerce.json";
import retire from "../data/retire.json";
import { compact, pct, won } from "../lib/format";
import { HEADLINES, shrinkCount } from "../lib/headlines";
import KoreaMap from "../components/KoreaMap.astro";
import Spark from "../components/Spark.astro";
import { dongneMetrics, dongneNames, dongneNotes, dongneLinks } from "../lib/dongneMap";

const base = import.meta.env.BASE_URL;
const k = (korea as any).headline;
const sNat = (school as any).regions.find((r: any) => r.key === "00").summary;
const dn = (dongne as any).regions;
const shrink = shrinkCount;
const w = (wage as any).headline;
const seoul = (housing as any).regions.find((r: any) => r.id === "11");
const ind = (industry as any).summary;
const cm = (commerce as any).meta.classCounts;
const rt = (retire as any).headline;

// 카드별 미니 추세 (실측 실선 + 추계 점선)
const E = (o: Record<string, any>, f?: (v: any) => number) => Object.entries(o).map(([y, v]) => [+y, f ? f(v) : (v as number)] as [number, number]).filter(([, v]) => v != null && isFinite(v));
const kn = (korea as any).national.mid;
const by = (korea as any).meta.baseYear;
const schoolNat = (school as any).regions.find((r: any) => r.key === "00");
const seoulHist = seoul.hist;
const cons = (commerce as any).summary["00"].consumers;
const life = (retire as any).lifeHistory["65"];
const lifeF = (retire as any).lifeFuture["65"];
const sparks: Record<string, { actual: [number, number][]; proj?: [number, number][]; color?: string; from: string; to: string }> = {
  korea: { actual: E(kn, (v) => v.total).filter(([y]) => y <= by), proj: E(kn, (v) => v.total).filter(([y]) => y > by), from: "2015", to: "2050 총인구" },
  dongne: { actual: E(kn, (v) => v.oldShare).filter(([y]) => y <= by), proj: E(kn, (v) => v.oldShare).filter(([y]) => y > by), color: "var(--series-2)", from: "2015", to: "2050 고령 비중" },
  school: { actual: E(schoolNat.actual), proj: E(schoolNat.proj.mid), from: Object.keys(schoolNat.actual)[0], to: "2045 초등학생" },
  wage: { actual: (wage as any).national.map((r: any) => [r.year, r.netReal]), color: "var(--series-3)", from: String((wage as any).national[0].year), to: "세후 실질 월급" },
  housing: { actual: E(seoulHist, (v) => v.burden), color: "var(--series-2)", from: Object.keys(seoulHist)[0], to: "서울 부담률" },
  industry: { actual: E((industry as any).national.employment), proj: E((industry as any).national.supply.base), from: Object.keys((industry as any).national.employment)[0], to: "2045 노동공급" },
  commerce: { actual: E(cons.actual), proj: E(cons.mid), color: "var(--series-7)", from: Object.keys(cons.actual)[0], to: "2045 소비인구" },
  retire: { actual: E(life.male).filter(([y]) => y >= 1990), proj: E(lifeF.male).filter(([y]) => y <= 2050), color: "var(--series-3)", from: "1990", to: "2050 65세 기대여명" },
};
const cards = HEADLINES;
---
<Base title="홈" description="통계청 KOSIS 공공 통계를 결합해 시군구 인구 추계, 학령인구와 학교 전망, 실질임금, 주택구입 부담, 상권 활력, 은퇴 자금까지 기존에 없던 지표와 2050년 미래를 계산합니다.">
  <div class="wrap">
    <section class="hero hero-split home-hero">
      <div>
        <div class="eyebrow">공공 통계 × 결합 × 예측</div>
        <h1>통계를 보여주지 않습니다.<br />통계를 엮어 미래를 계산합니다.</h1>
        <p class="lede">
          출생아 수만으로는 학교의 미래를 알 수 없고, 집값만으로는 내 집 마련의 어려움을 알 수 없습니다. 이 사이트는 통계청 KOSIS의 공공 통계 여러 개를 결합해{" "}
          <strong>기존에 없던 지표</strong>와 <strong>시나리오 기반 미래 추계</strong>를 만듭니다.
        </p>
        <p class="lede" style="font-size:16px">오른쪽 지도는 전국 229개 시군구의 인구가 {by}년부터 2045년까지 어떻게 바뀌는지 재생합니다. <strong data-count>{shrink}곳</strong>이 줄어듭니다.</p>
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:18px">
          <a class="btn btn-primary" href={`${base}dongne/`}>우리 동네 찾기</a>
          <a class="btn" href={`${base}me/`}>나는 어디쯤?</a>
          <a class="btn" href={`${base}korea/#sim`}>출산율 시뮬레이터</a>
        </div>
      </div>
      <div class="home-map">
        <KoreaMap metrics={dongneMetrics({ keys: ["ch", "old"] }).map((m) => (m.frames ? { ...m, desc: undefined, frames: { ...m.frames, start: 0 } } : m))} names={dongneNames()} notes={dongneNotes()} links={dongneLinks(base)} rank={false} zoom={false} autoplay speed={520} compact title="시군구 인구, 2025 → 2045" sub="인구 변화율 · 65세 이상 비중 (중위 추계)" />
      </div>
    </section>

    <h2 class="sr-only">서비스</h2>
    <section class="grid grid-2" style="margin-top:8px">
      {SERVICES.map((s) => {
        const sp = sparks[s.slug];
        return (
          <a class={`card svc reveal${s.slug === "me" ? " svc-wide" : ""}`} href={`${base}${s.slug}/`}>
            <div class="combo">{s.combo.map((c) => <span class="badge">{c}</span>)}</div>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
            <div class="svc-num" data-count>{cards[s.slug].num}</div>
            <div class="svc-num-label">{cards[s.slug].label}</div>
            {sp && <Spark actual={sp.actual} proj={sp.proj} color={sp.color} />}
            {sp && <div class="svc-foot"><span>{sp.from}</span><span>{sp.to}{sp.proj ? " (점선 추계)" : ""}</span></div>}
          </a>
        );
      })}
    </section>

    <h2 class="sr-only">이렇게 만듭니다</h2>
    <section class="section grid grid-3 how">
      <div class="card reveal">
        <h3 class="card-title">결합</h3>
        <p class="small" style="margin:0">서로 다른 기관이 만든 통계를 같은 지역·같은 시점 기준으로 맞춰 묶습니다. 예: 주민등록 인구 × 학교 통계 × 출산율 시나리오.</p>
      </div>
      <div class="card reveal">
        <h3 class="card-title">추계</h3>
        <p class="small" style="margin:0">하나의 숫자 대신 저위·중위·고위 같은 시나리오 범위로 보여주고, 과거 데이터로 예측 정확도를 검증합니다.</p>
      </div>
      <div class="card reveal">
        <h3 class="card-title">공개</h3>
        <p class="small" style="margin:0">모든 데이터는 KOSIS OpenAPI에서 자동으로 수집하고, 계산 코드는 <a href="https://github.com/geniuskey/stats">GitHub</a>에 공개합니다.</p>
      </div>
    </section>
  </div>
</Base>
