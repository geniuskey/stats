---
import track from "../../data/track.json";
import Base from "../../layouts/Base.astro";
import Chart from "../../components/Chart.astro";
import Stat from "../../components/Stat.astro";
import BarList from "../../components/BarList.astro";
import ChartSwitch from "../../components/ChartSwitch.astro";
import KoreaMap from "../../components/KoreaMap.astro";
import PageMeta from "../../components/PageMeta.astro";
import { dongneMetrics, dongneNames, dongneNotes, dongneLinks } from "../../lib/dongneMap";
import data from "../../data/dongne.json";
import school from "../../data/school.json";
import { pts } from "../../lib/series";
import { int, compact, pct } from "../../lib/format";

export function getStaticPaths() {
  return (data as any).regions.map((r: any) => ({ params: { id: r.id }, props: { r } }));
}
const { r } = Astro.props as any;
const d = data as any;
const base = import.meta.env.BASE_URL;
const by = d.meta.baseYear, end = d.meta.end;
const m = r.m;
// 그림 출처 (작성기관 · 통계명 · KOSIS 표 ID)
const SRC = {
  reg: "행정안전부 주민등록인구 1세별(KOSIS DT_1B04006)",
  fert: "통계청 장래인구추계 출산율 시나리오(KOSIS DT_1BPA001·004·402·403)",
  official: "통계청 장래인구추계 시군구 2022년 기준(KOSIS DT_1BPB002E)",
  mig: "통계청 국내인구이동통계 연령별 순이동(KOSIS DT_1B26002)",
  emp: "고용노동부 사업체노동실태현황 사업체·종사자(KOSIS DT_118N_SAUP*)",
};
const projNote = `${by}년까지 주민등록 실측, ${by + 1}년부터 자체 추계(코호트 변화율법). 예측이 아닌 출산율 시나리오별 전망.`;
const S = r.series;
const f = (s: string, k: string, from = 2015, to = 2100) => Object.entries(S[s]).filter(([y]) => +y >= from && +y <= to).map(([y, v]: any) => [+y, v[k]] as [number, number]);
// 예측 구간: 같은 엔진을 과거(PB.base년)에서 돌려 본 시군구 오차(예측 ÷ 실제 − 1)의 10~90% 분위수.
// 실제 = 예측 ÷ (1 + 오차)이므로 80% 범위는 [예측 ÷ (1 + q90), 예측 ÷ (1 + q10)]. 검증한 h년(1~5년)까지만 그린다.
const PB = (track as any).popBacktest;
const errQ = PB.groups.total as Record<string, { q10: number; q90: number }>;
const piH = Math.max(...Object.keys(errQ).map(Number));
const piYears = [by, ...Object.keys(errQ).map((h) => by + +h)];
const midAt = (y: number) => S.mid[y]?.total as number | undefined;
const piBand = {
  name: `과거 검증 80% 범위 (${piH}년까지)`, color: "var(--series-4)",
  lower: piYears.filter((y) => midAt(y) != null).map((y) => [y, y === by ? midAt(y)! : midAt(y)! / (1 + errQ[y - by].q90)] as [number, number]),
  upper: piYears.filter((y) => midAt(y) != null).map((y) => [y, y === by ? midAt(y)! : midAt(y)! / (1 + errQ[y - by].q10)] as [number, number]),
};
const popSpec = {
  type: "line" as const, yFormat: "man" as const, projStart: by, height: 300, zeroBased: false,
  series: [
    { name: "주민등록 인구", color: "var(--series-1)", data: f("mid", "total", 2015, by) },
    { name: "자체 추계 (중위)", color: "var(--series-1)", data: f("mid", "total", by), dash: true, label: true },
    ...(Object.keys(r.official).length ? [{ name: "통계청 공식 추계 (2022년 기준)", color: "var(--neutral-series)", data: pts(r.official), dash: true, label: true }] : []),
  ],
  bands: [{ name: "출산율 저위~고위", color: "var(--series-1)", lower: f("low", "total", by), upper: f("high", "total", by) }, piBand],
};
const popTable = { headers: ["연도", "저위", "중위", "고위", "공식"], rows: [2015, 2020, 2025, 2030, 2035, 2040, 2045].map((y) => [y, int(S.low[y]?.total), int(S.mid[y]?.total), int(S.high[y]?.total), int(r.official[y])]) };
const ageSpec = {
  type: "line" as const, yFormat: "pct" as const, projStart: by, height: 260,
  series: [
    { name: "65세 이상", color: "var(--series-2)", data: f("mid", "oldShare"), label: true },
    { name: "0~14세", color: "var(--series-3)", data: f("mid", "kidShare"), label: true },
  ],
  hLines: [{ y: 0.5, label: "절반" }],
};
const g = (arr: number[]) => { const out: number[] = []; for (let a = 0; a < 100; a += 5) out.push(arr.slice(a, a + 5).reduce((x, y) => x + y, 0)); out.push(arr[100]); return out; };
const labels = [...Array(20).keys()].map((i) => `${i * 5}~${i * 5 + 4}세`).concat(["100세 이상"]);
const g25 = g(r.ages2025), g45 = g(r.ages2045);
const ageCol = { type: "line" as const, yFormat: "int" as const, height: 260, zeroBased: true, legend: true, xUnit: "~4세",
  series: [
    { name: `${by}년`, color: "var(--series-1)", data: g25.map((v, i) => [i * 5, v] as [number, number]) },
    { name: `${end}년 (추계)`, color: "var(--series-2)", data: g45.map((v, i) => [i * 5, v] as [number, number]), dash: true },
  ] };
const ageTable = { headers: ["연령", `${by}년`, `${end}년`], rows: labels.map((l, i) => [l, int(g25[i]), int(g45[i])]) };
const c = r.commerce;
const empSpec = c.employees ? { type: "line" as const, yFormat: "man" as const, height: 220, zeroBased: false,
  series: [{ name: "사업체 종사자", color: "var(--series-1)", data: pts(c.employees), label: true }] } : null;
const migSpec = c.netMigrationYoung ? { type: "column" as const, categories: Object.keys(c.netMigrationYoung), values: Object.values(c.netMigrationYoung) as number[],
  colors: (Object.values(c.netMigrationYoung) as number[]).map((v) => (v < 0 ? "var(--div-neg)" : "var(--div-pos)")), yFormat: "int" as const, height: 220 } : null;
const compNames: Record<string, string> = { ch2035: "인구 변화 (~2035)", youngMig: "청년 순이동", ext2025: "소멸위험지수", empGrowth: "일자리 증감", vacancy: "빈집률 (낮을수록 +)" };
const compItems = Object.entries(m.components).map(([k, v]) => ({ name: compNames[k], value: v as number }));
const sch = (school as any).regions.find((x: any) => x.key === r.key);
const sidoPeers = d.regions.filter((x: any) => x.sidoCode === r.sidoCode);
const rankInSido = sidoPeers.findIndex((x: any) => x.key === r.key) + 1;
const verdict = m.ch2045 >= 0.05 ? "성장" : m.ch2045 >= -0.05 ? "유지" : m.ch2045 >= -0.2 ? "축소" : "급감";
const peers = d.regions.filter((x: any) => x.sidoCode === r.sidoCode);
const peerMetrics = dongneMetrics({ regions: peers, keys: ["ch", "old", "idx"] });
const pyrSpec = { type: "pyramid" as const, groups: labels, left: [], right: [], leftName: "남자", rightName: "여자", height: 400, frames: r.pyramid, refYear: by, start: end, speed: 300, me: true };
// 내 출생연도 상자: 1세별 인구(시작·끝 연도)와 해마다 65세 이상 비중
const meJson = JSON.stringify({ id: r.id, by, end, name: `${r.sido} ${r.name}`, a0: r.ages2025, a1: r.ages2045, old: Object.fromEntries(Object.entries(S.mid).map(([y, v]: any) => [y, v.oldShare])) });
const pyrTable = { headers: ["연령", `남 ${by}`, `여 ${by}`, `남 ${end}`, `여 ${end}`], rows: labels.map((l, i) => { const a = r.pyramid.years.indexOf(by), b = r.pyramid.years.indexOf(end); return [l, int(r.pyramid.m[a][i]), int(r.pyramid.f[a][i]), int(r.pyramid.m[b][i]), int(r.pyramid.f[b][i])]; }) };
const yrs = Object.keys(S.mid).map(Number);
const ageArea = { type: "area" as const, percent: true, projStart: by, height: 260,
  series: [
    { name: "0~14세", color: "var(--series-3)", data: yrs.map((y) => [y, S.mid[y].kids] as [number, number]) },
    { name: "15~64세", color: "var(--series-1)", data: yrs.map((y) => [y, S.mid[y].work] as [number, number]) },
    { name: "65세 이상", color: "var(--series-2)", data: yrs.map((y) => [y, S.mid[y].old] as [number, number]) },
  ] };
const lastVac = c.vacancyRate ? Object.entries(c.vacancyRate).at(-1) : null;
---
<Base title={`${r.sido} ${r.name} 인구 추계`} active="dongne" description={`${r.sido} ${r.name} 인구 ${int(m.pop2025)}명 → ${end}년 ${int(m.pop2045)}명 (${pct(m.ch2045, 0, true)}). 지속가능성 지수 ${m.index}.`}>
  <div class="wrap">
    <section class="hero hero-split">
      <div>
        <div class="breadcrumb"><a href={`${base}dongne/`}>우리 동네의 미래</a> › {r.sido}</div>
        <h1>{r.sido} {r.name}: {end}년 인구 {pct(m.ch2045, 0, true)}</h1>
        <p class="lede">
          {int(m.pop2025)}명({by}년)에서 {end}년 {int(m.pop2045)}명으로 '{verdict}' 전망입니다(중위, 범위 {pct(m.ch2045low, 0, true)} ~ {pct(m.ch2045high, 0, true)}).
          지속가능성 지수는 <strong>{m.index}</strong>로 전국 {d.regions.length}곳 중 {m.rank}위, {r.sido} {sidoPeers.length}곳 중 {rankInSido}위입니다.
        </p>
        <PageMeta basis={`${by}년 말 주민등록 실측 · ${by + 1}~${end}년 자체 추계(저위·중위·고위)`} orgs={["행정안전부", "통계청", "고용노동부"]} method={`${base}dongne/#method`} />
      </div>
      <KoreaMap level="sgg" only={r.sidoCode} highlight={r.id} metrics={peerMetrics} names={dongneNames(peers)} notes={dongneNotes(peers)} links={dongneLinks(base, peers)} rank={false} compact h={2} title={`${r.sido} 안에서 ${r.name}`} sub="굵은 선이 이 지역 · 다른 시군구를 누르면 이동" note={projNote} source={[SRC.reg, SRC.fert, SRC.mig, SRC.emp]} />
    </section>
    <div class="grid grid-4">
      <Stat label="지속가능성 지수" value={String(m.index)} note={`전국 ${m.rank}위 · 50 = 평균`} />
      <Stat label={`65세 이상 비중 ${by} → ${end}`} value={`${pct(m.oldShare2025)} → ${pct(m.oldShare2045)}`} note={m.oldHalfYear ? `주민 절반이 65세+: ${m.oldHalfYear}년` : "절반 도달 없음"} />
      <Stat label="소멸위험지수" value={m.ext2025?.toFixed(2) ?? "–"} note={`${m.risk} · 2035년 ${m.ext2035?.toFixed(2)}`} tone={m.ext2025 < 0.5 ? "down" : undefined} />
      <Stat label={`20~39세 ${by} → ${end}`} value={`${compact(m.young2025)} → ${compact(m.young2045)}`} note={m.youngMig != null ? `청년 순이동 ${m.youngMig > 0 ? "+" : ""}${m.youngMig.toFixed(1)}명/1천명·년` : ""} />
    </div>
    <div class="me-box" id="me-box" hidden></div>
    <script type="application/json" id="me-data" set:html={meJson} />

    <section class="section">
      <Chart spec={popSpec} table={popTable} title="총인구" sub={`2015~${end}년 · 파란 음영 출산율 저위~고위 · 노란 음영 과거 검증 80% 범위`} note={`${projNote} 노란 음영은 같은 엔진을 ${PB.base}년 인구에서 돌려 ${PB.base + 1}~${PB.end}년 실제와 비교한 229개 시군구 오차의 10~90% 분위수로, 실제 인구가 들어올 범위를 ${piH}년 앞까지만 표시(검증 기간에 코로나19·신도시 입주가 겹침). 공식 추계는 2022년 기준 통계청 시군구 추계를 그대로 표시.`} source={[SRC.reg, SRC.fert, SRC.official]} />
    </section>
    <section class="section grid grid-2">
      <Chart spec={pyrSpec} table={pyrTable} title={`인구 피라미드 2015 → ${end}`} sub={`▶ 재생 · 검은 선은 ${by}년. ${by + 1}년부터 추계`} note={projNote} source={[SRC.reg, SRC.fert]} />
      <ChartSwitch views={[{ label: "비중 선", spec: ageSpec }, { label: "누적 영역", spec: ageArea }, { label: "나이별 비교", spec: ageCol, note: "가로축: 나이(5세 단위 시작 연령)" }]} table={ageTable} title="연령 구조 변화" sub="전체 인구 대비 비중 · 형태를 바꿔 보세요" note={projNote} source={[SRC.reg, SRC.fert]} />
    </section>
    <section class="section grid grid-2">
      <div class="card">
        <h3 class="card-title">지수 구성 요소</h3>
        <p class="card-sub">전국 시군구 대비 표준점수 (0 = 평균)</p>
        <BarList items={compItems} format="dec1" diverging />
        {lastVac && <p class="small muted" style="margin-top:12px">빈집률 {lastVac[0]}년 {(lastVac[1] as number).toFixed(1)}% · 사업체 종사자 연 {m.empGrowth?.toFixed(1)}% 증감</p>}
      </div>
      {migSpec && <Chart spec={migSpec} title="20~39세 순이동 (명)" sub="전입 − 전출, 음수는 순유출" note="20~39세 연령별 순이동을 합산." source={SRC.mig} />}
    </section>
    {empSpec && <section class="section"><Chart spec={empSpec} title="사업체 종사자 수" sub="전 산업" source={SRC.emp} derived={false} /></section>}

    <section class="section grid grid-2">
      {sch && <a class="card svc" href={`${base}school/${sch.id}/`}><h3>학교는 얼마나 남을까?</h3><p>초등학생 {int(sch.summary.current)}명 → 2035년 {int(sch.summary.y2035)}명 ({pct(sch.summary.change2035, 0, true)})</p></a>}
      <a class="card svc" href={`${base}commerce/${r.id}/`}><h3>이 동네 상권은?</h3><p>{c.index != null ? `상권 활력 지수 ${c.index}` : "상권 활력 지수 보기"}</p></a>
    </section>
    <p class="small muted section">방법은 <a href={`${base}dongne/#method`}>우리 동네의 미래 방법론</a>을 참고하세요. 추계는 최근 추세가 이어진다는 가정의 시나리오이며, 개발 계획·정책 변화는 반영하지 않습니다.</p>
  </div>
</Base>

<script>
  import { meBox, pageJson, type Profile, type MeContent } from "../../lib/profile";
  import { olderShare } from "../../lib/me";
  import { fmt } from "../../lib/format";
  // 내 출생연도: 이 동네의 내 동갑(5세 또래), 나보다 나이 많은 주민 비율, 내가 65세 되는 해의 고령자 비중
  const D = pageJson("me-data");
  const peer = (arr: number[], a: number) => arr.slice(Math.max(0, a - 2), Math.min(100, a + 3)).reduce((x, y) => x + y, 0);
  // 자녀 또래(앞뒤 2살): 지금 → 끝 연도
  const kidTiles = (P: Profile) =>
    (P.kids ?? []).map((k) => {
      const a0 = D.by - k,
        a1 = D.end - k;
      const p0 = a0 >= 0 ? peer(D.a0, a0) : NaN,
        p1 = a1 >= 0 && a1 <= 99 ? peer(D.a1, a1) : NaN;
      return {
        k: `${k}년생 아이 또래`,
        v: isFinite(p0) ? `${fmt(p0, "int")}명` : `${D.end}년 ${fmt(p1, "int")}명`,
        n: isFinite(p0) && isFinite(p1) ? `${D.end}년 ${a1}세 ${fmt(p1, "int")}명 (${fmt(p1 / p0 - 1, "pctS")})` : `${D.end}년 ${a1}세`,
      };
    });
  meBox(document.getElementById("me-box"), (b, P) => {
    const kt = kidTiles(P);
    const r = core(b, P);
    if (!r) return kt.length ? { tiles: kt, foot: "피라미드에서 초록색 막대가 아이 나이대입니다." } : null;
    if (!kt.length) return r;
    const k0 = P.kids![0];
    const q0 = D.by - k0 >= 0 ? peer(D.a0, D.by - k0) : NaN,
      q1 = D.end - k0 <= 99 ? peer(D.a1, D.end - k0) : NaN;
    const kidLead = isFinite(q0) && isFinite(q1) ? ` ${k0}년생 아이 또래는 ${fmt(q0, "int")}명에서 ${D.end}년 ${fmt(q1, "int")}명으로 ${q1 < q0 ? `${fmt(1 - q1 / q0, "pct")} 줄어듭니다` : `${fmt(q1 / q0 - 1, "pct")} 늘어납니다`}.` : "";
    return { ...r, lead: (r.lead ?? "") + kidLead, tiles: [...(r.tiles ?? []), ...kt], foot: (r.foot ?? "") + " 초록색은 아이 나이대입니다." };
  }, { need: ["born", "region", "kids"], uses: ["born"] });
  function core(b: number | null, P: Profile): MeContent | null {
    const mine = P.region?.id === D.id;
    const other = P.region && !mine ? `<a href="${import.meta.env.BASE_URL}dongne/${P.region.id}/">내 동네(${P.region.name}) 보기 →</a> ` : "";
    if (b == null) return mine ? { lead: "<strong>내 동네입니다.</strong> 출생연도를 넣으면 이 동네의 내 또래 인구와 고령화를 내 나이 기준으로 보여 드립니다." } : P.region ? { lead: "출생연도를 넣으면 이 동네의 내 또래 인구를 보여 드립니다.", foot: other } : null;
    const a0 = D.by - b,
      a1 = D.end - b;
    if (a0 < 0 || a0 > 99) return null;
    const p0 = peer(D.a0, a0),
      p1 = a1 <= 99 ? peer(D.a1, a1) : NaN;
    const o0 = olderShare(D.a0, 1, a0),
      o1 = a1 <= 100 ? olderShare(D.a1, 1, a1) : NaN;
    const y65 = b + 65;
    const tiles = [
      { k: `내 또래 (${a0 - 2}~${a0 + 2}세)`, v: `${fmt(p0, "int")}명`, n: isFinite(p1) ? `${D.end}년 ${fmt(p1, "int")}명 (${fmt(p1 / p0 - 1, "pctS")})` : `${D.by}년 말` },
      { k: "나보다 나이 많은 주민", v: fmt(o0, "pct"), n: isFinite(o1) ? `${D.end}년 ${fmt(o1, "pct")}` : "" },
    ];
    if (D.old[y65] != null) tiles.push({ k: `내가 65세 되는 ${y65}년`, v: `고령자 ${fmt(D.old[y65], "pct")}`, n: "이 동네 65세 이상 비중 (중위)" });
    const lead = isFinite(p1)
      ? `${D.name}에 사는 ${b}년생 또래(앞뒤 2살)는 ${D.by}년 말 <strong>${fmt(p0, "int")}명</strong>, ${D.end}년에는 ${fmt(p1, "int")}명으로 ${p1 < p0 ? `${fmt(1 - p1 / p0, "pct")} 줄어듭니다` : `${fmt(p1 / p0 - 1, "pct")} 늘어납니다`}. 사망과 이사(전입·전출)를 합한 결과입니다.`
      : `${D.name}에 사는 ${b}년생 또래(앞뒤 2살)는 ${D.by}년 말 ${fmt(p0, "int")}명입니다.`;
    return { lead: (mine ? "<strong>내 동네입니다.</strong> " : "") + lead, tiles, foot: other + "피라미드에서 보라색 막대가 연도별 내 나이대입니다." };
  }
</script>
