---
import Formula from "../../components/Formula.astro";
import { pageTitle, svcName } from "../../lib/nav";
import Base from "../../layouts/Base.astro";
import Chart from "../../components/Chart.astro";
import Stat from "../../components/Stat.astro";
import ChartSwitch from "../../components/ChartSwitch.astro";
import KoreaMap from "../../components/KoreaMap.astro";
import PageMeta from "../../components/PageMeta.astro";
import data from "../../data/korea.json";
import { pts } from "../../lib/series";
import { int, compact, pct } from "../../lib/format";

const d = data as any;
const h = d.headline;
const ms = d.milestones;
const by = d.meta.baseYear;
const nat = d.national;
const end = d.meta.endYear;
// 그림 출처 (작성기관 · 통계명 · KOSIS 표 ID)
const SRC = {
  reg: "행정안전부 주민등록인구 1세별(KOSIS DT_1B04006)",
  vital: "통계청 인구동향조사 출생아 수·합계출산율(KOSIS DT_1B81A23)",
  official: "통계청 장래인구추계 2022년 기준(KOSIS DT_1BPA001·DT_1BPA002·DT_1BPA004·DT_1BPA402·DT_1BPA403)",
};
const projNote = `${by}년까지 주민등록 내국인 실측, ${by + 1}년부터 자체 추계(코호트 변화율법). 예측이 아닌 출산율 시나리오별 전망.`;
const field = (s: string, f: string, from = 2015) => Object.entries(nat[s]).filter(([y]) => +y >= from).map(([y, v]: any) => [+y, v[f]] as [number, number]);
const projOnly = (s: string, f: string) => field(s, f, by);
const histOnly = (f: string) => field("mid", f).filter(([y]) => y <= by);
const offField = (s: string, f: string) => Object.entries(d.official[s]).filter(([y]) => +y <= 2050).map(([y, v]: any) => [+y, v[f] ?? null] as [number, number | null]);

const popSpec = {
  type: "line" as const, yFormat: "man" as const, projStart: by, height: 320, zeroBased: false,
  series: [
    { name: "주민등록 인구 (실측)", color: "var(--series-1)", data: histOnly("total") },
    { name: "자체 추계 (중위)", color: "var(--series-1)", data: projOnly("mid", "total"), dash: true, label: true },
    { name: "통계청 공식 추계 (중위·외국인 포함)", color: "var(--neutral-series)", data: offField("mid", "total"), dash: true, label: true },
  ],
  bands: [{ name: "자체 추계 저위~고위", color: "var(--series-1)", lower: projOnly("low", "total"), upper: projOnly("high", "total") }],
};
const popTable = {
  headers: ["연도", "자체 저위", "자체 중위", "자체 고위", "공식 중위"],
  rows: [2025, 2030, 2035, 2040, 2045, 2050].map((y) => [y, int(nat.low[y].total), int(nat.mid[y].total), int(nat.high[y].total), int(d.official.mid[y]?.total)]),
};

const ageSpec = {
  type: "line" as const, yFormat: "pct" as const, projStart: by, height: 300, me: { add: 65, label: "{who} 65세" },
  series: [
    { name: "65세 이상", color: "var(--series-2)", data: field("mid", "oldShare"), label: true },
    { name: "15~64세", color: "var(--series-1)", data: field("mid", "workShare"), label: true },
    { name: "0~14세", color: "var(--series-3)", data: field("mid", "kidShare"), label: true },
  ],
};
const ageTable = {
  headers: ["연도", "0~14세", "15~64세", "65세 이상", "85세 이상(명)", "중위연령"],
  rows: [2015, 2025, 2030, 2035, 2040, 2045, 2050].map((y) => [y, pct(nat.mid[y].kidShare, 1), pct(nat.mid[y].workShare, 1), pct(nat.mid[y].oldShare, 1), int(nat.mid[y].old85), nat.mid[y].medianAge]),
};

const supportSpec = {
  type: "line" as const, yFormat: "dec1" as const, projStart: by, height: 260,
  series: [{ name: "고령자 1명당 20~64세 인구", color: "var(--series-1)", data: field("mid", "workPerOld"), label: true }],
  bands: [{ name: "저위~고위", color: "var(--series-1)", lower: projOnly("low", "workPerOld"), upper: projOnly("high", "workPerOld") }],
  hLines: [{ y: 2, label: "2명" }, { y: 1, label: "1명" }],
  zeroBased: true,
  me: { add: 65, label: "{who} 65세" },
};

const B = d.births;
const birthSpec = {
  type: "line" as const, yFormat: "man" as const, height: 300, zeroBased: true,
  series: [
    { name: "실제 출생아", color: "var(--text-primary)", data: pts(B.actual, 2010), label: true, width: 2.5 },
    { name: "공식 고위", color: "var(--series-3)", data: pts(B.official.high, 2022, 2035), dash: true },
    { name: "공식 중위", color: "var(--series-1)", data: pts(B.official.mid, 2022, 2035), dash: true },
    { name: "공식 저위", color: "var(--series-2)", data: pts(B.official.low, 2022, 2035), dash: true },
  ],
};
const birthTable = {
  headers: ["연도", "실제", "공식 저위", "공식 중위", "공식 고위", "합계출산율"],
  rows: [2020, 2021, 2022, 2023, 2024, 2025, 2026, 2030].map((y) => [y, int(B.actual[y]), int(B.official.low[y]), int(B.official.mid[y]), int(B.official.high[y]), B.tfr[y] ?? "–"]),
};
const vs = h.birthsVsScenario;
const closest = Object.entries(vs).sort((a: any, b: any) => Math.abs(a[1]) - Math.abs(b[1]))[0][0];
const scenName: Record<string, string> = { low: "저위", mid: "중위", high: "고위" };

const P = d.pyramid;
const pyrTable = { headers: ["연령", `남 ${by}`, `여 ${by}`, "남 2050", "여 2050"], rows: P.labels.map((l: string, i: number) => [l, int(P.male2025[i]), int(P.female2025[i]), int(P.male2050[i]), int(P.female2050[i])]) };

const v = d.village;
// ---- 시각화 확장
const yrs = Object.keys(nat.mid).map(Number).filter((y) => y >= 2015 && y <= 2050);
const ageArea = {
  type: "area" as const, percent: true, projStart: by, height: 300,
  series: [
    { name: "0~14세", color: "var(--series-3)", data: yrs.map((y) => [y, nat.mid[y].kids] as [number, number]) },
    { name: "15~64세", color: "var(--series-1)", data: yrs.map((y) => [y, nat.mid[y].work] as [number, number]) },
    { name: "65~84세", color: "var(--series-4)", data: yrs.map((y) => [y, nat.mid[y].old - nat.mid[y].old85] as [number, number]) },
    { name: "85세 이상", color: "var(--series-2)", data: yrs.map((y) => [y, nat.mid[y].old85] as [number, number]) },
  ],
};
const ageStack = {
  type: "stack" as const, height: 300, yFormat: "man" as const,
  categories: yrs.filter((y) => y % 5 === 0).map(String),
  projFrom: yrs.filter((y) => y % 5 === 0).findIndex((y) => y > by),
  series: [
    { name: "0~14세", color: "var(--series-3)", values: yrs.filter((y) => y % 5 === 0).map((y) => nat.mid[y].kids) },
    { name: "15~64세", color: "var(--series-1)", values: yrs.filter((y) => y % 5 === 0).map((y) => nat.mid[y].work) },
    { name: "65세 이상", color: "var(--series-2)", values: yrs.filter((y) => y % 5 === 0).map((y) => nat.mid[y].old) },
  ],
};
// 세대 이동 피라미드 (1세 단위, 중위): 이름 붙은 세대가 해마다 한 줄씩 올라간다
const cohort = {
  type: "cohort" as const, ...d.cohortFrames, refYear: by, start: 2015, speed: 520, height: 420, me: true,
  generations: [
    { name: "1차 베이비붐", short: "1차 붐", from: 1955, to: 1963 },
    { name: "2차 베이비붐", short: "2차 붐", from: 1968, to: 1974 },
    { name: "에코붐", short: "에코붐", from: 1991, to: 1996 },
  ],
};
const waffleYears = yrs.filter((y) => y % 5 === 0);
const waffle = {
  type: "waffle" as const, caption: "명", start: waffleYears.indexOf(by), speed: 900,
  projFrom: waffleYears.findIndex((y) => y > by),
  groups: [
    { name: "어린이 0~14세", color: "var(--series-3)" },
    { name: "일하는 나이 15~64세", color: "var(--series-1)" },
    { name: "고령자 65~84세", color: "var(--series-4)" },
    { name: "85세 이상", color: "var(--series-2)" },
  ],
  frames: waffleYears.map((y) => {
    const r = nat.mid[y];
    return { label: y, values: [r.kids, r.work, r.old - r.old85, r.old85].map((v: number) => (v / r.total) * 100) };
  }),
};
// 시도 지도 (연도 재생)
const sidoNames = Object.fromEntries(d.sidos.map((s: any) => [s.id, s.full]));
const mapYears = Object.keys(d.sidos[0].series).map(Number).filter((y) => y >= 2015 && y <= 2050);
const sidoMetrics = [
  { key: "ch", label: `인구 변화 (${by}년 대비)`, format: "pctS" as const, kind: "div" as const, breaks: [-0.3, -0.2, -0.1, -0.05, 0, 0.05, 0.1], desc: `${by}년 인구 대비 변화율. ${mapYears[0]}~${by}년은 실측(그때 인구가 지금보다 많았으면 +), 이후는 중위 추계입니다. ▶ 를 누르면 ${mapYears[0]}→2050년 변화를 재생합니다.`,
    frames: { labels: mapYears, values: mapYears.map((y) => Object.fromEntries(d.sidos.map((s: any) => [s.id, s.series[y].total / s.series[by].total - 1]))), start: mapYears.length - 1, projFrom: mapYears.indexOf(by + 1) } },
  { key: "old", label: "65세 이상 비중", format: "pct" as const, kind: "seq" as const, breaks: [0.15, 0.2, 0.25, 0.3, 0.35, 0.4, 0.45], desc: "주민 중 65세 이상 비율. 2015년 실측부터 2050년 추계까지.",
    frames: { labels: mapYears, values: mapYears.map((y) => Object.fromEntries(d.sidos.map((s: any) => [s.id, s.series[y].oldShare]))), start: mapYears.indexOf(2050), projFrom: mapYears.indexOf(by + 1) } },
  { key: "age", label: "중위연령", format: "age" as const, kind: "seq-warm" as const, breaks: [42, 45, 48, 51, 54, 57, 60], desc: "주민을 나이순으로 세웠을 때 한가운데 사람의 나이.",
    frames: { labels: mapYears, values: mapYears.map((y) => Object.fromEntries(d.sidos.map((s: any) => [s.id, s.series[y].medianAge]))), start: mapYears.indexOf(2050), projFrom: mapYears.indexOf(by + 1) } },
];
// 내 출생연도 상자: 해마다 연령 구조 지표 (피라미드 1세 자료는 그림 spec에서 읽는다)
const meJson = JSON.stringify({ sido: Object.fromEntries(d.sidos.map((x: any) => [x.id, [x.full, x.series[end].total / x.series[by].total - 1, x.series[by].oldShare, x.series[end].oldShare]])), by, end, nat: Object.fromEntries(yrs.map((y) => [y, { oldShare: nat.mid[y].oldShare, workPerOld: nat.mid[y].workPerOld, medianAge: nat.mid[y].medianAge }])) });
const simJson = JSON.stringify({ p: d.sim, base: Object.fromEntries(yrs.filter((y) => y >= by).map((y) => [y, nat.mid[y].total])), groups: P.labels }).replace(/</g, "\\u003c");

---
<Base title={pageTitle("korea")} active="korea" description={`출생·사망·이동·연령별 인구를 결합한 2050년 대한민국 전망. 65세 이상 비중 ${pct(h.oldShare2025)} → ${pct(h.oldShare2050)}.`}>
  <div class="wrap">
    <section class="hero hero-split">
      <div>
        <div class="eyebrow">{svcName("korea")} · 출생 × 사망 × 이동 × 연령별 인구</div>
        <h1>2050년, 고령자 1명을 일하는 나이 {h.workPerOld2050}명이 받칩니다</h1>
        <p class="lede">지금은 {h.workPerOld2025}명입니다. 주민등록 인구 5,100만 명을 1세 단위로 한 해씩 나이 들게 하고, 지역별 이동과 출생을 더해 2050년까지 굴려 봤습니다. 공식 추계가 나온 뒤의 실제 출생 흐름까지 반영했습니다.</p>
        <p class="small muted">오른쪽 피라미드에서 ▶를 누르면 같은 해 태어난 사람들이 해마다 한 줄씩 올라갑니다. 베이비붐 세대가 위로 올라가는 동안 아래로는 적게 태어난 세대가 들어옵니다. 검은 선은 {by}년 모습입니다. <a href="#sim">출산율을 직접 바꿔 보기 →</a></p>
        <PageMeta basis={`${by}년 말 주민등록 실측 · ${by + 1}~${end}년 자체 추계(저위·중위·고위)`} orgs={["행정안전부", "통계청"]} />
      </div>
      <Chart spec={cohort} table={pyrTable} h={2} title="인구 피라미드 2015 → 2050" sub={`1세 단위, 남(왼쪽)·여(오른쪽). 진한 줄은 이름 붙은 세대. ${by + 1}년부터 자체 추계 중위`} note={projNote} source={[SRC.reg, SRC.vital, SRC.official]} />
    </section>
    <div class="grid grid-4">
      <Stat label={`인구 ${by} → 2050 (중위)`} value={`${compact(h.pop2025)} → ${compact(h.pop2050.mid)}`} note={`${pct(h.pop2050.mid / h.pop2025 - 1, 0, true)} · 내국인 주민등록 기준`} tone="down" />
      <Stat label="65세 이상 비중" value={`${pct(h.oldShare2025)} → ${pct(h.oldShare2050)}`} note={`30% 돌파: ${ms.old30}년`} />
      <Stat label="중위연령" value={`${h.medianAge2025} → ${h.medianAge2050}`} unit="세" note="국민을 나이순으로 세웠을 때 한가운데" />
      <Stat label="85세 이상" value={`${compact(h.old85_2025)} → ${compact(h.old85_2050)}`} unit="명" note={`${(h.old85_2050 / h.old85_2025).toFixed(1)}배`} />
    </div>
    <div class="me-box" id="me-box" hidden></div>
    <script type="application/json" id="me-data" set:html={meJson} />

    <section class="section">
      <h2>실제 출생은 공식 추계의 '{scenName[closest]}' 시나리오를 따라가는 중</h2>
      <p class="section-desc">통계청 장래인구추계(2022년 기준)는 출생아가 계속 줄어든다고 봤습니다(중위). 그러나 {h.birthsLatestYear}년 실제 출생아는 {int(h.birthsLatest)}명(합계출산율 {h.tfrLatest})으로 중위보다 {pct(vs.mid, 0, true)}, 고위 시나리오와는 {pct(vs.high, 1, true)} 차이입니다. 이 사이트의 추계는 이 실제 수준에서 출발합니다.</p>
      <Chart spec={birthSpec} table={birthTable} title="출생아 수: 실제 vs 공식 시나리오" sub="2010~2035년, 명" note="실제는 인구동향조사 확정치. 공식 시나리오는 2022년 기준 장래인구추계(저위·중위·고위)를 그대로 옮김." source={[SRC.vital, SRC.official]} derived={false} />
    </section>

    <section class="section">
      <h2>총인구: 자체 추계와 공식 추계</h2>
      <p class="section-desc">자체 추계는 주민등록 <strong>내국인</strong> 기준이라 외국인(약 270만 명)과 외국인 순유입이 포함된 공식 추계보다 낮습니다. 비교의 핵심은 수준보다 기울기입니다. 5천만 명 아래로 내려가는 해는 <strong>{ms.under50m}년</strong>(중위)입니다.</p>
      <Chart spec={popSpec} table={popTable} title="총인구 (명)" sub="2015~2050년" note={`자체 추계는 주민등록 내국인 기준이라 외국인이 포함된 공식 추계보다 낮음. 음영은 저위~고위. ${projNote}`} source={[SRC.reg, SRC.vital, SRC.official]} />
    </section>

    <section class="section grid grid-2">
      <ChartSwitch views={[{ label: "선", spec: ageSpec }, { label: "누적 영역", spec: ageArea }, { label: "인구 막대", spec: ageStack }]} table={ageTable} title="연령 구조" sub="같은 데이터를 비중 선 · 100% 누적 · 인원 막대로 바꿔 볼 수 있습니다 (중위)" note={projNote} source={[SRC.reg, SRC.vital, SRC.official]} />
      <Chart spec={supportSpec} title="고령자 1명을 받치는 20~64세 인구" sub={`2명 아래로: ${ms.workPerOld2}년`} note={`20~64세 인구 ÷ 65세 이상 인구. 음영은 저위~고위. ${projNote}`} source={[SRC.reg, SRC.vital, SRC.official]} />
    </section>

    <section class="section grid grid-2">
      <Chart spec={waffle} title="대한민국이 100명의 마을이라면" sub="5년 단위로 재생 · 한 칸 = 국민 1%" note={`반올림 합이 100이 되도록 보정. ${projNote}`} source={[SRC.reg, SRC.vital, SRC.official]} />
      <div class="card">
        <h3 class="card-title">100명의 마을, 숫자로</h3>
        <p class="card-sub">중위 추계</p>
        <div class="table-wrap">
          <table>
            <thead><tr><th>연도</th><th class="num">어린이(0~14)</th><th class="num">일하는 나이(15~64)</th><th class="num">고령자(65+)</th><th class="num">85세 이상</th></tr></thead>
            <tbody>{Object.entries(v).map(([y, r]: any) => <tr><td>{y}</td><td class="num">{r.kids}명</td><td class="num">{r.work}명</td><td class="num">{r.old}명</td><td class="num">{r.old85}명</td></tr>)}</tbody>
          </table>
        </div>
        <p class="insight" style="margin-top:16px">20~39세 청년은 {compact(h.young2025)}명에서 2050년 <strong>{compact(h.young2050)}명</strong>으로 {pct(h.young2050 / h.young2025 - 1, 0, true)} 줄어듭니다. 2050년의 20~39세는 대부분 이미 태어났기 때문에 출산율 시나리오로 거의 바뀌지 않는 숫자입니다.</p>
      </div>
    </section>

    <section class="section">
      <h2>지역마다 다른 속도</h2>
      <p class="section-desc">시군구 229곳을 각각 추계해 시도로 더했습니다. 지표를 바꾸고 ▶ 를 눌러 보세요. 지역을 누르면 그 안의 시군구를 볼 수 있는 <a href={`${import.meta.env.BASE_URL}dongne/`}>우리 동네의 미래</a>로 이어집니다.</p>
      <KoreaMap level="sido" metrics={sidoMetrics} names={sidoNames} links={Object.fromEntries(d.sidos.map((s: any) => [s.id, `${import.meta.env.BASE_URL}dongne/#map`]))} title="시도별 인구 지도" sub="중위 추계" note={`시군구 229곳을 각각 추계해 시도로 합산. ${projNote}`} source={[SRC.reg, SRC.vital, SRC.official]} />
    </section>

    <section class="section card" id="sim">
      <h2 style="margin-top:0">직접 바꿔 보는 2050년</h2>
      <p class="section-desc">출산율이 오르면, 이민을 받으면, 더 오래 살면 2050년은 어떻게 달라질까요? 이 페이지의 추계와 같은 코호트 모형을 브라우저에서 바로 돌립니다. 회색 점선은 이 사이트의 기본 추계(중위)로, 통계청 중위 가정처럼 출산율이 2050년 약 {(d.sim.tfrBase * d.sim.fertMid["2050"]).toFixed(2)}명까지 회복한다고 본 값입니다. 출산율이 지금 수준({d.sim.tfrBase})에 머물면 인구는 그보다 빨리 줄어듭니다.</p>
      <div class="sim">
        <div class="sim-controls">
          <div class="slider">
            <div class="slider-top"><label for="s-tfr">합계출산율 목표</label><output id="o-tfr"></output></div>
            <input type="range" id="s-tfr" min="0.5" max="2.1" step="0.05" value={d.sim.tfrBase} />
            <div class="slider-hint"><span>0.5</span><span>{by}년 실제 {d.sim.tfrBase}</span><span>2.1 (인구 유지)</span></div>
          </div>
          <div class="slider">
            <div class="slider-top"><label for="s-year">목표 도달 연도</label><output id="o-year"></output></div>
            <input type="range" id="s-year" min="2027" max="2045" step="1" value="2030" />
          </div>
          <div class="slider">
            <div class="slider-top"><label for="s-mig">이민 순유입 (매년 추가)</label><output id="o-mig"></output></div>
            <input type="range" id="s-mig" min="0" max="400000" step="10000" value="0" />
            <div class="slider-hint"><span>0</span><span>20만</span><span>40만 명</span></div>
          </div>
          <div class="slider">
            <div class="slider-top"><label for="s-mort">60세 이상 사망률 개선 (매년)</label><output id="o-mort"></output></div>
            <input type="range" id="s-mort" min="0" max="0.03" step="0.0025" value="0" />
            <div class="slider-hint"><span>최근 수준 유지</span><span>연 3%</span></div>
          </div>
          <div>
            <div class="small muted" style="margin-bottom:6px">빠른 시나리오</div>
            <div class="presets">
              <button type="button" data-p="0.65,2030,0,0">저출산 심화</button>
              <button type="button" data-p={`${d.sim.tfrBase},2030,0,0`}>현 수준 유지</button>
              <button type="button" data-p={`${(d.sim.tfrBase * d.sim.fertMid["2050"]).toFixed(2)},2045,0,0`}>기본 추계(중위)와 비슷하게</button>
              <button type="button" data-p="1.0,2035,0,0.01">완만한 회복</button>
              <button type="button" data-p="1.3,2035,100000,0.01">프랑스 절반 수준</button>
              <button type="button" data-p="1.0,2035,250000,0.01">이민 확대</button>
              <button type="button" data-p="2.1,2030,0,0.01">인구 대체 수준</button>
            </div>
          </div>
        </div>
        <div>
          <div class="sim-out" id="sim-out"></div>
          <div class="grid grid-2" style="margin-top:14px">
            <div><h3 class="card-title">총인구</h3><div class="chart" id="sim-pop"></div></div>
            <div><h3 class="card-title">2050년 인구 피라미드</h3><div class="chart" id="sim-pyr"></div></div>
          </div>
        </div>
      </div>
      <p class="small muted" style="margin-top:12px">모형: 성별 1세 코호트 변화율(최근 3년, 사망+이동 포함) × 출생(20~44세 여성 × 아동비 × 출산율 비율). 이민자는 20대 후반 중심 연령 분포로 남녀 반반 가정. 내국인 주민등록 기준이며 장기 이민의 귀화·출산 효과는 단순화했습니다.</p>
      <script type="application/json" id="sim-data" set:html={simJson} />
    </section>

    <section class="section card method" id="method">
      <h2>방법론</h2>
      <h3>무엇을 결합했나</h3>
      <p>행정안전부 주민등록인구(1세별, 시군구, 2015~2025년 말), 통계청 인구동향 출생아·합계출산율, 통계청 장래인구추계(2022년 기준)의 시나리오별 출생아·가임여성 인구를 결합했습니다. 공식 추계는 2022년 인구에서 출발하지만, 그 뒤 3년의 실제 출생과 이동이 반영된 2025년 주민등록 인구에서 다시 출발한 것이 차이입니다.</p>
      <h3>추계 방법</h3>
      <Formula tex={[String.raw`인구(a세,\ t+1) = 인구(a-1세,\ t) \times 코호트 변화율(a)`, String.raw`0세(t) = 20∼44세 여성(t) \times 아동비 \times 출산율 지수(시나리오,\ t)`]} where={[`코호트 변화율: 사망과 국내외 이동을 함께 담은 한 살 더 먹을 때의 인구 비율`]} />
      <p>코호트 변화율은 최근 3년 평균입니다. 시군구 229곳을 각각 추계한 뒤 더해 전국과 시도 값을 만들었습니다. 출산율 지수는 공식 추계 시나리오의 "가임여성 1명당 출생아" 변화율을 {by}년 = 1로 둔 것입니다. 2050년 피라미드의 남녀 구분은 같은 출생 코호트의 {by}년 성비를 적용했습니다.</p>
      <h3>한계</h3>
      <ul>
        <li>주민등록 기준이라 외국인 인구가 빠져 있습니다. 공식 추계와 수준이 다릅니다.</li>
        <li>사망률 개선(기대수명 증가)을 따로 모형화하지 않고 최근 3년의 생존 비율을 유지합니다. 고령 인구가 다소 과소추계될 수 있습니다.</li>
        <li>최근 3년의 이동 흐름이 점차 전국 평균으로 수렴한다고 가정합니다.</li>
      </ul>
      <h3>데이터 출처</h3>
      <ul>{d.meta.sources.map((s: string) => <li>{s}</li>)}</ul>
    </section>
  </div>
</Base>

<script>
  import { meBox, pageSpec, pageJson, ageAt, type Profile } from "../../lib/profile";
  import { olderShare } from "../../lib/me";
  import { fmt } from "../../lib/format";
  // 내 출생연도: 지금·2050년의 내 나이와 나보다 나이 많은 사람 비율, 동갑 인구, 내가 65세가 되는 해
  const MD = pageJson("me-data");
  const C = pageSpec("cohort");
  const sidoTile = (P: Profile) => {
    const r = P.region ? MD.sido[P.region.sidoCode] : null;
    return r ? [{ k: `${r[0]} 인구 ${MD.by}→${MD.end}`, v: fmt(r[1], "pctS"), n: `65세 이상 ${fmt(r[2], "pct")} → ${fmt(r[3], "pct")}` }] : [];
  };
  // 자녀: 지금·2050년 나이, 동갑 인구, 2050년에 나이순으로 어디쯤
  const kidTiles = (P: Profile) => {
    if (!C) return [];
    const tot = (y: number) => {
      const i = C.years.indexOf(y);
      return C.m[i].map((v: number, a: number) => v + C.f[i][a]);
    };
    return (P.kids ?? []).map((k) => {
      const a0 = MD.by - k,
        a1 = MD.end - k;
      const peers = a1 >= 0 && a1 <= 99 ? tot(MD.end)[a1] : NaN;
      const older = olderShare(tot(MD.end), 1, a1);
      return {
        k: `${k}년생 아이`,
        v: a0 >= 0 ? `${a0}세 → ${a1}세` : `${MD.end}년 ${a1}세`,
        n: `${MD.end}년 동갑 ${isFinite(peers) ? fmt(peers, "man") + "명" : "–"} · 아이보다 나이 많은 사람 ${fmt(older, "pct")}`,
      };
    });
  };
  meBox(document.getElementById("me-box"), (b, P) => {
    const kt = kidTiles(P);
    if (b == null) {
      const t = [...kt, ...sidoTile(P)];
      return t.length ? { lead: P.region ? `내 시도의 ${MD.end}년 전망입니다. 지도에서 점선 테두리가 내 시도입니다.` : "", tiles: t, foot: kt.length ? "피라미드에서 초록색 줄이 아이입니다." : "" } : null;
    }
    const r0 = mine(b);
    if (!r0) return null;
    const k0 = P.kids?.[0];
    const kidLead = k0 != null ? ` ${k0}년생 아이는 ${MD.end}년 ${MD.end - k0}세로, 그해 국민의 ${fmt(1 - olderShare(tot2(MD.end), 1, MD.end - k0), "pct")}만이 아이보다 어립니다.` : "";
    return { ...r0, lead: r0.lead + kidLead, tiles: [...r0.tiles, ...kt, ...sidoTile(P)], foot: r0.foot + (kt.length ? " 초록색 줄은 아이입니다." : "") };
  }, { need: ["born", "region", "kids"], uses: ["born", "region"] });
  function tot2(y: number) {
    const i = C.years.indexOf(y);
    return C.m[i].map((v: number, a: number) => v + C.f[i][a]);
  }
  function mine(b: number) {
    if (!C) return null;
    const yi = (y: number) => C.years.indexOf(y);
    const tot = (y: number) => C.m[yi(y)].map((v: number, a: number) => v + C.f[yi(y)][a]);
    const aNow = ageAt(b, MD.by),
      aEnd = ageAt(b, MD.end);
    if (aNow < 0) return null;
    const olderNow = olderShare(tot(MD.by), 1, aNow),
      olderEnd = olderShare(tot(MD.end), 1, aEnd);
    const peersNow = aNow <= 99 ? tot(MD.by)[aNow] : NaN;
    const peersEnd = aEnd <= 99 ? tot(MD.end)[aEnd] : NaN;
    const y65 = b + 65;
    const r65 = MD.nat[y65];
    const tiles = [
      { k: `${MD.by}년 말 나이`, v: `${aNow}세`, n: `나보다 나이 많은 사람 ${fmt(olderNow, "pct")}` },
      { k: `${MD.end}년 나이`, v: aEnd <= 100 ? `${aEnd}세` : "–", n: aEnd <= 100 ? `나보다 나이 많은 사람 ${fmt(olderEnd, "pct")}` : "" },
      { k: `동갑(${b}년생) 인구`, v: isFinite(peersNow) ? `${fmt(peersNow, "man")}명` : "–", n: isFinite(peersEnd) ? `${MD.end}년 ${fmt(peersEnd, "man")}명 (${fmt(peersEnd / peersNow - 1, "pctS")})` : "" },
      r65
        ? { k: `내가 65세 되는 ${y65}년`, v: `고령자 ${fmt(r65.oldShare, "pct")}`, n: `고령자 1명당 20~64세 ${fmt(r65.workPerOld, "dec1")}명` }
        : y65 < 2015
          ? { k: "65세", v: `${y65}년에 지남`, n: `지금 고령자 비중 ${fmt(MD.nat[MD.by].oldShare, "pct")}` }
          : { k: "65세 되는 해", v: `${y65}년`, n: `${MD.end}년 이후라 이 추계 밖입니다` },
    ];
    const mid = MD.nat[MD.end].medianAge;
    const lead =
      aEnd <= 100
        ? `${b}년생은 ${MD.by}년 말 <strong>${aNow}세</strong>, 국민을 나이순으로 세우면 ${olderNow > 0.5 ? "젊은 쪽 절반" : "나이 많은 쪽 절반"}에 있습니다. ${MD.end}년 ${aEnd}세가 되면 나보다 나이 많은 사람은 <strong>${fmt(olderEnd, "pct")}</strong>로 ${olderEnd > olderNow ? "오히려 늘어납니다. 내 아래로 들어오는 세대가 적기 때문입니다" : "줄어듭니다"}. 그해 중위연령은 ${mid}세입니다.`
        : `${b}년생은 ${MD.by}년 말 ${aNow}세입니다.`;
    return { lead, tiles, foot: `피라미드에서 보라색 줄이 ${b}년생입니다. ▶를 누르면 내 줄이 해마다 한 칸씩 올라갑니다. ${MD.by + 1}년부터 자체 추계 중위.` };
  }
</script>

<script>
  import { simulate } from "../../lib/popsim";
  import { mount } from "../../lib/charts";
  import { fmt } from "../../lib/format";
  const D = JSON.parse(document.getElementById("sim-data")!.textContent || "{}");
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const inputs = { tfr: $("s-tfr"), year: $("s-year"), mig: $("s-mig"), mort: $("s-mort") };
  const popEl = document.getElementById("sim-pop")!;
  const pyrEl = document.getElementById("sim-pyr")!;
  const out = document.getElementById("sim-out")!;
  const baseline = simulate(D.p, { tfr: D.p.tfrBase, tfrYear: 2030, mig: 0, mortImp: 0 });
  const b50 = baseline.years[baseline.years.length - 1];
  let raf = 0;
  const run = () => {
    const inp = { tfr: +inputs.tfr.value, tfrYear: +inputs.year.value, mig: +inputs.mig.value, mortImp: +inputs.mort.value };
    $("o-tfr").textContent = inp.tfr.toFixed(2) + "명";
    $("o-year").textContent = inp.tfrYear + "년";
    $("o-mig").textContent = inp.mig ? fmt(inp.mig, "man") + "명" : "없음";
    $("o-mort").textContent = inp.mortImp ? (inp.mortImp * 100).toFixed(2).replace(/0$/, "") + "%" : "없음";
    const r = simulate(D.p, inp);
    const y50 = r.years[r.years.length - 1];
    const tiles: [string, string, string][] = [
      ["2050년 총인구", fmt(y50.total, "man"), `현 수준 유지 대비 ${fmt(y50.total / b50.total - 1, "pct1S")}`],
      ["65세 이상 비중", fmt(y50.old / y50.total, "pct1"), `현 수준 유지 ${fmt(b50.old / b50.total, "pct1")}`],
      ["고령자 1명당 20~64세", y50.workPerOld.toFixed(2) + "명", `현 수준 유지 ${b50.workPerOld.toFixed(2)}명`],
      ["2050년 출생아", fmt(y50.births, "man") + "명", `${D.p.baseYear}년 ${fmt(r.years[0].births, "man")}명`],
    ];
    out.innerHTML = "";
    for (const [k, v, n] of tiles) {
      const d = document.createElement("div");
      d.className = "stat";
      d.innerHTML = `<div class="stat-label"></div><div class="stat-value"></div><div class="stat-note"></div>`;
      d.querySelector(".stat-label")!.textContent = k;
      d.querySelector(".stat-value")!.textContent = v;
      d.querySelector(".stat-note")!.textContent = n;
      out.appendChild(d);
    }
    mount(popEl, {
      type: "line", yFormat: "man", height: 240, zeroBased: false, animate: false,
      series: [
        { name: "기본 추계 (중위)", color: "var(--neutral-series)", dash: true, data: Object.entries(D.base).map(([y, v]) => [+y, v as number]) },
        { name: "현 수준 유지", color: "var(--series-2)", data: baseline.years.map((y) => [y.year, y.total]), width: 1.5, muted: true },
        { name: "내 시나리오", color: "var(--series-1)", data: r.years.map((y) => [y.year, y.total]), label: true, width: 2.5 },
      ],
    } as any);
    mount(pyrEl, {
      type: "pyramid", groups: D.groups, leftName: "남자", rightName: "여자", outlineName: "현 수준 유지", height: 300,
      left: r.frames.m[r.frames.m.length - 1], right: r.frames.f[r.frames.f.length - 1],
      leftOutline: baseline.frames.m[baseline.frames.m.length - 1], rightOutline: baseline.frames.f[baseline.frames.f.length - 1],
    } as any);
  };
  const schedule = () => {
    cancelAnimationFrame(raf);
    raf = requestAnimationFrame(run);
  };
  Object.values(inputs).forEach((i) => i.addEventListener("input", schedule));
  document.querySelectorAll<HTMLButtonElement>(".presets button").forEach((b) =>
    b.addEventListener("click", () => {
      const [t, y, m, mo] = b.dataset.p!.split(",");
      inputs.tfr.value = t;
      inputs.year.value = y;
      inputs.mig.value = m;
      inputs.mort.value = mo;
      run();
    }),
  );
  run();
</script>
