---
import Base from "../../layouts/Base.astro";
import PageMeta from "../../components/PageMeta.astro";
import { GLOSSARY } from "../../data/glossary";

const base = import.meta.env.BASE_URL;
const total = GLOSSARY.reduce((n, g) => n + g.terms.length, 0);
const href = (l: { slug: string; hash?: string }) => `${base}${l.slug}/${l.hash ? `#${l.hash}` : ""}`;
---
<Base title="용어 사전" active="glossary" description={`주택구입 부담률, PIR, 코호트 변화율법, 나우캐스트, 상권 활력 지수 등 숫자 너머의 핵심 용어 ${total}개를 이 사이트의 계산식과 공식 통계 정의의 차이까지 정리했습니다.`}>
  <div class="wrap">
    <section class="hero">
      <div class="eyebrow">용어 사전</div>
      <h1>이 사이트의 숫자는 이렇게 정의합니다</h1>
      <p class="lede">
        핵심 용어 {total}개의 정의와 계산식을 모았습니다. 같은 이름이라도 공식 통계와 기준이 다른 경우가 있어,
        그 차이와 해석할 때 주의할 점을 따로 적었습니다. 식에 들어간 가정(대출 비율, 기준연도 등)은 데이터가 갱신되면 함께 바뀝니다.
      </p>
      <PageMeta basis="이 사이트의 계산 기준" method={`${base}methodology/`} />
    </section>

    <div class="gl-tools">
      <label class="gl-search">
        <span class="sr-only">용어 찾기</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
        <input type="search" id="gl-q" placeholder="용어 찾기 (예: PIR, 순이동, 오차)" autocomplete="off" />
      </label>
      <p class="gl-count small muted" id="gl-count" aria-live="polite">{total}개 용어</p>
      <nav class="gl-index" aria-label="주제">
        {GLOSSARY.map((g) => <a href={`#${g.id}`}>{g.title} <span class="muted">{g.terms.length}</span></a>)}
      </nav>
    </div>

    {GLOSSARY.map((g) => (
      <section class="section gl-group" id={g.id}>
        <h2>{g.title}</h2>
        <div class="gl-list">
          {g.terms.map((t) => (
            <article class="card gl-term" id={t.id} data-text={`${t.term} ${t.en ?? ""} ${t.def}`.toLowerCase()}>
              <header>
                <h3 class="card-title"><a class="gl-anchor" href={`#${t.id}`}>{t.term}</a></h3>
                {t.en && <p class="gl-en">{t.en}</p>}
              </header>
              <p class="gl-def">{t.def}</p>
              {t.formula && <pre class="formula">{t.formula}</pre>}
              {t.diff && (
                <div class="gl-diff">
                  <span class="gl-k">공식 정의와의 차이 · 주의</span>
                  <p>{t.diff}</p>
                </div>
              )}
              <p class="gl-links">
                <span class="gl-k">쓰이는 곳</span>
                {t.links.map((l, i) => <>{i > 0 && " · "}<a href={href(l)}>{l.label}</a></>)}
              </p>
            </article>
          ))}
        </div>
      </section>
    ))}
    <p class="gl-empty muted" id="gl-empty" hidden>찾는 용어가 없습니다. 다른 낱말로 찾아보거나 <a href={`${base}methodology/`}>방법론</a>을 확인하세요.</p>
  </div>
</Base>

<script>
  const q = document.getElementById("gl-q") as HTMLInputElement | null;
  const count = document.getElementById("gl-count")!;
  const empty = document.getElementById("gl-empty")!;
  const terms = [...document.querySelectorAll<HTMLElement>(".gl-term")];
  const groups = [...document.querySelectorAll<HTMLElement>(".gl-group")];
  const total = terms.length;
  q?.addEventListener("input", () => {
    const v = q.value.trim().toLowerCase();
    let n = 0;
    for (const t of terms) {
      const hit = !v || (t.dataset.text ?? "").includes(v);
      t.hidden = !hit;
      if (hit) n++;
    }
    for (const g of groups) g.hidden = !g.querySelector(".gl-term:not([hidden])");
    count.textContent = v ? `${n}개 / ${total}개 용어` : `${total}개 용어`;
    empty.hidden = n > 0;
  });
</script>

<style>
  .gl-tools {
    display: grid;
    gap: 10px;
    margin-top: 8px;
  }
  .gl-search {
    display: flex;
    align-items: center;
    gap: 8px;
    max-width: 520px;
    padding: 0 12px;
    min-height: 44px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface-1);
    color: var(--text-muted);
  }
  .gl-search:focus-within {
    border-color: var(--accent);
  }
  .gl-search input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    font: inherit;
    font-size: 15px;
    color: var(--text-primary);
  }
  .gl-count {
    margin: 0;
  }
  .gl-index {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .gl-index a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    padding: 4px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 13px;
    color: var(--text-secondary);
    text-decoration: none;
  }
  .gl-index a:hover {
    color: var(--text-primary);
    background: var(--surface-2);
  }
  .gl-list {
    display: grid;
    gap: 12px;
    margin-top: 12px;
  }
  @media (min-width: 960px) {
    .gl-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
  }
  .gl-term {
    margin: 0 !important;
    scroll-margin-top: 76px;
  }
  .gl-term:target {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent);
  }
  .gl-anchor {
    color: inherit;
    text-decoration: none;
  }
  .gl-anchor:hover {
    text-decoration: underline;
  }
  .gl-en {
    margin: 0 0 8px;
    font-size: 12.5px;
    color: var(--text-muted);
  }
  .gl-def {
    margin: 6px 0 10px;
    font-size: 15px;
    line-height: 1.65;
  }
  .gl-term .formula {
    margin: 0 0 10px;
    font-size: 12.5px;
    white-space: pre-wrap;
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  .gl-diff {
    margin: 0 0 10px;
    padding: 8px 12px;
    border-left: 3px solid var(--warning);
    background: color-mix(in srgb, var(--warning) 8%, transparent);
    border-radius: 0 8px 8px 0;
  }
  .gl-diff p {
    margin: 2px 0 0;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--text-secondary);
  }
  .gl-k {
    font-size: 12px;
    font-weight: 650;
    color: var(--text-muted);
    margin-right: 8px;
  }
  .gl-links {
    margin: 0;
    font-size: 13px;
  }
  .gl-empty {
    margin-top: 24px;
  }
  .gl-term[hidden],
  .gl-group[hidden] {
    display: none;
  }
</style>
