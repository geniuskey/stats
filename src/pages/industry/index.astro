---
import Formula from "../../components/Formula.astro";
import { pageTitle, svcName } from "../../lib/nav";
import Base from "../../layouts/Base.astro";
import Chart from "../../components/Chart.astro";
import Stat from "../../components/Stat.astro";
import BarList from "../../components/BarList.astro";
import ChartSwitch from "../../components/ChartSwitch.astro";
import PageMeta from "../../components/PageMeta.astro";
import FigureFoot from "../../components/FigureFoot.astro";
import data from "../../data/industry.json";
import { pts } from "../../lib/series";
import { int, compact, pct } from "../../lib/format";

const D = data as any;
const N = D.national;
const S = D.summary;
const M = D.meta;
const inds = D.industries as any[];
const base = M.baseYear as number;
const end = M.projEnd as number;
// 그림 출처 (KOSIS 표 ID · 작성기관)
const SRC = {
  emp: "통계청 지역별고용조사 산업·연령별 취업자(KOSIS DT_1ES3B27J)",
  rate: "통계청 경제활동인구조사 연령계층별 고용률(KOSIS DT_1DA7002S)",
  gva: "한국은행 국민계정 경제활동별 실질 GDP(KOSIS DT_200Y106)",
  exp: "통계청·관세청 기업특성별 무역통계 산업별 수출(KOSIS DT_1TEC_P320)",
  pop: "행정안전부 주민등록인구 → 숫자 너머 인구추계(통계청 2022년 기준 장래추계 출산율 시나리오)",
};
const projNote = `${base + 1}년부터는 추계(중위 인구) · 예측이 아닌 시나리오.`;

// 천명 → 명
const k1000 = (m: Record<string, number>) => Object.fromEntries(Object.entries(m).map(([y, v]) => [y, v * 1000]));
const waHist = k1000(N.workingAgeHist);
const waProj = k1000(N.workingAge.mid);
const supBase = k1000(N.supply.base);
const supOlder = k1000(N.supply.older);
const emp = k1000(N.employment);

const supplySpec = {
  type: "line" as const,
  yFormat: "man" as const,
  projStart: base,
  series: [
    { name: "생산연령인구 (15~64세)", color: "var(--series-1)", data: pts(waHist) },
    { name: "생산연령인구 (추계·중위)", color: "var(--series-1)", data: pts(waProj), dash: true, label: true },
    { name: "취업자 (실측)", color: "var(--series-2)", data: pts(emp) },
    { name: "노동공급: 고용률 유지", color: "var(--series-2)", data: pts(supBase), dash: true, label: true },
    { name: "노동공급: 고령자 고용 확대", color: "var(--series-3)", data: pts(supOlder), dash: true },
  ],
  height: 340,
};
const supYears = [2015, 2020, 2025, 2030, 2035, 2040, 2045];
const supplyTable = {
  headers: ["연도", "생산연령인구", "취업자/공급(유지)", "공급(고령자 확대)"],
  rows: supYears.map((y) => [
    `${y}${y > base ? " (추계)" : ""}`,
    int(waHist[y] ?? waProj[y]),
    int(y <= base ? emp[y] : supBase[y]),
    y >= base ? int(supOlder[y]) : "–",
  ]),
};

// 연령 구성 변화 (고용률 유지)
const ageKeys = ["15-29", "30-39", "40-49", "50-59", "60+"];
const sba = N.supplyByAge;
const ageTable = {
  headers: ["연령", ...Object.keys(sba)],
  rows: ageKeys.map((a) => [a === "60+" ? "60세 이상" : `${a}세`, ...Object.keys(sba).map((y) => compact(sba[y][a] * 1000))]),
};
const older2045 = sba["2045"]["60+"] / Object.values(sba["2045"] as Record<string, number>).reduce((s, v) => s + v, 0);
const sbaShare = (y: number) => sba[y]["60+"] / Object.values(sba[y] as Record<string, number>).reduce((s, v) => s + v, 0);
const older2025 = sba["2025"]["60+"] / Object.values(sba["2025"] as Record<string, number>).reduce((s, v) => s + v, 0);

// 인력 과부족 토글
const demandKeys = [
  ["demo", "인구 연동"],
  ["hold", "현 수준 유지"],
  ["trend", "추세 연장"],
] as const;
const short35 = S.largestShortage2035 as any[];

// 은퇴 대체 수요
const retire = [...inds].sort((a, b) => b.retire10yShare - a.retire10yShare);
const retireBars = retire.map((i) => ({ name: i.name, value: i.retire10yShare }));
const retireTop = retire.slice(0, 5);

// 3축 분류
const order = { 성장: 0, 정체: 1, 쇠퇴: 2 } as Record<string, number>;
const clsRows = [...inds].sort((a, b) => order[a.class] - order[b.class] || b.score - a.score);
const clsColor: Record<string, string> = { 성장: "var(--div-pos)", 정체: "var(--text-muted, #898781)", 쇠퇴: "var(--div-neg)" };
const nameOf = (id: string) => inds.find((i) => i.id === id)?.name;
const sig = (v: number | null) => (v == null ? "" : v > 0 ? " ▲" : v < 0 ? " ▼" : "");

const top = (key: string, n = 1) => [...inds].sort((a, b) => (b.cagr[key] ?? -9) - (a.cagr[key] ?? -9)).slice(0, n);
const bestProd = top("productivity")[0];
const qInd = inds.find((i) => i.id === "Q");
const qShare = qInd.gap.demo.base["2035"] / S.gap.demo.base["2035"];
// ---- 시각화 확장
const clsSeries: Record<string, string> = { 성장: "var(--series-1)", 정체: "var(--neutral-series)", 쇠퇴: "var(--series-2)" };
const ageNames: Record<string, string> = { "15-29": "15~29세", "30-39": "30대", "40-49": "40대", "50-59": "50대", "60+": "60세 이상" };
const ageColors = ["var(--series-3)", "var(--series-1)", "var(--series-7)", "var(--series-4)", "var(--series-2)"];
const sbaYears = Object.keys(sba).map(Number);
const ageAreaSpec = {
  type: "area" as const, yFormat: "man" as const, height: 300,
  series: ageKeys.map((a, i) => ({ name: ageNames[a], color: ageColors[i], data: sbaYears.map((y) => [y, sba[y][a] * 1000] as [number, number]) })),
  projStart: base,
};
const ageStackSpec = {
  type: "stack" as const, percent: true, height: 300, categories: sbaYears.map(String),
  series: ageKeys.map((a, i) => ({ name: ageNames[a], color: ageColors[i], values: sbaYears.map((y) => sba[y][a] * 1000) })),
};
// 막대 레이스: 산업별 취업자 2013→2025
const empYears = Object.keys(inds[0].employment).sort();
const raceSpec = {
  type: "race" as const, top: 12, format: "man" as const, unit: "명", speed: 800, start: 0,
  names: inds.map((i) => i.name), colors: inds.map((i) => clsSeries[i.class]),
  frames: empYears.map((y) => ({ label: y, values: inds.map((i) => (i.employment[y] == null ? null : i.employment[y] * 1000)) })),
};
// 버블: 고용 vs 실질 부가가치 증가율
const scatterSpec = {
  type: "scatter" as const, height: 420, xFormat: "pct1S" as const, yFormat: "pct1S" as const, rFormat: "man" as const,
  xLabel: "취업자 연평균 증가율", yLabel: "실질 부가가치 연평균 증가율", rLabel: `취업자 ${base}`,
  xRef: N.cagr.employment, yRef: N.cagr.gva,
  quadrants: ["사람은 덜, 생산은 더", "", "고용·생산 동반 축소", "고용만 늘고 생산은 정체"] as [string, string, string, string],
  groups: ["성장", "정체", "쇠퇴"].map((c) => ({ name: c, color: clsSeries[c] })),
  labels: ["보건·사회복지", "전자·전기·기계·정밀", "정보통신", "도매·소매", "섬유·의복·가죽", "건설", "금융·보험", "교육"],
  points: inds.filter((i) => i.cagr.gva != null).map((i) => ({ x: i.cagr.employment, y: i.cagr.gva, r: i.employment[base] * 1000, label: i.name, group: i.class, note: `1인당 생산성 연 ${pct(i.cagr.productivity, 1, true)}` })),
};
// 과부족 시뮬레이터 입력
const simJson = JSON.stringify({
  base,
  total: { supply: N.supply, },
  inds: inds.map((i) => ({ id: i.id, name: i.name, supply: i.supply, demand: i.demand })),
}).replace(/</g, "\\u003c");

---
<Base title={pageTitle("industry")} active="industry" description={`산업별 고용·생산·수출과 인구추계를 결합한 산업구조·고용수요 전망. 고용률이 지금과 같다면 노동공급은 ${base}년 대비 ${end}년 ${pct(S.supplyChange2045.base, 0, true)} 변합니다.`}>
  <div class="wrap">
    <section class="hero hero-split">
      <div>
        <div class="eyebrow">{svcName("industry")} · 산업별 고용 × 생산 × 수출 × 인구추계</div>
        <h1>일할 사람은 줄고, 돌봄 일자리만 커집니다</h1>
        <p class="lede">
          산업별 취업자의 나이 구조, 실질 부가가치, 수출 실적에 주민등록 기반 인구추계를 결합했습니다. 어떤 산업이 커지고 있는지,
          10년 안에 은퇴로 비는 자리가 얼마나 되는지, 그리고 인구가 줄 때 어느 산업에서 사람이 모자라는지 시나리오로 계산합니다.
        </p>
        <p class="small muted">오른쪽은 {empYears[0]}→{empYears.at(-1)}년 산업별 취업자 순위입니다. 보건·사회복지가 {compact(qInd.employment[empYears[0]] * 1000)}명에서 {compact(qInd.employment[empYears.at(-1)!] * 1000)}명으로 늘며 순위를 끌어올리는 모습을 재생해 보세요. 색: <span class="kw" style="--c:var(--series-1)">성장</span> <span class="kw" style="--c:var(--neutral-series)">정체</span> <span class="kw" style="--c:var(--series-2)">쇠퇴</span></p>
        <PageMeta basis={`${base}년 실측 · ${base + 1}~${end}년 인구추계 기반 시나리오 · 산업 분류 ${M.trendFrom}→${M.trendTo}년`} orgs={["통계청", "한국은행", "관세청", "행정안전부"]} />
      </div>
      <figure class="card" style="margin:0" id="fig-emp-race">
        <h2 class="card-title">산업별 취업자 순위 {empYears[0]} → {empYears.at(-1)}</h2>
        <p class="card-sub">상위 12개 산업, 지역별고용조사 연평균</p>
        <div class="chart" data-chart><script type="application/json" set:html={JSON.stringify({ ...raceSpec, autoplay: true }).replace(/</g, "\\u003c")} /></div>
        <FigureFoot note="연평균 취업자. 산업은 한국표준산업분류 11차 대분류." source={SRC.emp} derived={false} />
      </figure>
    </section>

    <div class="grid grid-4">
      <Stat label={`노동공급 ${base} → ${end}`} value={pct(S.supplyChange2045.base, 0, true)} note={`고용률 유지 시 ${compact(N.supply.base[base] * 1000)} → ${compact(N.supply.base[end] * 1000)}명`} tone="down" />
      <Stat label="10년 내 은퇴 연령 도달 취업자" value={compact(S.retire10y * 1000)} unit="명" note={`전체 취업자의 ${pct(S.retire10yShare, 0)} (60세 이상 + 50대 절반)`} />
      <Stat label="2035년 인력 부족 (인구 연동 수요)" value={compact(-S.gap.demo.base["2035"] * 1000)} unit="명" note={`고령자 고용 확대 시 ${compact(-S.gap.demo.older["2035"] * 1000)}명 · 시나리오`} tone="down" />
      <Stat label="성장 · 정체 · 쇠퇴 산업" value={`${S.classes["성장"].length} · ${S.classes["정체"].length} · ${S.classes["쇠퇴"].length}`} note={`25개 산업, ${M.trendFrom}→${M.trendTo} 고용·생산·수출 3축`} />
    </div>

    <section class="section">
      <h2>일할 수 있는 사람은 얼마나 줄어드나</h2>
      <p class="section-desc">
        생산연령인구(15~64세)는 {base}년 {compact(N.workingAge.mid[base] * 1000)}명에서 {end}년 {compact(N.workingAge.mid[end] * 1000)}명으로 {pct(S.workingAgeChange2045, 0, true)} 줄어듭니다.
        고령자도 일을 하기 때문에 실제 노동공급의 감소폭은 이보다 작지만, 그래도 {end}년까지 {pct(S.supplyChange2045.base, 0, true)}입니다. 60~74세 고용률이 5~7.5%p 오르면 감소폭은 {pct(S.supplyChange2045.older, 0, true)}로 줄어듭니다.
        점선은 추계·시나리오이며 예측이 아닙니다.
      </p>
      <Chart spec={supplySpec} table={supplyTable} title="생산연령인구와 노동공급 (명)" sub={`2015~${end}년, 실측 취업자는 지역별고용조사 연평균 · 공급은 연령별 고용률 × 인구추계(중위)`} note={`노동공급 = 연령별 고용률 × 연령별 인구. 고령자 고용 확대: ${M.scenarios.supply.older}. ${projNote}`} source={[SRC.emp, SRC.rate, SRC.pop]} />
    </section>

    <section class="section grid grid-2">
      <ChartSwitch views={[{ label: "인원 누적", spec: ageAreaSpec }, { label: "구성비 막대", spec: ageStackSpec }]} table={ageTable} note={`고용률 ${base}년 수준 고정. ${projNote}`} source={[SRC.emp, SRC.rate, SRC.pop]} title="노동공급의 연령 구성 (고용률 유지)" sub={`${sbaYears[0]}·${sbaYears[1]}년은 실제 취업자, ${base + 1}년부터 고용률 유지 추계 · 60세 이상 비중: ${sbaYears[0]}년 ${pct(sbaShare(sbaYears[0]), 0)} → ${base}년 ${pct(older2025, 0)} → ${end}년 ${pct(older2045, 0)}`} />
      <div class="card">
        <h3 class="card-title">무엇이 새로 보이나</h3>
        <div class="insight" style="margin-top:8px">
          인구 연동 수요로 보면 2035년 부족 인력의 <strong>{pct(qShare, 0)}</strong>가 <strong>보건·사회복지</strong> 한 산업에서 나옵니다. 65세 이상 인구가 {base}년 {compact(N.older65[base] * 1000)}명에서 2035년 {compact(N.older65["2035"] * 1000)}명으로 늘기 때문입니다.
        </div>
        <div class="insight" style="margin-top:10px">
          반대로 <strong>교육</strong>은 학령인구가 줄어 2035년 {compact(inds.find((i) => i.id === "P").gap.demo.base["2035"] * 1000)}명이 남는 것으로 계산됩니다.
        </div>
        <div class="insight" style="margin-top:10px">
          1인당 실질 부가가치가 가장 빠르게 오른 산업은 <strong>{bestProd.name}</strong>(연 {pct(bestProd.cagr.productivity, 1, true)})입니다. 사람이 줄어도 생산을 유지할 수 있는 산업과 그렇지 못한 산업이 갈립니다.
        </div>
      </div>
    </section>

    <section class="section" id="gap">
      <h2>산업별 인력 과부족 시뮬레이터</h2>
      <p class="section-desc">
        공급에서 수요를 뺀 값입니다. 왼쪽(빨강)은 사람이 모자라고, 오른쪽(파랑)은 남는다는 뜻입니다. 수요 가정을 고르고, 고령자 고용과 생산성 향상을 슬라이더로 바꿔 보세요.
        어느 시나리오도 예측이 아니라 "이 가정이면 이렇게 된다"를 보여주는 계산입니다.
      </p>
      <div class="card">
        <div class="sim">
          <div class="sim-controls">
            <div>
              <div class="small muted" style="margin-bottom:6px">수요 가정</div>
              <div class="seg" data-group="d">
                {demandKeys.map(([k, l], i) => <button type="button" data-v={k} aria-pressed={i === 0 ? "true" : "false"}>{l}</button>)}
              </div>
            </div>
            <div class="slider">
              <div class="slider-top"><label for="g-older">고령자(60~74세) 고용 확대</label><output id="o-older"></output></div>
              <input type="range" id="g-older" min="0" max="2" step="0.1" value="0" />
              <div class="slider-hint"><span>지금 고용률 유지</span><span>시나리오 1배</span><span>2배</span></div>
            </div>
            <div class="slider">
              <div class="slider-top"><label for="g-prod">생산성 향상으로 줄어드는 인력 수요</label><output id="o-prod"></output></div>
              <input type="range" id="g-prod" min="0" max="0.02" step="0.001" value="0" />
              <div class="slider-hint"><span>없음</span><span>연 2%</span></div>
            </div>
            <div>
              <div class="small muted" style="margin-bottom:6px">기준 연도</div>
              <div class="seg" data-group="y">
                {["2030", "2035", "2040", "2045"].map((y) => <button type="button" data-v={y} aria-pressed={y === "2035" ? "true" : "false"}>{y}년</button>)}
              </div>
            </div>
            <p class="small muted" style="margin:0">고령자 고용 확대 1배 = {M.scenarios.supply.older}. 수요 — 인구 연동: {M.scenarios.demand.demo} · 현 수준 유지: {M.scenarios.demand.hold} · 추세 연장: {M.scenarios.demand.trend}</p>
          </div>
          <div>
            <div class="sim-out" id="g-out"></div>
            <h3 class="card-title" style="margin-top:16px">경제 전체 인력 과부족 추이</h3>
            <div class="chart" id="g-line"></div>
          </div>
        </div>
        <h3 class="card-title" style="margin-top:20px" id="g-bars-title">산업별 과부족</h3>
        <div class="bar-list" id="g-bars" role="list"></div>
      </div>
      <script type="application/json" id="g-data" set:html={simJson} />
    </section>

    <section class="section grid grid-2">
      <div class="card">
        <h3 class="card-title">은퇴 대체 수요: 10년 안에 비는 자리</h3>
        <p class="card-sub">{base}년 취업자 중 10년 안에 65세에 이르는 사람의 비중 (60세 이상 + 50대의 절반)</p>
        <BarList items={retireBars} format="pct" color="var(--series-1)" />
        <p class="small muted" style="margin-top:10px">인원 기준: {[...inds].sort((a, b) => b.retire10y - a.retire10y).slice(0, 4).map((i) => `${i.name} ${compact(i.retire10y * 1000)}명`).join(", ")}</p>
      </div>
      <div class="card">
        <h3 class="card-title">2035년 가장 크게 부족한 산업</h3>
        <p class="card-sub">인구 연동 수요 · 고용률 유지 공급 기준</p>
        <div class="table-wrap">
          <table>
            <thead><tr><th>산업</th><th class="num">부족 인력</th><th class="num">{base}년 취업자</th><th class="num">60세 이상 비중</th></tr></thead>
            <tbody>
              {short35.map((x) => {
                const i = inds.find((z) => z.id === x.id);
                return <tr><td>{x.name}</td><td class="num">{compact(-x.gap * 1000)}명</td><td class="num">{compact(i.employment[base] * 1000)}</td><td class="num">{pct(i.olderShare, 0)}</td></tr>;
              })}
            </tbody>
          </table>
        </div>
        <p class="small muted" style="margin-top:10px">
          청년(15~29세) 비중이 가장 낮은 산업: {[...inds].sort((a, b) => a.youngShare - b.youngShare).slice(0, 3).map((i) => `${i.name} ${pct(i.youngShare, 0)}`).join(", ")}
        </p>
      </div>
    </section>

    <section class="section">
      <h2>성장 · 정체 · 쇠퇴: 고용 × 생산 × 수출 3축 분류</h2>
      <p class="section-desc">
        {M.trendFrom}→{M.trendTo}년 연평균 증가율을 경제 전체(취업자 {pct(N.cagr.employment, 1, true)}, 실질 부가가치 {pct(N.cagr.gva, 1, true)}, 수출 {pct(N.cagr.exports, 1, true)})와 비교했습니다.
        ▲는 경제 전체보다 1%p 이상 높고, ▼는 1%p 이상 낮다는 뜻입니다. 수출 통계는 광업·제조업·도소매만 있습니다.
      </p>
      <figure class="card" style="margin:0 0 16px" id="fig-emp-gva">
        <h3 class="card-title">고용 증가율 × 실질 부가가치 증가율</h3>
        <p class="card-sub">{M.trendFrom}→{M.trendTo}년 연평균, 점선은 경제 전체. 원 크기 = {base}년 취업자. 오른쪽 위가 고용과 생산이 함께 큰 산업입니다. 점을 가리키면 생산성이 보입니다</p>
        <div class="chart" data-chart><script type="application/json" set:html={JSON.stringify(scatterSpec).replace(/</g, "\\u003c")} /></div>
        <FigureFoot note={`${M.trendFrom}→${M.trendTo}년 연평균 증가율. 실질 부가가치는 2020년 연쇄가격.`} source={[SRC.emp, SRC.gva]} />
      </figure>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>산업</th><th>분류</th>
              <th class="num">취업자 {base}</th>
              <th class="num">취업자</th><th class="num">실질 부가가치</th><th class="num">수출</th><th class="num">1인당 생산성</th>
            </tr>
          </thead>
          <tbody>
            {clsRows.map((i) => (
              <tr>
                <td>{i.name}{i.flags.length > 0 && <span class="small muted"> · {i.flags.join(", ")}</span>}</td>
                <td><span class="badge"><span class="dot" style={`background:${clsColor[i.class]}`}></span>{i.class}</span></td>
                <td class="num">{compact(i.employment[base] * 1000)}</td>
                <td class="num">{pct(i.cagr.employment, 1, true)}{sig(i.signals.employment)}</td>
                <td class="num">{pct(i.cagr.gva, 1, true)}{sig(i.signals.gva)}</td>
                <td class="num">{i.cagr.exports == null ? "–" : pct(i.cagr.exports, 1, true) + sig(i.signals.exports)}</td>
                <td class="num">{pct(i.cagr.productivity, 1, true)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="small muted" style="margin-top:10px">
        성장: {S.classes["성장"].map(nameOf).join(", ")} / 쇠퇴: {S.classes["쇠퇴"].map(nameOf).join(", ")}
      </p>
    </section>

    <section class="section card method" id="method">
      <h2>방법론</h2>
      <p><strong>이 페이지의 미래 값은 모두 가정에 따른 시나리오 계산이며 예측이 아닙니다.</strong> 기술 변화, 이민 정책, 자동화, 경기 변동은 반영하지 않습니다.</p>
      <h3>1. 3축 성장 점수</h3>
      <p>{M.trendFrom}→{M.trendTo}년 취업자, 실질 부가가치(한국은행, 2020년 연쇄가격), 수출액(수출 기업의 산업 기준)의 연평균 증가율을 구합니다. 각 축이 경제 전체보다 1%p 이상 높으면 +1, 낮으면 −1, 그 사이면 0입니다. 평균 점수가 +0.5 이상이면서 취업자와 부가가치가 모두 늘면 '성장', −0.5 이하이면서 둘 중 하나가 줄면 '쇠퇴', 나머지는 '정체'로 분류합니다.</p>
      <h3>2. 은퇴 대체 수요</h3>
      <Formula tex={[String.raw`10년 내 은퇴 연령 도달 = 60세 이상 취업자 + 0.5 \times 50대 취업자`]} />
      <p>50대는 나이가 고르게 분포한다고 보고 절반을 55~59세로 근사합니다. 은퇴 연령은 65세로 둡니다.</p>
      <h3>3. 노동공급과 과부족</h3>
      <Formula tex={[String.raw`공급(t) = \sum_{연령} 고용률(연령,\ ${base}) \times 인구추계(연령,\ t) \times 보정계수`, String.raw`산업 공급(t) = \sum_{연령대} 연령대 공급(t) \times 산업의 연령대 점유율(${base})`, String.raw`과부족 = 산업 공급 - 산업 수요`]} />
      <p>인구추계는 이 사이트의 주민등록 기반 코호트 추계(통계청 출산율 중위 시나리오)입니다. 보정계수는 {base}년 공급이 실제 취업자와 같아지도록 맞춘 값입니다. 공급 시나리오: {M.scenarios.supply.base} / {M.scenarios.supply.older}. 수요 시나리오: 현 수준 유지({M.scenarios.demand.hold}), 추세 연장({M.scenarios.demand.trend}), 인구 연동({M.scenarios.demand.demo}).</p>
      <h3>한계</h3>
      <ul>
        <li>2026년 이후 태어날 아이들은 2041년에야 15세가 되므로, 출산율 시나리오는 {end}년까지 노동공급에 거의 영향을 주지 않습니다.</li>
        <li>연령대별 산업 선택 구조를 {base}년으로 고정합니다. 그래서 60세 이상 비중이 큰 농림어업·부동산은 고령인구 증가로 공급이 오히려 늘어나는 것으로 계산됩니다.</li>
        <li>주민등록인구는 내국인 기준입니다. 외국인 노동력은 기준연도 보정에만 간접 반영됩니다.</li>
        <li>수출은 수출한 기업의 산업 기준이라 도소매 수출은 무역상사 실적이며, 서비스 수출은 포함되지 않습니다.</li>
        <li>지역별고용조사는 표본조사이며 반기 값의 평균을 연간 값으로 썼습니다. 최근 반기({N.latestHalf}) 취업자는 {compact(N.latestEmployment * 1000)}명입니다.</li>
      </ul>
      <h3>데이터 출처</h3>
      <ul>{M.sources.map((s: string) => <li>{s}</li>)}</ul>
    </section>
  </div>
</Base>
<style>
  .method .formula { white-space: pre-wrap; overflow-wrap: anywhere; }
  #gap .controls .seg { max-width: 100%; }
  :global(.grid > *) { min-width: 0; }
  .kw { display: inline-flex; align-items: center; gap: 4px; margin-right: 6px; }
  .kw::before { content: ""; width: 10px; height: 10px; border-radius: 3px; background: var(--c); }
  #g-bars .g-fill { animation: none; transition: left 0.35s ease, width 0.35s ease; border-radius: 4px; }
  #gap .seg { max-width: 100%; }
</style>
<script>
  import { mount } from "../../lib/charts";
  import { fmt, compact } from "../../lib/format";
  const G = JSON.parse(document.getElementById("g-data")!.textContent || "{}");
  const years = ["2025", "2030", "2035", "2040", "2045"];
  const state: Record<string, string> = { d: "demo", y: "2035" };
  const older = document.getElementById("g-older") as HTMLInputElement;
  const prod = document.getElementById("g-prod") as HTMLInputElement;
  const lineEl = document.getElementById("g-line")!;
  const barsEl = document.getElementById("g-bars")!;
  const outEl = document.getElementById("g-out")!;
  const gapOf = (ind: any, y: string, k: number, p: number) => {
    const sb = ind.supply.base[y], so = ind.supply.older[y];
    const sup = sb + (so - sb) * k;
    const dem = ind.demand[state.d][y] * Math.pow(1 - p, +y - G.base);
    return (sup - dem) * 1000;
  };
  let raf = 0;
  const run = () => {
    const k = +older.value, p = +prod.value;
    document.getElementById("o-older")!.textContent = k === 0 ? "유지" : `${k.toFixed(1)}배`;
    document.getElementById("o-prod")!.textContent = p === 0 ? "없음" : `연 ${(p * 100).toFixed(1)}%`;
    const tot = years.map((y) => [+y, G.inds.reduce((a: number, i: any) => a + gapOf(i, y, k, p), 0)] as [number, number]);
    const totBase = years.map((y) => [+y, G.inds.reduce((a: number, i: any) => a + gapOf(i, y, 0, 0), 0)] as [number, number]);
    const items = G.inds.map((i: any) => ({ name: i.name, value: gapOf(i, state.y, k, p) })).sort((a: any, b: any) => a.value - b.value);
    const short = items.filter((x: any) => x.value < 0);
    const ty = tot.find((t) => String(t[0]) === state.y)![1];
    const tiles: [string, string, string][] = [
      [`${state.y}년 경제 전체`, ty < 0 ? `${compact(-ty)}명 부족` : `${compact(ty)}명 여유`, `고용률 유지·생산성 불변이면 ${compact(Math.abs(totBase.find((t) => String(t[0]) === state.y)![1]))}명 ${totBase.find((t) => String(t[0]) === state.y)![1] < 0 ? "부족" : "여유"}`],
      ["사람이 모자란 산업", `${short.length}개`, `25개 산업 중`],
      ["가장 크게 부족", short[0] ? short[0].name : "없음", short[0] ? `${compact(-short[0].value)}명` : ""],
    ];
    outEl.innerHTML = "";
    for (const [a, b, c] of tiles) {
      const d = document.createElement("div");
      d.className = "stat";
      d.innerHTML = `<div class="stat-label"></div><div class="stat-value"></div><div class="stat-note"></div>`;
      d.querySelector(".stat-label")!.textContent = a;
      d.querySelector(".stat-value")!.textContent = b;
      d.querySelector(".stat-note")!.textContent = c;
      outEl.appendChild(d);
    }
    mount(lineEl, {
      type: "line", yFormat: "man", height: 220, zeroBased: false, animate: false,
      hLines: [{ y: 0, label: "균형" }],
      series: [
        { name: "고용률 유지 · 생산성 불변", color: "var(--neutral-series)", dash: true, data: totBase },
        { name: "내 시나리오", color: "var(--series-1)", data: tot, label: true, width: 2.5 },
      ],
    } as any);
    // 발산 막대
    const maxAbs = Math.max(...items.map((x: any) => Math.abs(x.value)), 1);
    document.getElementById("g-bars-title")!.textContent = `산업별 과부족 · ${state.y}년 (공급 − 수요)`;
    if (barsEl.children.length !== items.length) {
      barsEl.innerHTML = "";
      items.forEach(() => {
        const r = document.createElement("div");
        r.className = "bar-row";
        r.setAttribute("role", "listitem");
        r.innerHTML = `<span class="bar-name"></span><span class="bar-track"><span class="bar-fill g-fill"></span><span class="bar-zero" style="left:50%"></span></span><span class="bar-val"></span>`;
        barsEl.appendChild(r);
      });
    }
    [...barsEl.children].forEach((r, idx) => {
      const it = items[idx];
      const w = (Math.abs(it.value) / maxAbs) * 50;
      const f = r.querySelector<HTMLElement>(".bar-fill")!;
      f.classList.toggle("neg", it.value < 0);
      f.style.left = it.value < 0 ? `${50 - w}%` : "50%";
      f.style.width = `${w}%`;
      f.style.background = it.value < 0 ? "var(--div-neg)" : "var(--div-pos)";
      r.querySelector(".bar-name")!.textContent = it.name;
      r.querySelector(".bar-val")!.textContent = (it.value > 0 ? "+" : "") + fmt(it.value, "man");
    });
  };
  const schedule = () => {
    cancelAnimationFrame(raf);
    raf = requestAnimationFrame(run);
  };
  [older, prod].forEach((i) => i.addEventListener("input", schedule));
  document.querySelectorAll<HTMLElement>("#gap .seg").forEach((seg) => {
    const g = seg.dataset.group!;
    seg.querySelectorAll<HTMLButtonElement>("button").forEach((b) =>
      b.addEventListener("click", () => {
        state[g] = b.dataset.v!;
        seg.querySelectorAll("button").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
        run();
      }),
    );
  });
  run();
</script>
