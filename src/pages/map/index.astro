    for (let p = 0; p < L.pairs.length; p++) {
      const c = decode(L.dots[p][lapseGroup][i]) || bigMap.get(`${p},${lapseGroup},${i}`) || 0;
      if (!c) continue;
      const ia = L.ids[L.pairs[p][0]], ib = L.ids[L.pairs[p][1]];
