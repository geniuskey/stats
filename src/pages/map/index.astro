---
// 지도로 보기 — 이사 흐름(시군구 간 연령별 이동)과 시군구 지표. MapLibre GL(CDN) + OpenFreeMap 벡터 바탕
import Base from "../../layouts/Base.astro";
import dongne from "../../data/dongne.json";
import housingSgg from "../../data/housing_sgg.json";
import move from "../../data/move.json";
import { makeBins, type ScaleKind } from "../../lib/scale";
import { TIME_METRICS, SGG_IDS, SIDO_IDS, type TimeMetric } from "../../lib/mapFrames";
import type { Fmt } from "../../lib/format";

const base = import.meta.env.BASE_URL;
const vworldKey = import.meta.env.PUBLIC_VWORLD_KEY ?? "";

const DN = dongne as any;
const by: number = DN.meta.baseYear;
const end: number = DN.meta.end;
const regs = DN.regions as any[];
const HS = (housingSgg as any).regions as Record<string, any>;
const MV = (move as any).regions as Record<string, any>;
const hm = (housingSgg as any).meta;
const mm = (move as any).meta;
const ymLabel = (ym: string) => `${ym.slice(0, 4)}.${ym.slice(4)}`;
const r4 = (v: any) => (v == null || !isFinite(v) ? null : Math.round(v * 10000) / 10000);
const fromRegs = (f: (r: any) => any) => Object.fromEntries(regs.map((r) => [r.id, r4(f(r))]));
const fromObj = (o: Record<string, any>, k: string, div = 1) =>
  Object.fromEntries(regs.map((r) => [r.id, o[r.id]?.[k] == null ? null : r4(o[r.id][k] / div)]));

interface M { key: string; label: string; format: Fmt; kind: ScaleKind; breaks: number[]; mid?: number; desc: string; values?: Record<string, number | null>; time?: boolean; level?: string }
const tm = (key: string): M => ({ ...(TIME_METRICS.find((m) => m.key === key) as TimeMetric), time: true });
const groups: { title: string; src: string; metrics: M[] }[] = [
  {
    title: "이사 흐름", src: `행안부 전입신고 ${ymLabel(mm.period[0])}~${ymLabel(mm.period[1])}`,
    metrics: [
      { key: "rate", label: "전체", format: "dec1", kind: "div", breaks: [-10, -5, -2, 2, 5, 10],
        desc: "색: 다른 시군구와 주고받은 순이동(인구 1천 명당). 선: 사람이 움직인 길.", values: fromObj(MV, "rate") },
      { key: "kidsRate", label: "아이 0~14세", format: "dec1", kind: "div", breaks: [-3, -1.5, -0.5, 0.5, 1.5, 3],
        desc: "아이는 혼자 이사하지 않습니다. 아이 키우는 가족이 어디로 가는지 보여 줍니다.", values: fromObj(MV, "kidsRate") },
      { key: "youthRate", label: "20~34세", format: "dec1", kind: "div", breaks: [-6, -3, -1, 1, 3, 6],
        desc: "진학·취업·첫 독립의 이동. 색은 이 나이의 순이동(전체 인구 1천 명당).", values: fromObj(MV, "youthRate") },
      { key: "midRate", label: "35~49세", format: "dec1", kind: "div", breaks: [-4, -2, -0.5, 0.5, 2, 4],
        desc: "내 집 마련과 학군의 이동. 색은 이 나이의 순이동(전체 인구 1천 명당).", values: fromObj(MV, "midRate") },
      { key: "preRate", label: "50~64세", format: "dec1", kind: "div", breaks: [-4, -2, -0.5, 0.5, 2, 4],
        desc: "은퇴 전후·귀농귀촌의 이동. 색은 이 나이의 순이동(전체 인구 1천 명당).", values: fromObj(MV, "preRate") },
      { key: "oldRate", label: "65세 이상", format: "dec1", kind: "div", breaks: [-4, -2, -0.5, 0.5, 2, 4],
        desc: "고향·자녀 곁·요양으로의 이동. 색은 이 나이의 순이동(전체 인구 1천 명당).", values: fromObj(MV, "oldRate") },
    ],
  },
  {
    title: "인구 전망", src: `2015~${end} · ▶로 재생`,
    metrics: [
      tm("t_pop"), tm("t_old"), tm("t_kid"), tm("t_ext"),
      { key: "idx", label: "지속가능성 지수", format: "dec1", kind: "div", mid: 50, breaks: [30, 40, 45, 50, 55, 60, 70],
        desc: "인구 전망·청년 이동·소멸위험·일자리·빈집을 합친 지수. 50 = 시군구 평균.", values: fromRegs((r) => r.m.index) },
    ],
  },
  {
    title: "학교·돌봄·상권", src: `~${end} 추계`,
    metrics: [tm("t_school"), tm("t_old75"), tm("t_cons")],
  },
  {
    title: "집값", src: `국토부 실거래 2022~${ymLabel(hm.period[1])}`,
    metrics: [
      tm("t_hburden"), tm("t_hprice"), tm("t_hjeonse"), tm("t_hrenew"),
      { key: "wolseShare", label: "월세 비중", format: "pct", kind: "seq", breaks: [0.3, 0.4, 0.5, 0.6, 0.7, 0.8],
        desc: "아파트 전월세 계약 중 월세(보증부 월세 포함) 비율.", values: fromObj(HS, "wolseShare") },
      tm("t_burden"),
    ],
  },
];
const payload = {
  key: vworldKey,
  geo: `${base}geo/sgg.json`,
  geoSido: `${base}geo/sido.json`,
  geoPts: `${base}geo/sgg_pts.json`,
  flows: `${base}data/move_flows.json`,
  frames: `${base}map/frames.json`,
  flowPeriod: `${ymLabel(mm.period[0])}~${ymLabel(mm.period[1])}`,
  flowWindows: ((move as any).flowWindows ?? [{ key: "recent", label: "최근 1년", period: mm.period, file: "move_flows.json" }]).map((w: any) => ({
    ...w, url: `${base}data/${w.file}`, periodLabel: `${ymLabel(w.period[0])}~${ymLabel(w.period[1])}`,
  })),
  sidoNames: Object.fromEntries(regs.map((r) => [r.sidoCode, r.sido])),
  moveNet: Object.fromEntries(Object.entries(MV).map(([id, r]: any) => [id, { all: r.net, kids: r.kids, youth: r.youth, mid: r.mid, pre: r.pre, old: r.old }])),
  base,
  groups: groups.map((g) => ({
    title: g.title, src: g.src,
    metrics: g.metrics.map((m) => ({ ...m, bins: makeBins(m.breaks, m.kind, m.format, m.mid).map((b) => ({ color: b.color, label: b.label, lo: b.lo, hi: b.hi })) })),
  })),
  regions: Object.fromEntries(regs.map((r) => [r.id, { n: `${r.sido} ${r.name}`, pop: r.series.mid[by].total }])),
};
const json = JSON.stringify(payload).replace(/</g, "\\u003c");
---
<Base title="지도로 보기" active="map" description="누가 어디서 어디로 이사 가는지, 나이별 이동의 흐름을 지도 위에서 봅니다. 시군구별 인구 전망·집값 부담·전세가율도 함께.">
  <div class="map-page">
    <aside class="map-side" aria-label="지표 선택">
      <div class="map-search">
        <input type="search" id="mp-q" placeholder="동네·아파트·주소 검색" autocomplete="off" aria-label="장소 검색" />
        <ul id="mp-results" class="map-results" role="listbox" hidden></ul>
      </div>
      <div id="mp-groups"></div>
      <div class="map-legend" id="mp-legend"></div>
      <p class="small muted" id="mp-desc"></p>
      <div class="map-flow" id="mp-flow" hidden></div>
      <div class="map-detail" id="mp-detail" hidden></div>
    </aside>
    <div class="map-wrap">
      <div id="mp-map" class="map-canvas" role="region" aria-label="대한민국 지도"></div>
      <canvas id="mp-arcs" class="map-arcs" aria-hidden="true"></canvas>
      <div class="map-tip" id="mp-tip" hidden></div>
      <div class="map-year" id="mp-year" hidden aria-live="polite"><b></b><span></span></div>
      <div class="map-time" id="mp-time" hidden>
        <div class="row1">
          <button type="button" id="mp-play" class="play" aria-label="재생">▶</button>
          <div class="track"><input type="range" id="mp-range" min="0" max="0" step="1" aria-label="연도" /><div class="ticks" id="mp-ticks"></div></div>
        </div>
        <div class="scen" id="mp-scen"></div>
      </div>
    </div>
  </div>
  <script type="application/json" id="mp-data" set:html={json} />
</Base>

<style>
  .map-page {
    display: grid;
    grid-template-columns: 320px 1fr;
    height: calc(100vh - 64px);
    min-height: 520px;
    border-top: 1px solid var(--border, rgba(127, 127, 127, 0.2));
  }
  .map-side {
    overflow-y: auto;
    padding: 16px;
    background: var(--surface-1);
    border-right: 1px solid var(--border, rgba(127, 127, 127, 0.2));
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .map-wrap { position: relative; min-height: 0; }
  .map-canvas { position: absolute; inset: 0; background: var(--surface-1); }
  .map-search { position: relative; }
  .map-search input {
    width: 100%;
    box-sizing: border-box;
    padding: 10px 12px;
    border-radius: 10px;
    border: 1px solid var(--border, rgba(127, 127, 127, 0.35));
    background: var(--surface-2);
    color: var(--text-primary);
    font: inherit;
  }
  .map-results {
    position: absolute;
    z-index: 5;
    left: 0;
    right: 0;
    top: calc(100% + 4px);
    margin: 0;
    padding: 4px;
    list-style: none;
    background: var(--surface-1);
    border: 1px solid var(--border, rgba(127, 127, 127, 0.35));
    border-radius: 10px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    max-height: 320px;
    overflow-y: auto;
  }
  :global(.map-results li) { padding: 8px 10px; border-radius: 8px; cursor: pointer; font-size: 14px; }
  :global(.map-results li:hover), :global(.map-results li[aria-selected="true"]) { background: var(--surface-2); }
  :global(.map-results li small) { display: block; color: var(--text-muted); font-size: 12px; }
  :global(.mp-group h3) { font-size: 12px; letter-spacing: 0.04em; color: var(--text-muted); margin: 0 0 6px; font-weight: 600; }
  :global(.mp-group .mp-src) { font-weight: 400; }
  :global(.mp-chips) { display: flex; flex-wrap: wrap; gap: 6px; }
  :global(.mp-chips button) {
    font: inherit;
    font-size: 13px;
    padding: 6px 10px;
    border-radius: 999px;
    border: 1px solid var(--border, rgba(127, 127, 127, 0.35));
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
  }
  :global(.mp-chips button[aria-pressed="true"]) { background: var(--text-primary); color: var(--surface-1); border-color: var(--text-primary); }
  #mp-groups { display: grid; gap: 14px; }
  .map-legend { display: grid; gap: 4px; font-size: 12px; }
  :global(.map-legend .row) { display: flex; align-items: center; gap: 8px; color: var(--text-secondary); }
  :global(.map-legend i) { width: 18px; height: 12px; border-radius: 3px; display: inline-block; }
  :global(.map-legend .title) { font-weight: 600; color: var(--text-primary); font-size: 13px; margin-bottom: 2px; }
  .map-detail { border: 1px solid var(--border, rgba(127, 127, 127, 0.25)); border-radius: 12px; padding: 12px; background: var(--surface-1); }
  :global(.map-detail h3) { margin: 0 0 8px; font-size: 16px; }
  :global(.map-detail table) { width: 100%; font-size: 13px; border-collapse: collapse; }
  :global(.map-detail td) { padding: 3px 0; }
  :global(.map-detail td.num) { text-align: right; font-variant-numeric: tabular-nums; }
  :global(.map-detail tr.on td) { font-weight: 700; }
  :global(.map-detail .links) { display: flex; flex-wrap: wrap; gap: 6px 12px; margin-top: 10px; font-size: 13px; }
  .map-tip {
    position: absolute;
    z-index: 3;
    pointer-events: none;
    background: var(--surface-1);
    color: var(--text-primary);
    border: 1px solid var(--border, rgba(127, 127, 127, 0.3));
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 13px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
    white-space: nowrap;
  }
  :global(.map-tip b) { display: block; }
  :global(.maplibregl-ctrl-attrib) { font-size: 11px; }
  .map-year { position: absolute; left: 16px; top: 12px; z-index: 3; pointer-events: none; line-height: 1; text-shadow: 0 0 6px var(--surface-1), 0 0 2px var(--surface-1); }
  :global(.map-year b) { display: block; font-size: 44px; font-weight: 800; letter-spacing: -0.02em; color: var(--text-primary); font-variant-numeric: tabular-nums; }
  :global(.map-year span) { display: block; margin-top: 4px; font-size: 13px; font-weight: 600; color: var(--text-secondary); }
  :global(.map-year.proj b) { color: var(--series-2); }
  .map-time {
    position: absolute; left: 50%; bottom: 34px; transform: translateX(-50%); z-index: 3;
    width: min(560px, calc(100% - 32px)); box-sizing: border-box;
    background: color-mix(in oklab, var(--surface-1) 92%, transparent); backdrop-filter: blur(6px);
    border: 1px solid var(--border, rgba(127, 127, 127, 0.3)); border-radius: 14px; padding: 10px 14px;
    box-shadow: 0 6px 22px rgba(0, 0, 0, 0.14); display: grid; gap: 8px;
  }
  .map-time .row1 { display: flex; align-items: center; gap: 12px; }
  .map-time .play { width: 36px; height: 36px; flex: none; border-radius: 50%; border: 0; background: var(--text-primary); color: var(--surface-1); font-size: 14px; cursor: pointer; }
  .map-time .track { flex: 1; position: relative; padding-bottom: 14px; }
  .map-time input[type="range"] { width: 100%; margin: 0; accent-color: var(--series-2); }
  :global(.map-time .ticks) { position: absolute; left: 0; right: 0; bottom: 0; height: 12px; font-size: 11px; color: var(--text-muted); }
  :global(.map-time .ticks span) { position: absolute; transform: translateX(-50%); white-space: nowrap; }
  :global(.map-time .ticks span.proj) { color: var(--series-2); font-weight: 600; }
  :global(.map-time .scen) { display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: center; font-size: 12px; color: var(--text-secondary); }
  :global(.map-time .scen .mp-chips button) { font-size: 12px; padding: 3px 9px; }
  :global(.mp-spark) { width: 100%; height: auto; display: block; margin: 6px 0 4px; overflow: visible; }
  :global(.mp-spark text) { font-size: 10px; fill: var(--text-muted); }
  .map-arcs { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 2; }
  .map-flow { display: grid; gap: 12px; }
  :global(.map-flow h3) { margin: 0; font-size: 16px; }
  :global(.map-flow h4) { margin: 0 0 6px; font-size: 13px; color: var(--text-secondary); font-weight: 600; display: flex; align-items: center; gap: 6px; }
  :global(.map-flow h4 i) { width: 14px; height: 3px; border-radius: 2px; display: inline-block; }
  :global(.map-flow .sum) { margin: 0; font-size: 14px; line-height: 1.6; }
  :global(.map-flow .flow-row) { display: grid; grid-template-columns: 1fr 70px 52px; gap: 8px; align-items: center; font-size: 13px; padding: 2px 4px; border-radius: 6px; cursor: pointer; }
  :global(.map-flow .flow-row:hover) { background: var(--surface-2); }
  :global(.map-flow .flow-row .bar) { height: 6px; border-radius: 3px; }
  :global(.map-flow .flow-row .v) { text-align: right; font-variant-numeric: tabular-nums; color: var(--text-secondary); }
  :global(.map-flow label.toggle) { display: flex; gap: 8px; align-items: center; font-size: 13px; color: var(--text-secondary); cursor: pointer; }
  :global(.map-flow .hint) { margin: 0; font-size: 13px; color: var(--text-muted); }
  @media (max-width: 760px) {
    .map-year { top: 8px; left: 10px; }
    :global(.map-year b) { font-size: 30px; }
    .map-time { bottom: 30px; padding: 8px 10px; }
    .map-page { grid-template-columns: 1fr; grid-template-rows: none; height: auto; }
    .map-side { order: 2; border-right: 0; max-height: none; }
    .map-wrap { order: 1; height: 62vh; }
  }
</style>

<script>
  import { fmt, int } from "../../lib/format";

  async function main() {

  type Bin = { color: string; label: string; lo: number | null; hi: number | null };
  type Metric = { key: string; label: string; format: any; desc: string; values: Record<string, number | null>; bins: Bin[] };
  const D = JSON.parse(document.getElementById("mp-data")!.textContent || "{}");
  const groups = D.groups as { title: string; src: string; metrics: Metric[] }[];
  const all: Metric[] = groups.flatMap((g) => g.metrics);
  const byKey = Object.fromEntries(all.map((m) => [m.key, m]));
  const groupOf = Object.fromEntries(groups.flatMap((g) => g.metrics.map((m) => [m.key, g])));
  let cur: Metric = byKey[new URLSearchParams(location.search).get("m") ?? ""] ?? byKey["youthRate"] ?? all[0];
  let selected: string | null = new URLSearchParams(location.search).get("r");
  const FLOW_G: Record<string, string> = { rate: "all", kidsRate: "kids", youthRate: "youth", midRate: "mid", preRate: "pre", oldRate: "old" };
  const isFlow = () => FLOW_G[cur.key] != null;
  let F: { ids: string[]; groups: string[]; rows: number[][]; net?: Record<string, number[]> } | null = null; // 지금 기간의 이사 흐름

  // CSS 색(var·color-mix 포함) → rgb: 지도 엔진은 CSS 변수를 모른다
  const probe = document.createElement("span");
  probe.style.display = "none";
  document.body.appendChild(probe);
  const ctx = document.createElement("canvas").getContext("2d", { willReadFrequently: true })!;
  const resolve = (c: string) => {
    probe.style.color = "";
    probe.style.color = c;
    const s = getComputedStyle(probe).color;
    ctx.clearRect(0, 0, 1, 1);
    ctx.fillStyle = "#000";
    ctx.fillStyle = s;
    ctx.fillRect(0, 0, 1, 1);
    const [r, g, b] = ctx.getImageData(0, 0, 1, 1).data;
    return `rgb(${r},${g},${b})`;
  };
  const isDark = () => {
    const t = document.documentElement.dataset.theme;
    return t ? t === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
  };
  const NODATA = "color-mix(in oklab, var(--text-muted) 22%, var(--surface-1))";
  const SIDO_LINE = "color-mix(in oklab, var(--text-primary) 45%, var(--surface-1))";
  const binIdx = (bins: Bin[], v: number | null | undefined) => {
    if (v == null || !isFinite(v)) return -1;
    for (let i = 0; i < bins.length; i++) {
      const b = bins[i];
      if ((b.lo == null || v >= b.lo) && (b.hi == null || v < b.hi)) return i;
    }
    return bins.length - 1;
  };
  const show = (m: Metric, v: number | null | undefined) => (v == null ? "자료 없음" : fmt(v, m.format));

  // ---- 사이드 패널
  const groupsEl = document.getElementById("mp-groups")!;
  for (const g of groups) {
    const box = document.createElement("div");
    box.className = "mp-group";
    box.innerHTML = `<h3>${g.title} <span class="mp-src">· ${g.src}</span></h3>`;
    const chips = document.createElement("div");
    chips.className = "mp-chips";
    for (const m of g.metrics) {
      const b = document.createElement("button");
      b.type = "button";
      b.textContent = m.label;
      b.dataset.key = m.key;
      b.addEventListener("click", () => setMetric(m.key));
      chips.appendChild(b);
    }
    box.appendChild(chips);
    groupsEl.appendChild(box);
  }
  const legendEl = document.getElementById("mp-legend")!;
  const descEl = document.getElementById("mp-desc")!;
  const detailEl = document.getElementById("mp-detail")!;
  const tip = document.getElementById("mp-tip")!;
  const flowEl = document.getElementById("mp-flow")!;
  groupsEl.firstElementChild?.after(flowEl); // 흐름 패널은 나이 버튼 바로 아래
  document.querySelector(".map-search")!.after(detailEl); // 고른 지역의 추이는 맨 위에

  const renderLegend = () => {
    legendEl.innerHTML = `<div class="title">${cur.label}</div>`;
    const rows = [...cur.bins].reverse().map((b) => ({ c: resolve(b.color), l: b.label }));
    rows.push({ c: resolve(NODATA), l: "자료 없음" });
    for (const r of rows) {
      const row = document.createElement("div");
      row.className = "row";
      row.innerHTML = `<i style="background:${r.c}"></i><span>${r.l}</span>`;
      legendEl.appendChild(row);
    }
    descEl.textContent = cur.desc;
    for (const b of groupsEl.querySelectorAll("button")) b.setAttribute("aria-pressed", String((b as HTMLElement).dataset.key === cur.key));
  };

  const renderDetail = (id: string | null) => {
    if (isFlow()) { detailEl.hidden = true; renderFlow(id); return; }
    flowEl.hidden = true;
    if (!id) { detailEl.hidden = true; return; }
    const r = D.regions[id];
    const cell = (m: any) => {
      const v = valOf(m, id);
      return `${show(m, v)}${m.time ? ` <span class="small muted">${m.yearLabels?.[yearOf(m)] ?? yearOf(m)}</span>` : ""}`;
    };
    const rows = groups.filter((g) => !g.metrics.some((m) => FLOW_G[m.key])).map((g) =>
      `<tr><td colspan="2" class="small muted" style="padding-top:8px">${g.title}</td></tr>` +
      g.metrics.map((m) => `<tr class="${m.key === cur.key ? "on" : ""}"><td>${m.label}</td><td class="num">${cell(m)}</td></tr>`).join(""),
    ).join("");
    const title = cur.level === "sido" ? `${D.sidoNames[id.slice(0, 2)]} <span class="small muted">(시도 지표)</span>` : r.n;
    detailEl.innerHTML = `<h3>${title}</h3>${cur.time ? sparkHtml(cur, id) : ""}<p class="small muted" style="margin:0 0 6px">인구 ${int(r.pop)}명 · ${r.n}</p><table>${rows}</table>
      <div class="links"><a href="${D.base}dongne/${id}/">동네 전망 →</a><a href="${D.base}housing/#sgg">집값 →</a><a href="${D.base}move/#map">이사 →</a></div>`;
    detailEl.hidden = false;
  };

  // 지역의 연도별 추이: 실적 실선, 추계 점선, 시나리오 범위는 띠, 지금 보는 연도는 점
  const sparkHtml = (m: any, id: string) => {
    const W = 280, H = 96, L = 4, Rr = 40, T = 10, B = 18;
    const main = seriesOf(m, id, scenKey(m));
    const keys = allScenKeys(m);
    const others = keys.length > 1 ? keys.map((k) => seriesOf(m, id, k)) : [];
    const ys = [...main, ...others.flat()].map((p) => p[1]).filter((v): v is number => v != null);
    if (!ys.length) return "";
    let lo = Math.min(...ys), hi = Math.max(...ys);
    if (hi - lo < 1e-9) { lo -= 1; hi += 1; }
    const pad = (hi - lo) * 0.08; lo -= pad; hi += pad;
    const y0 = m.years[0], y1 = m.years[m.years.length - 1];
    const X = (y: number) => L + ((y - y0) / (y1 - y0 || 1)) * (W - L - Rr);
    const Y = (v: number) => T + (1 - (v - lo) / (hi - lo)) * (H - T - B);
    const path = (pts: [number, number | null][]) => pts.filter((p) => p[1] != null).map((p, i) => `${i ? "L" : "M"}${X(p[0]).toFixed(1)},${Y(p[1]!).toFixed(1)}`).join("");
    const past = main.filter((p) => p[0] < m.projFrom), fut = main.filter((p) => p[0] >= m.projFrom - 1 && p[0] >= (past.length ? past[past.length - 1][0] : 0));
    let band = "";
    if (others.length) {
      const fy = m.years.filter((y: number) => y >= m.projFrom);
      const mins = fy.map((y: number) => Math.min(...others.map((s) => s.find((p) => p[0] === y)?.[1] ?? Infinity)));
      const maxs = fy.map((y: number) => Math.max(...others.map((s) => s.find((p) => p[0] === y)?.[1] ?? -Infinity)));
      if (fy.length && isFinite(mins[0])) {
        const lastPast = past[past.length - 1];
        const top = fy.map((y: number, i: number) => `${X(y).toFixed(1)},${Y(maxs[i]).toFixed(1)}`);
        const bot = fy.map((y: number, i: number) => `${X(y).toFixed(1)},${Y(mins[i]).toFixed(1)}`).reverse();
        const start = lastPast?.[1] != null ? [`${X(lastPast[0]).toFixed(1)},${Y(lastPast[1]).toFixed(1)}`] : [];
        band = `<polygon points="${[...start, ...top, ...bot].join(" ")}" fill="${resolve("var(--series-2)")}" opacity="0.15"/>`;
      }
    }
    const cy = yearOf(m), cv = main.find((p) => p[0] === cy)?.[1];
    const c1 = resolve("var(--text-primary)"), c2 = resolve("var(--series-2)");
    const last = main[main.length - 1];
    return `<svg class="mp-spark" viewBox="0 0 ${W} ${H}" role="img" aria-label="${m.label} 연도별 추이">
      ${band}
      ${m.projFrom <= y1 ? `<line x1="${X(m.projFrom - 0.5)}" x2="${X(m.projFrom - 0.5)}" y1="${T}" y2="${H - B}" stroke="${c1}" stroke-opacity="0.15"/>` : ""}
      <path d="${path(past)}" fill="none" stroke="${c1}" stroke-width="2"/>
      <path d="${path(fut)}" fill="none" stroke="${c2}" stroke-width="2" stroke-dasharray="4 3"/>
      ${cv != null ? `<circle cx="${X(cy)}" cy="${Y(cv)}" r="4.5" fill="${cy >= m.projFrom ? c2 : c1}" stroke="${resolve("var(--surface-1)")}" stroke-width="2"/>` : ""}
      ${last[1] != null ? `<text x="${X(last[0]) + 6}" y="${Y(last[1]) + 3}">${show(m, last[1])}</text>` : ""}
      <text x="${L}" y="${H - 4}">${y0}</text>${m.projFrom <= y1 ? `<text x="${X(m.projFrom)}" y="${H - 4}" text-anchor="middle" fill="${c2}">추계→</text>` : ""}<text x="${W - Rr}" y="${H - 4}" text-anchor="end">${m.yearLabels?.[y1] ?? y1}</text>
    </svg>
    <p class="small" style="margin:0 0 4px"><strong>${m.yearLabels?.[cy] ?? `${cy}년`} ${show(m, cv)}</strong>${others.length ? ` · 띠는 시나리오 범위` : ""}</p>`;
  };

  // ---- 지도
  const loadCss = (href: string) => new Promise<void>((ok) => {
    const l = document.createElement("link");
    l.rel = "stylesheet"; l.href = href; l.onload = () => ok(); l.onerror = () => ok();
    document.head.appendChild(l);
  });
  const loadJs = (src: string) => new Promise<void>((ok, no) => {
    const s = document.createElement("script");
    s.src = src; s.onload = () => ok(); s.onerror = () => no(new Error(src));
    document.head.appendChild(s);
  });
  const ML = "https://cdn.jsdelivr.net/npm/maplibre-gl@5.24.0/dist/";
  await Promise.all([loadCss(ML + "maplibre-gl.css"), loadJs(ML + "maplibre-gl.js")]);
  const maplibregl = (window as any).maplibregl;

  // 바탕 지도: OpenFreeMap 벡터 타일(OSM). 색칠을 물·도로·이름 아래에 끼워 넣을 수 있다
  const STYLE_URL = { light: "https://tiles.openfreemap.org/styles/positron", dark: "https://tiles.openfreemap.org/styles/dark" };
  const ATTR = '경계 통계청 SGIS, <a href="https://github.com/vuski/admdongkor" target="_blank" rel="noopener">vuski/admdongkor</a> (CC BY 4.0)' + (D.key ? ' · 검색 <a href="https://www.vworld.kr" target="_blank" rel="noopener">브이월드</a>' : "");
  const KO = ["coalesce", ["get", "name:ko"], ["get", "name"]];
  const styleCache: Record<string, any> = {};
  const [geo, sidoGeo, FR] = await Promise.all([fetch(D.geo).then((r) => r.json()), fetch(D.geoSido).then((r) => r.json()), fetch(D.frames).then((r) => r.json())]);

  // ---- 연도·시나리오: 시간 지표는 (연도, 시나리오)마다 값이 다르다
  const yearSel: Record<string, number> = {};
  const scenSel: Record<string, string> = {};
  const scenKey = (m: any) => (m.scen?.length ? m.scen.map((d: any) => scenSel[d.id] ?? d.def).join("|") : "_");
  const yearOf = (m: any) => yearSel[m.key] ?? m.start;
  const rowOf = (m: any, y: number, sk = scenKey(m)) => {
    const f = FR.metrics[m.key];
    if (y < m.projFrom) return f.actual[m.years.filter((x: number) => x < m.projFrom).indexOf(y)];
    return f.proj[sk]?.[m.years.filter((x: number) => x >= m.projFrom).indexOf(y)];
  };
  const vcache = new Map<string, Record<string, number | null>>();
  const vals = (m: any): Record<string, number | null> => {
    if (FLOW_G[m.key] && F && (F as any).net) {
      const k = `${m.key}:flow:${flowWin}`;
      let v = vcache.get(k);
      if (!v) {
        const gix = GROUPS.indexOf(FLOW_G[m.key]);
        v = Object.fromEntries(Object.keys(D.regions).map((id) => { const n = (F as any).net[id]?.[gix]; return [id, n == null ? 0 : Math.round((n / D.regions[id].pop) * 10000) / 10]; }));
        vcache.set(k, v);
      }
      return v;
    }
    if (!m.time) return m.values;
    const k = `${m.key}:${yearOf(m)}:${scenKey(m)}`;
    let v = vcache.get(k);
    if (!v) {
      const ids: string[] = m.level === "sido" ? FR.sido : FR.sgg, row = rowOf(m, yearOf(m)) ?? [];
      v = Object.fromEntries(ids.map((id, i) => [id, row[i] ?? null]));
      vcache.set(k, v);
    }
    return v;
  };
  /** 시군구 id 기준 값 (시도 지표는 그 시도의 값) */
  const valOf = (m: any, id: string) => (m.level === "sido" ? vals(m)[id.slice(0, 2)] : vals(m)[id]);
  /** 한 지역의 연도별 값: [연도, 값][] (시나리오 키 지정) */
  const seriesOf = (m: any, id: string, sk: string) => {
    const ids: string[] = m.level === "sido" ? FR.sido : FR.sgg, i = ids.indexOf(m.level === "sido" ? id.slice(0, 2) : id);
    return m.years.map((y: number) => [y, rowOf(m, y, sk)?.[i] ?? null] as [number, number | null]);
  };
  const allScenKeys = (m: any): string[] => (m.scen?.length ? m.scen.reduce((acc: string[], d: any) => acc.flatMap((a) => d.options.map((o: any) => (a ? `${a}|${o.v}` : o.v))), [""]) : ["_"]);
  const lineColor = () => (isDark() ? "rgba(0,0,0,0.55)" : "rgba(255,255,255,0.9)");

  const fillOpacity = () => (isFlow()
    ? ["interpolate", ["linear"], ["zoom"], 7, 0.55, 10, 0.45, 12, 0.32, 14, 0.22]
    : ["interpolate", ["linear"], ["zoom"], 7, 0.9, 10, 0.72, 12, 0.5, 14, 0.35]);
  const fillColor = () => {
    const expr: any[] = ["match", ["get", "id"]];
    const colors = cur.bins.map((b) => resolve(b.color));
    const none = resolve(NODATA);
    for (const id of Object.keys(D.regions)) {
      const i = binIdx(cur.bins, valOf(cur, id));
      expr.push(id, i < 0 ? none : colors[i]);
    }
    expr.push(none);
    return expr;
  };

  async function buildStyle() {
    const theme = isDark() ? "dark" : "light";
    styleCache[theme] ??= await fetch(STYLE_URL[theme]).then((r) => r.json());
    const st = structuredClone(styleCache[theme]);
    const ROAD_FROM = 8, ROAD_FULL = 10; // 멀리서 볼 때 도로는 지표를 가리기만 한다
    const textColor = resolve("var(--text-primary)"), halo = resolve("var(--surface-1)");
    st.layers = st.layers.filter((l: any) => l["source-layer"] !== "boundary" && !/country|state/.test(l.id)); // 행정경계·국가·도 이름은 우리 선으로
    for (const l of st.layers) {
      const sl = l["source-layer"];
      if (l.type === "symbol" && l.layout?.["text-field"]) {
        l.layout["text-field"] = KO; // 한국어 이름 우선
        l.paint = { ...l.paint, "text-color": textColor, "text-halo-color": halo, "text-halo-width": 1.6, "text-halo-blur": 0.3 };
      }
      if (sl === "transportation" || sl === "aeroway") {
        if (l.type === "line") l.paint = { ...l.paint, "line-opacity": ["interpolate", ["linear"], ["zoom"], ROAD_FROM, 0, ROAD_FULL, theme === "dark" ? 0.35 : 1] };
        if (l.type === "fill") l.paint = { ...l.paint, "fill-opacity": ["interpolate", ["linear"], ["zoom"], ROAD_FROM, 0, ROAD_FULL, 1] };
      }
      if (sl === "transportation_name") l.minzoom = Math.max(l.minzoom ?? 0, ROAD_FULL);
    }
    st.sources.sgg = { type: "geojson", data: geo, promoteId: "id", attribution: ATTR };
    st.sources.sido = { type: "geojson", data: sidoGeo };
    const fill = { id: "sgg-fill", type: "fill", source: "sgg", paint: {
      "fill-color": fillColor(),
      "fill-opacity": fillOpacity(),
    } };
    const line = { id: "sgg-line", type: "line", source: "sgg", paint: {
      "line-color": lineColor(),
      "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.3, 10, 1.1, 14, 2],
    } };
    const sidoLine = { id: "sido-line", type: "line", source: "sido", paint: {
      "line-color": resolve(SIDO_LINE),
      "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.8, 10, 1.8],
    } };
    const hl = { id: "sgg-hl", type: "line", source: "sgg", paint: {
      "line-color": resolve("var(--text-primary)"),
      "line-width": ["case", ["boolean", ["feature-state", "sel"], false], 2.6, ["boolean", ["feature-state", "hover"], false], 1.6, 0],
    } };
    // 순서: 배경·녹지 → 색칠 → 물(강이 보이게) → 건물·도로 → 경계선 → 이름
    const at = (pred: (l: any) => boolean) => { const i = st.layers.findIndex(pred); return i < 0 ? st.layers.length : i; };
    st.layers.splice(at((l: any) => l["source-layer"] === "water"), 0, fill);
    st.layers.splice(at((l: any) => l.type === "symbol"), 0, line, sidoLine, hl);
    return st;
  }

  const map = new maplibregl.Map({
    container: "mp-map",
    style: await buildStyle(),
    center: [127.75, 36.1],
    zoom: 6.2,
    minZoom: 5.5,
    maxZoom: 17,
    maxBounds: [[121.5, 32.0], [133.5, 39.8]],
    attributionControl: { compact: true },
    localIdeographFontFamily: "'Pretendard Variable', Pretendard, 'Apple SD Gothic Neo', 'Malgun Gothic', 'Noto Sans KR', sans-serif",
    dragRotate: false,
    pitchWithRotate: false,
  });
  map.touchZoomRotate.disableRotation();
  (window as any).__map = map; // 디버깅·자동 점검용
  map.addControl(new maplibregl.NavigationControl({ showCompass: false }), "top-right");

  const paint = () => {
    if (!map.getLayer("sgg-fill")) return;
    map.setPaintProperty("sgg-fill", "fill-color", fillColor());
    map.setPaintProperty("sgg-fill", "fill-opacity", fillOpacity());
    map.setPaintProperty("sgg-line", "line-opacity", cur.level === "sido" ? 0 : 1);
    map.setPaintProperty("sido-line", "line-width", cur.level === "sido" ? ["interpolate", ["linear"], ["zoom"], 6, 1.4, 10, 2.4] : ["interpolate", ["linear"], ["zoom"], 6, 0.8, 10, 1.8]);
  };

  function setMetric(key: string) {
    stopPlay();
    cur = byKey[key];
    const u = new URL(location.href);
    u.searchParams.set("m", key);
    history.replaceState(null, "", u);
    renderLegend();
    paint();
    renderDetail(selected);
    renderTime();
    updateArcs();
  }

  // 선택: 지도 클릭·검색·목록 클릭이 모두 여기로
  function select(id: string | null, fit = false) {
    if (id && !D.regions[id]) id = null;
    setState(selected, "sel", false);
    selected = id;
    setState(selected, "sel", true);
    const u = new URL(location.href);
    if (id) u.searchParams.set("r", id); else u.searchParams.delete("r");
    history.replaceState(null, "", u);
    renderDetail(id);
    updateArcs().then(() => fit && id && fitArcs());
  }
  // 고른 지역의 흐름이 화면에 다 들어오게 (화면 밖으로 나가는 선이 있거나 너무 작을 때만)
  function fitArcs() {
    if (!arcs.length) return;
    const pts = arcs.flatMap((a) => [P[a.s], P[a.t]]).filter(Boolean);
    const xs = pts.map((p) => p[0]), ys = pts.map((p) => p[1]);
    const b: [[number, number], [number, number]] = [[Math.min(...xs), Math.min(...ys)], [Math.max(...xs), Math.max(...ys)]];
    const v = map.getBounds();
    const inside = b[0][0] >= v.getWest() && b[1][0] <= v.getEast() && b[0][1] >= v.getSouth() && b[1][1] <= v.getNorth();
    const small = (b[1][0] - b[0][0]) < (v.getEast() - v.getWest()) * 0.25 && (b[1][1] - b[0][1]) < (v.getNorth() - v.getSouth()) * 0.25;
    if (!inside || small) map.fitBounds(b, { padding: 70, maxZoom: 10.5, duration: 900 });
  }

  let hover: string | null = null;
  const setState = (id: string | null, k: string, v: boolean) => id && map.getSource("sgg") && map.setFeatureState({ source: "sgg", id }, { [k]: v });
  map.on("mousemove", "sgg-fill", (e: any) => {
    const id = e.features?.[0]?.properties?.id as string;
    if (hover !== id) { setState(hover, "hover", false); hover = id; setState(hover, "hover", true); }
    map.getCanvas().style.cursor = "pointer";
    tip.innerHTML = tipHtml(id);
    tip.hidden = false;
    const { x, y } = e.point;
    const w = map.getContainer().clientWidth;
    tip.style.left = `${Math.min(x + 14, w - tip.offsetWidth - 8)}px`;
    tip.style.top = `${y + 14}px`;
  });
  map.on("mouseleave", "sgg-fill", () => {
    setState(hover, "hover", false);
    hover = null;
    tip.hidden = true;
    map.getCanvas().style.cursor = "";
  });
  map.once("idle", () => { if (selected) { setState(selected, "sel", true); renderDetail(selected); } updateArcs(); });
  map.on("click", (e: any) => {
    const f = map.queryRenderedFeatures(e.point, { layers: ["sgg-fill"] })[0];
    const id = (f?.properties?.id as string) ?? null;
    select(id === selected ? null : id, true);
  });


  // ---- 이사 흐름: 시군구 쌍 집계(12개월)를 캔버스에 곡선과 움직이는 점으로
  const fmtN = (v: number) => int(Math.round(v));
  const G_LABEL: Record<string, string> = { all: "전체", kids: "0~14세", youth: "20~34세", mid: "35~49세", pre: "50~64세", old: "65세 이상" };
  let P: Record<string, [number, number]> = {};
  let natLevel: "sido" | "sgg" = "sido";
  let SP: Record<string, [number, number]> = {}; // 시도 중심 (시군구 중심의 인구 가중 평균)
  const FW = D.flowWindows as { key: string; label: string; url: string; periodLabel: string }[];
  let flowWin = FW.length - 1; // 최근 1년
  const flowCache: Record<number, Promise<any>> = {};
  const loadWin = (i: number) => (flowCache[i] ??= fetch(FW[i].url).then((r) => r.json()));
  let ptsLoading: Promise<void> | null = null;
  const loadFlows = async () => {
    const [f] = await Promise.all([loadWin(flowWin), loadPts()]);
    F = f;
    for (const j of [flowWin - 1, flowWin + 1]) if (FW[j]) loadWin(j); // 재생할 때 끊기지 않게 이웃 기간을 미리
  };
  const loadPts = () => (ptsLoading ??= (async () => {
    const pts = await fetch(D.geoPts).then((r) => r.json());
    P = Object.fromEntries(pts.features.map((x: any) => [x.properties.id, x.geometry.coordinates]));
    const acc: Record<string, [number, number, number]> = {};
    for (const [id, c] of Object.entries(P)) {
      const w = D.regions[id]?.pop ?? 1, a = (acc[id.slice(0, 2)] ??= [0, 0, 0]);
      a[0] += c[0] * w; a[1] += c[1] * w; a[2] += w;
    }
    SP = Object.fromEntries(Object.entries(acc).map(([k, a]) => [k, [a[0] / a[2], a[1] / a[2]]]));
  })());
  const GROUPS = ["all", "kids", "youth", "mid", "pre", "old"];
  const flowNet = (id: string) => (F as any)?.net?.[id]?.[GROUPS.indexOf(FLOW_G[cur.key])] ?? D.moveNet[id]?.[FLOW_G[cur.key]] ?? 0;
  const gi = () => (F ? F.groups.indexOf(FLOW_G[cur.key]) + 2 : 2);
  type Arc = { s: string; t: string; n: number; kind: "in" | "out" | "net"; back?: number };
  let arcs: Arc[] = [];

  const partners = (id: string) => {
    const g = gi();
    const ins: [string, number][] = [], outs: [string, number][] = [];
    for (const r of F!.rows) {
      const v = r[g];
      if (!v) continue;
      if (F!.ids[r[1]] === id) ins.push([F!.ids[r[0]], v]);
      else if (F!.ids[r[0]] === id) outs.push([F!.ids[r[1]], v]);
    }
    ins.sort((a, b) => b[1] - a[1]);
    outs.sort((a, b) => b[1] - a[1]);
    return { ins, outs };
  };
  const pairValue = (a: string, b: string) => {
    if (!F) return [0, 0];
    const g = gi(), ia = F.ids.indexOf(a), ib = F.ids.indexOf(b);
    let ab = 0, ba = 0;
    for (const r of F.rows) {
      if (r[0] === ia && r[1] === ib) ab = r[g];
      else if (r[0] === ib && r[1] === ia) ba = r[g];
    }
    return [ab, ba];
  };
  const nationalArcs = (): Arc[] => {
    const g = gi(), pair = new Map<string, number>();
    for (const r of F!.rows) {
      let s = F!.ids[r[0]], t = F!.ids[r[1]];
      if (s.slice(0, 2) === t.slice(0, 2)) continue; // 전국 화면은 시도를 넘는 이동만
      if (natLevel === "sido") { s = s.slice(0, 2); t = t.slice(0, 2); }
      const k = `${s}>${t}`;
      pair.set(k, (pair.get(k) ?? 0) + r[g]);
    }
    const out: Arc[] = [];
    for (const [k, v] of pair) {
      const [s, t] = k.split(">");
      const back = pair.get(`${t}>${s}`) ?? 0;
      if (v > back) out.push({ s, t, n: v - back, back, kind: "net" });
    }
    return out.sort((a, b) => b.n - a.n).slice(0, natLevel === "sido" ? 30 : 45);
  };

  async function updateArcs() {
    if (!isFlow()) { arcs = []; return; }
    await loadFlows();
    if (!isFlow()) { arcs = []; return; }
    if (selected) {
      const { ins, outs } = partners(selected);
      arcs = [
        ...ins.slice(0, 12).map(([s, n]) => ({ s, t: selected!, n, kind: "in" as const })),
        ...outs.slice(0, 12).map(([t, n]) => ({ s: selected!, t, n, kind: "out" as const })),
      ];
    } else arcs = nationalArcs();
    renderFlow(selected);
  }

  function renderFlow(id: string | null) {
    flowEl.hidden = false;
    if (!F) { flowEl.innerHTML = `<p class="hint">이동 자료를 불러오는 중…</p>`; return; }
    const g = FLOW_G[cur.key], gl = G_LABEL[g];
    const cIn = resolve(IN_C), cOut = resolve(OUT_C);
    const list = (rows: [string, number][], color: string) => {
      const max = Math.max(...rows.map((r) => r[1]), 1);
      return rows.map(([pid, v]) => `<div class="flow-row" data-id="${pid}"><span>${D.regions[pid]?.n ?? pid}</span><span class="bar" style="width:${Math.max(4, (v / max) * 100)}%;background:${color}"></span><span class="v">${fmtN(v)}</span></div>`).join("");
    };
    if (!id) {
      const top = arcs.slice(0, 8);
      flowEl.innerHTML = `
        <p class="sum"><strong>${gl}</strong>이 가장 많이 옮겨 간 길입니다. 두 지역이 주고받은 인원을 서로 빼고, 남은 쪽으로 흐릅니다. 지도에서 시군구를 누르면 그곳에 누가 어디서 오고 어디로 가는지 보입니다.</p>
        <div class="mp-chips" role="group" aria-label="단위"><button type="button" data-lv="sido" aria-pressed="${natLevel === "sido"}">시도끼리</button><button type="button" data-lv="sgg" aria-pressed="${natLevel === "sgg"}">시군구끼리</button></div>
        <div><h4><i style="background:${cIn}"></i>시도를 넘는 순이동이 큰 길 (${FW[flowWin].periodLabel}, 명)</h4>
        ${top.map((a) => `<div class="flow-row" data-id="${a.t.length === 2 ? "" : a.t}"><span>${nm(a.s)} → ${nm(a.t).split(" ").pop()}</span><span class="bar" style="width:${Math.max(4, (a.n / top[0].n) * 100)}%;background:${cIn}"></span><span class="v">${fmtN(a.n)}</span></div>`).join("")}</div>`;
    } else {
      const { ins, outs } = partners(id);
      const net = flowNet(id);
      const rate = valOf(cur, id);
      flowEl.innerHTML = `
        <h3>${D.regions[id].n}</h3>
        <p class="sum">${gl} 순이동 <strong>${net > 0 ? "+" : ""}${fmtN(net)}명</strong>${rate != null ? ` (인구 1천 명당 ${rate > 0 ? "+" : ""}${rate.toFixed(1)})` : ""} · ${FW[flowWin].periodLabel}</p>
        <div><h4><i style="background:${cIn}"></i>어디서 왔나</h4>${list(ins.slice(0, 8), cIn)}</div>
        <div><h4><i style="background:${cOut}"></i>어디로 갔나</h4>${list(outs.slice(0, 8), cOut)}</div>
        <p class="hint">빈 곳을 누르면 전국 흐름으로 돌아갑니다. <a href="${D.base}dongne/${id}/">동네 전망 →</a></p>`;
    }
    flowEl.querySelectorAll<HTMLElement>(".flow-row").forEach((el) => el.dataset.id && el.addEventListener("click", () => select(el.dataset.id!, true)));
    flowEl.querySelectorAll<HTMLElement>("[data-lv]").forEach((el) => el.addEventListener("click", () => { natLevel = el.dataset.lv as any; updateArcs(); }));
  }

  const nm = (id: string) => (id.length === 2 ? D.sidoNames[id] : D.regions[id]?.n ?? id);
  const tipHtml = (id: string) => {
    const head = `<b>${D.regions[id].n}</b>`;
    if (isFlow() && selected && id !== selected && F) {
      const [ab, ba] = pairValue(selected, id);
      const sn = D.regions[selected].n.split(" ").pop();
      return `${head}${sn}에서 옴 ${fmtN(ba)}명 · ${sn}로 감 ${fmtN(ab)}명 <span style="opacity:.7">(${G_LABEL[FLOW_G[cur.key]]})</span>`;
    }
    if (isFlow()) {
      const g = FLOW_G[cur.key], net = flowNet(id), v = valOf(cur, id);
      return `${head}${G_LABEL[g]} 순이동 ${net > 0 ? "+" : ""}${fmtN(net)}명${v != null ? ` <span style="opacity:.7">(1천 명당 ${v > 0 ? "+" : ""}${v.toFixed(1)})</span>` : ""}`;
    }
    if (cur.level === "sido") return `<b>${D.sidoNames[id.slice(0, 2)]}</b>${cur.label} ${show(cur, valOf(cur, id))}${cur.time ? ` <span style="opacity:.7">${cur.yearLabels?.[yearOf(cur)] ?? yearOf(cur)}</span>` : ""}`;
    return `${head}${cur.label} ${show(cur, valOf(cur, id))}${cur.time ? ` <span style="opacity:.7">${cur.yearLabels?.[yearOf(cur)] ?? yearOf(cur)}</span>` : ""}`;
  };

  const IN_C = "var(--series-1)";
  const OUT_C = "var(--series-2)";
  const canvas = document.getElementById("mp-arcs") as HTMLCanvasElement;
  const cx = canvas.getContext("2d")!;
  const sizeCanvas = () => {
    const r = canvas.getBoundingClientRect(), dpr = devicePixelRatio || 1;
    canvas.width = Math.round(r.width * dpr);
    canvas.height = Math.round(r.height * dpr);
    cx.setTransform(dpr, 0, 0, dpr, 0, 0);
  };
  new ResizeObserver(sizeCanvas).observe(canvas);
  sizeCanvas();
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const rgba = (rgb: string, a: number) => rgb.replace("rgb(", "rgba(").replace(")", `,${a})`);
  let colors = { in: "", out: "", halo: "" };
  const recolor = () => { colors = { in: resolve(IN_C), out: resolve(OUT_C), halo: resolve("var(--surface-1)") }; };
  recolor();
  const frame = (now: number) => {
    const w = canvas.clientWidth, h = canvas.clientHeight;
    cx.clearRect(0, 0, w, h);
    if (arcs.length) {
      const max = Math.max(...arcs.map((a) => a.n));
      const sec = now / 1000;
      for (const a of arcs) {
        const A = a.s.length === 2 ? SP[a.s] : P[a.s], B = a.t.length === 2 ? SP[a.t] : P[a.t];
        if (!A || !B) continue;
        const p0 = map.project(A), p1 = map.project(B);
        const dx = p1.x - p0.x, dy = p1.y - p0.y, d = Math.hypot(dx, dy);
        if (d < 3) continue;
        const bend = Math.min(0.3, 0.18 + 40 / (d + 80));
        const c = { x: (p0.x + p1.x) / 2 - dy * bend, y: (p0.y + p1.y) / 2 + dx * bend };
        const wgt = 1 + 7 * Math.sqrt(a.n / max);
        const col = a.kind === "out" ? colors.out : colors.in;
        cx.lineCap = "round";
        cx.beginPath(); cx.moveTo(p0.x, p0.y); cx.quadraticCurveTo(c.x, c.y, p1.x, p1.y);
        cx.strokeStyle = rgba(col, 0.28); cx.lineWidth = wgt; cx.stroke();
        // 혜성: 머리 점 + 곡선을 따라 옅어지는 꼬리. 굵은 길일수록 많이, 화면 거리와 상관없이 비슷한 속도로
        const k = reduce ? 0 : 1 + Math.round(wgt * 0.45);
        const dur = Math.max(1.6, d / 90);
        const at = (tt: number) => { const u = 1 - tt; return [u * u * p0.x + 2 * u * tt * c.x + tt * tt * p1.x, u * u * p0.y + 2 * u * tt * c.y + tt * tt * p1.y]; };
        const tailLen = Math.min(0.35, 60 / d);
        for (let j = 0; j < k; j++) {
          const t = (sec / dur + j / k + (a.s.charCodeAt(a.s.length - 1) % 7) / 7) % 1;
          const N = 10;
          for (let q = 0; q < N; q++) {
            const ta = Math.max(0, t - tailLen * (q + 1) / N), tb = Math.max(0, t - tailLen * q / N);
            if (tb <= 0) break;
            const [x0, y0] = at(ta), [x1, y1] = at(tb);
            cx.beginPath(); cx.moveTo(x0, y0); cx.lineTo(x1, y1);
            cx.strokeStyle = rgba(col, 0.85 * (1 - q / N)); cx.lineWidth = Math.max(1.2, wgt * 0.55) * (1 - q / N * 0.6); cx.stroke();
          }
          const [hx, hy] = at(t);
          cx.beginPath(); cx.arc(hx, hy, Math.max(1.6, wgt * 0.4), 0, Math.PI * 2);
          cx.fillStyle = col; cx.fill();
        }
      }
    }
    requestAnimationFrame(frame);
  };
  requestAnimationFrame(frame);


  // ---- 연도 슬라이더·재생·시나리오
  const timeEl = document.getElementById("mp-time")!;
  const yearEl = document.getElementById("mp-year")!;
  const rangeEl = document.getElementById("mp-range") as HTMLInputElement;
  const playEl = document.getElementById("mp-play") as HTMLButtonElement;
  const ticksEl = document.getElementById("mp-ticks")!;
  const scenEl = document.getElementById("mp-scen")!;
  let playTimer = 0;
  function stopPlay() { clearInterval(playTimer); playTimer = 0; playEl.textContent = "▶"; playEl.setAttribute("aria-label", "재생"); }
  const setYear = (y: number) => {
    yearSel[cur.key] = y;
    paint();
    renderTime();
    renderDetail(selected);
  };
  // 이사 흐름: 기간(연도별·최근 1년)을 슬라이더로
  const setFlowWin = async (i: number) => {
    flowWin = i;
    renderTime();
    await updateArcs();
    paint();
    renderDetail(selected);
  };
  function renderTime() {
    if (isFlow() && FW.length > 1) {
      timeEl.hidden = false; yearEl.hidden = false; scenEl.hidden = true; scenEl.innerHTML = "";
      rangeEl.max = String(FW.length - 1);
      rangeEl.value = String(flowWin);
      ticksEl.innerHTML = FW.map((w, k) => `<span style="left:${FW.length > 1 ? (k / (FW.length - 1)) * 100 : 0}%">${w.label}</span>`).join("");
      yearEl.classList.remove("proj");
      yearEl.querySelector("b")!.textContent = FW[flowWin].label;
      yearEl.querySelector("span")!.textContent = `이사 흐름 · ${G_LABEL[FLOW_G[cur.key]]} · ${FW[flowWin].periodLabel}`;
      return;
    }
    if (!cur.time) { timeEl.hidden = true; yearEl.hidden = true; return; }
    const ys: number[] = cur.years, y = yearOf(cur), i = ys.indexOf(y);
    timeEl.hidden = false; yearEl.hidden = false;
    rangeEl.max = String(ys.length - 1);
    rangeEl.value = String(i);
    const pf = ys.findIndex((x) => x >= cur.projFrom);
    const pct = (k: number) => (ys.length > 1 ? (k / (ys.length - 1)) * 100 : 0);
    rangeEl.style.background = "";
    const marks = [0, pf, ys.length - 1].filter((k, j, a) => k >= 0 && a.indexOf(k) === j);
    const yl = (yy: number) => cur.yearLabels?.[yy] ?? String(yy);
    ticksEl.innerHTML = marks.map((k) => `<span class="${k === pf ? "proj" : ""}" style="left:${pct(k)}%">${yl(ys[k])}${k === pf ? " 추계" : ""}</span>`).join("");
    const proj = y >= cur.projFrom;
    yearEl.classList.toggle("proj", proj);
    const scenTxt = cur.scen?.length ? cur.scen.map((d: any) => `${d.label} ${d.options.find((o: any) => o.v === (scenSel[d.id] ?? d.def))?.label}`).join(" · ") : "";
    yearEl.querySelector("b")!.textContent = yl(y);
    yearEl.querySelector("span")!.textContent = `${cur.label} · ${proj ? `추계${scenTxt ? ` (${scenTxt})` : ""}` : "실적"}`;
    scenEl.innerHTML = (cur.scen ?? []).map((d: any) => `<span>${d.label}</span><div class="mp-chips" role="group" aria-label="${d.label} 시나리오">${d.options.map((o: any) => `<button type="button" data-dim="${d.id}" data-v="${o.v}" aria-pressed="${(scenSel[d.id] ?? d.def) === o.v}">${o.label}</button>`).join("")}</div>`).join("");
    scenEl.hidden = !cur.scen?.length;
    scenEl.querySelectorAll<HTMLElement>("button[data-dim]").forEach((b) => b.addEventListener("click", () => {
      scenSel[b.dataset.dim!] = b.dataset.v!;
      paint(); renderTime(); renderDetail(selected);
    }));
  }
  rangeEl.addEventListener("input", () => { stopPlay(); if (isFlow()) setFlowWin(+rangeEl.value); else setYear(cur.years[+rangeEl.value]); });
  playEl.addEventListener("click", () => {
    if (playTimer) { stopPlay(); return; }
    if (isFlow()) {
      if (flowWin >= FW.length - 1) setFlowWin(0);
      playEl.textContent = "❚❚"; playEl.setAttribute("aria-label", "멈춤");
      playTimer = window.setInterval(() => {
        if (flowWin >= FW.length - 1) { stopPlay(); return; }
        setFlowWin(flowWin + 1);
      }, 2200);
      return;
    }
    const ys: number[] = cur.years;
    if (yearOf(cur) >= ys[ys.length - 1]) setYear(ys[0]);
    playEl.textContent = "❚❚"; playEl.setAttribute("aria-label", "멈춤");
    playTimer = window.setInterval(() => {
      const i = ys.indexOf(yearOf(cur));
      if (i >= ys.length - 1) { stopPlay(); return; }
      setYear(ys[i + 1]);
    }, ys.length > 12 ? 380 : 700);
  });
  renderTime();

  // 테마가 바뀌면 바탕 지도 스타일째 바꾼다 (선택 상태는 다시 칠한다)
  const retheme = async () => {
    map.setStyle(await buildStyle(), { diff: false });
    map.once("idle", () => setState(selected, "sel", true));
    recolor();
    renderLegend();
    renderDetail(selected);
  };
  new MutationObserver(retheme).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
  matchMedia("(prefers-color-scheme: dark)").addEventListener("change", retheme);

  renderLegend();

  // ---- 검색 (브이월드 검색 API, JSONP: 브라우저 직접 호출은 CORS가 막혀 있다)
  let cbn = 0;
  let seq = 0;
  const jsonp = (params: Record<string, string>) => new Promise<any>((ok) => {
    const cb = `__vw${++cbn}`;
    const s = document.createElement("script");
    const done = (v: any) => { delete (window as any)[cb]; s.remove(); ok(v); };
    (window as any)[cb] = (d: any) => done(d);
    const q = new URLSearchParams({ service: "search", request: "search", version: "2.0", format: "json", size: "5", key: D.key, domain: location.hostname, callback: cb, ...params });
    s.src = `https://api.vworld.kr/req/search?${q}`;
    s.onerror = () => done(null);
    document.head.appendChild(s);
    setTimeout(() => (window as any)[cb] && done(null), 6000);
  });
  const qEl = document.getElementById("mp-q") as HTMLInputElement;
  const resEl = document.getElementById("mp-results")!;
  type Hit = { t: string; s: string; x: number; y: number; z: number };
  let hits: Hit[] = [];
  let active = -1;
  const items = (d: any) => (d?.response?.status === "OK" ? d.response.result.items : []) as any[];
  const search = async (q: string) => {
    if (!D.key || q.trim().length < 2) { resEl.hidden = true; return; }
    const my = ++seq;
    const c = map.getCenter();
    const [dist, place, road] = await Promise.all([
      jsonp({ type: "district", category: "L4", query: q }),
      jsonp({ type: "place", query: q, bbox: `${c.lng - 1.5},${c.lat - 1.2},${c.lng + 1.5},${c.lat + 1.2}` }),
      /\d/.test(q) ? jsonp({ type: "address", category: "road", query: q }) : Promise.resolve(null),
    ]);
    if (my !== seq) return;
    hits = [
      ...items(dist).map((i) => ({ t: i.title, s: "행정구역", x: +i.point.x, y: +i.point.y, z: 13 })),
      ...items(road).map((i) => ({ t: i.address.road, s: i.address.bldnm || "도로명주소", x: +i.point.x, y: +i.point.y, z: 16 })),
      ...items(place).map((i) => ({ t: i.title, s: i.address?.road || i.address?.parcel || i.category || "", x: +i.point.x, y: +i.point.y, z: 16 })),
    ].slice(0, 10);
    active = -1;
    resEl.innerHTML = hits.length ? "" : `<li aria-disabled="true">결과가 없습니다</li>`;
    hits.forEach((h, i) => {
      const li = document.createElement("li");
      li.setAttribute("role", "option");
      li.innerHTML = `${h.t}<small>${h.s}</small>`;
      li.addEventListener("mousedown", (e) => { e.preventDefault(); go(i); });
      resEl.appendChild(li);
    });
    resEl.hidden = false;
  };
  const go = (i: number) => {
    const h = hits[i];
    if (!h) return;
    map.flyTo({ center: [h.x, h.y], zoom: h.z, speed: 1.6 });
    resEl.hidden = true;
    qEl.value = h.t;
    // 그 위치의 시군구를 선택
    map.once("moveend", () => {
      const f = map.queryRenderedFeatures(map.project([h.x, h.y]), { layers: ["sgg-fill"] })[0];
      if (f) select(f.properties.id, true);
    });
  };
  let timer = 0;
  qEl.addEventListener("input", () => { clearTimeout(timer); timer = window.setTimeout(() => search(qEl.value), 280); });
  qEl.addEventListener("keydown", (e) => {
    const lis = [...resEl.querySelectorAll("li[role=option]")];
    if (e.key === "ArrowDown" || e.key === "ArrowUp") {
      e.preventDefault();
      active = Math.max(0, Math.min(lis.length - 1, active + (e.key === "ArrowDown" ? 1 : -1)));
      lis.forEach((l, i) => l.setAttribute("aria-selected", String(i === active)));
    } else if (e.key === "Enter") {
      e.preventDefault();
      if (active >= 0) go(active); else if (hits.length) go(0); else search(qEl.value);
    } else if (e.key === "Escape") resEl.hidden = true;
  });
  qEl.addEventListener("blur", () => setTimeout(() => (resEl.hidden = true), 150));
  }
  main();
</script>
