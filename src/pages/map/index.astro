  // 혜성 점(타임랩스·이사 흐름 공통): 같은 속력, 긴 꼬리, 출발 빨강 → 도착 파랑. 하나 = unit명
  function drawComets(now: number, X: (m: number) => number, Y: (m: number) => number) {
    larcs = larcs.filter((l) => l.dying == null || now - l.dying < 600);
    const ca = colors.out.match(/[\d.]+/g)!.slice(0, 3).map(Number), cb = colors.in.match(/[\d.]+/g)!.slice(0, 3).map(Number);
    const mixC = (t: number, al: number) => `rgba(${ca.map((v, k) => Math.round(v + (cb[k] - v) * t)).join(",")},${al})`;
    cx.lineCap = "round";
    if (reduce) {
      // 동작 줄이기: 흐르는 점 대신 길을 가는 선으로 (출발 빨강 → 도착 파랑)
      for (const l of larcs) {
