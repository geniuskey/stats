    cumMax = cum.map((g) => Math.max(1, ...g.map((c) => Math.max(...Array.from(c).map(Math.abs)))));
  })());
  // 이달의 길: 순이동이 큰 시군구 쌍을 곡선으로 (출발 빨강 → 도착 파랑 그라데이션), 점은 그 위를 꼬리 달고 흐른다
  const TOP_ARCS = 60;
  type LArc = { a: string; b: string; n: number; k: number; comp: [string, string, number][]; mx0: number; my0: number; mx1: number; my1: number; cx: number; cy: number; born: number; dying?: number };
  type Dot = { arc: LArc; t0: number; dur: number; x0: number; y0: number; qx: number; qy: number; x1: number; y1: number };
  let larcs: LArc[] = [];
