      const pick = (r: number) => { let acc = 0; for (const q of comp) if ((acc += q[2]) >= r * tot) return q; return comp[comp.length - 1]; };
      const pt = (pool: Record<string, number[]>, id: string, r: number, f: [number, number]): [number, number] => {
        const pl = pool[id];
        if (pl) { const j = Math.floor(r * (pl.length / 2)) * 2; return [pl[j], pl[j + 1]]; }
