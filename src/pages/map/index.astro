        const p0 = [X(l.mx0), Y(l.my0)], p1 = [X(l.mx1), Y(l.my1)], q = [X(l.cx), Y(l.cy)];
        const gr = cx.createLinearGradient(p0[0], p0[1], p1[0], p1[1]);
        gr.addColorStop(0, mixC(0, 0.7)); gr.addColorStop(1, mixC(1, 0.7));
        cx.beginPath(); cx.moveTo(p0[0], p0[1]); cx.quadraticCurveTo(q[0], q[1], p1[0], p1[1]);
        cx.strokeStyle = gr; cx.lineWidth = 1.4; cx.stroke();
