        dots.push({ arc, t0: start + ((j + sc()) / arc.k) * CYCLE, dur: Math.min(3400, 900 + (len / 0.01) * 1700) * (0.9 + sc() * 0.2), x0, y0, qx, qy, x1, y1 });
