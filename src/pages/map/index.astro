      larcs.push({ a: m.a, b: m.b, n: m.c * L.unit, k: Math.min(40, m.c), comp: m.comp?.length ? m.comp : [[m.a, m.b, m.c]],
        mx0: A[0], my0: A[1], mx1: B[0], my1: B[1], cx: (A[0] + B[0]) / 2 - dy * 0.22, cy: (A[1] + B[1]) / 2 + dx * 0.22, born: start });
    }
    spawnCycle(start);
    kick();
  }
  let cycSeed = 1;
  function spawnCycle(start: number) {
    nextCycle = start + CYCLE;
    if (reduce) return; // 동작 줄이기: 흐르는 점 없이 지역 색만
    const sc = () => { const x = Math.sin(++cycSeed * 78.233) * 43758.5453; return x - Math.floor(x); };
    for (const arc of larcs) {
      if (arc.dying != null) continue;
