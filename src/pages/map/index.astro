  }
  const ymTxt = (ym: string) => `${ym.slice(0, 4)}.${ym.slice(4)}`;
  const captionOf = (ym: string) => D.lapseCaptions[ym] ?? (ym.endsWith("02") ? D.lapseCaptions["02"] : "");
  const man = (v: number) => (Math.abs(v) >= 10000 ? `${(v / 10000).toFixed(1)}만` : fmtN(v));
  const cumNow = (r: number, now: number) => {
