  // 달이 바뀌면 길만 바꾼다(지난 길은 서서히 사라짐). 날고 있는 점은 끝까지 날고, 아직 안 뜬 점만 거둔다
  function spawnMonth(i: number, start: number) {
    if (!L) return;
