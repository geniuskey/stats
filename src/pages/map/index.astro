  // 화면 좌표: 메르카토르 [0,1] → 픽셀 (두 기준점으로 선형 변환, 프레임마다 한 번)
  const projector = () => {
    const RA = [126, 35], RB = [129.5, 38];
    const a = map.project(RA), b = map.project(RB), ma = toM(RA[0], RA[1]), mb = toM(RB[0], RB[1]);
    const sx = (b.x - a.x) / (mb[0] - ma[0]), sy = (b.y - a.y) / (mb[1] - ma[1]);
    const ox = a.x - ma[0] * sx, oy = a.y - ma[1] * sy;
