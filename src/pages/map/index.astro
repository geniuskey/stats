        const q = pick(sc());
        const [x0, y0] = pt(poolOut, q[0], sc(), [arc.mx0, arc.my0]), [x1, y1] = pt(poolIn, q[1], sc(), [arc.mx1, arc.my1]);
        // 가운데는 길(선) 쪽으로 모이고 양 끝은 땅에 흩어진다
