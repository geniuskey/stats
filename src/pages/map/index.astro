    if (mpts) for (const [id, [o, i]] of Object.entries(mpts.pts as Record<string, number[][]>)) {
      const conv = (f: number[]) => { const r: number[] = []; for (let k = 0; k < f.length; k += 2) r.push(...toM(mpts.x0 + f[k] / mpts.q, mpts.y0 + f[k + 1] / mpts.q)); return r; };
