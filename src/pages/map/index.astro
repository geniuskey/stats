      larcs.push({ a: c.a, b: c.b, n: net, k: Math.min(40, Math.max(1, Math.round(net / scale.unit))), comp: c.comp?.length ? c.comp : [[c.a, c.b, net]],
        mx0: A[0], my0: A[1], mx1: B[0], my1: B[1], cx: (A[0] + B[0]) / 2 - dy * 0.22, cy: (A[1] + B[1]) / 2 + dx * 0.22, born: now });
    }
