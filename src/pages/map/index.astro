  }
  // 이사 흐름 통로 → 혜성 길. 통로가 바뀌면 지난 길은 서서히 사라지고 새 길에 점이 흐른다
  function flowComets(now: number) {
    for (const a of larcs) if (a.dying == null) a.dying = now;
    dots = dots.filter((d) => d.t0 <= now);
    for (const c of arcs) {
      const net = netOf(c);
