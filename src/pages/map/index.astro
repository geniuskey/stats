      // 구성(comp): 그 시도 쌍을 이루는 시군구 쌍과 그 순이동 → 점의 출발·도착 시군구를 이 비중대로 뽑는다
      const net = new Map<string, { v: number; comp: [string, string, number][] }>();
      for (let p = 0; p < L.pairs.length; p++) {
