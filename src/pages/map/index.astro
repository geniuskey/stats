  // 점은 달과 상관없이 끊기지 않고 흐른다: CYCLE마다 지금 길들에 점을 고르게 흘려 보낸다
  const CYCLE = MONTH_MS;
  let nextCycle = Infinity;
  const clearDots = () => { dots = []; larcs = []; nextCycle = Infinity; };
  let lapseLevel: "sido" | "sgg" = "sido";
  const nmShort = (id: string) => (id.length === 2 ? D.sidoNames[id] : (D.regions[id]?.n ?? id));
  const sidoM = (sd: string): [number, number, number] | null => { const c = SP[sd]; if (!c) return null; const [mx, my] = toM(c[0], c[1]); return [mx, my, 0]; };
  const monthArcs = (i: number) => {
    if (lapseLevel === "sido") {
