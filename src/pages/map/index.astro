        const t = Math.sign(v) * Math.sqrt(Math.abs(v) / cumMax[lapseGroup]), q = Math.round(t * 100) / 100;
        if (fillState.get(id) !== q) { fillState.set(id, q); map.setFeatureState({ source: "sgg", id }, { v: q }); }
