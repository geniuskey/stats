---
import Base from "../../layouts/Base.astro";
import Chart from "../../components/Chart.astro";
import Stat from "../../components/Stat.astro";
import BarList from "../../components/BarList.astro";
import KoreaMap from "../../components/KoreaMap.astro";
import geo from "../../data/geo.json";
import data from "../../data/housing.json";
import sggData from "../../data/housing_sgg.json";
import { dongneNames } from "../../lib/dongneMap";
import { int, compact, won } from "../../lib/format";

const D = data as any;
const regions = D.regions as any[];
const R = Object.fromEntries(regions.map((r) => [r.id, r]));
const nat = R["00"];
const seoul = R["11"];
const sidos = regions.filter((r) => r.level === "sido");
const meta = D.meta;
const A = meta.assumptions;
const cy = meta.currentYear;
const fy = nat.change.fromYear;
const histYears = Object.keys(nat.hist).map(Number);

const p1 = (v: number | null | undefined) => (v == null ? "–" : `${v.toFixed(1)}%`);
const d1 = (v: number | null | undefined) => (v == null ? "–" : v.toFixed(1));
const sgn = (v: number) => (v > 0 ? "+" : "") + v.toFixed(1);

// 부담률·PIR 추이 (부담률은 % 값 → 비율로 변환해 pct 포맷)
const lineRegions = [
  { id: "11", color: "var(--series-1)" },
  { id: "41", color: "var(--series-2)" },
  { id: "00", color: "var(--series-3)" },
  { id: "noncapital", color: "var(--series-4)" },
];
const histPts = (r: any, k: "burden" | "pir", div = 1) =>
  Object.entries(r.hist).map(([y, v]: any) => [Number(y), v[k] / div] as [number, number]);
const burdenSpec = {
  type: "line" as const,
  yFormat: "pct" as const,
  zeroBased: true,
  height: 300,
  series: lineRegions.map((l) => ({ name: R[l.id].name, color: l.color, data: histPts(R[l.id], "burden", 100), label: true })),
};
const pirSpec = {
  type: "line" as const,
  yFormat: "dec1" as const,
  zeroBased: true,
  height: 300,
  series: lineRegions.map((l) => ({ name: R[l.id].name, color: l.color, data: histPts(R[l.id], "pir"), label: true })),
};
const allRows = [nat, R["capital"], R["noncapital"], ...sidos];
const histTable = (k: "burden" | "pir") => ({
  headers: ["지역", ...histYears.map(String)],
  rows: allRows.map((r) => [r.name, ...histYears.map((y) => (r.hist[y] ? (k === "burden" ? p1(r.hist[y][k]) : d1(r.hist[y][k])) : "–"))]),
});

// 순위
const burdenBars = [...sidos].sort((a, b) => b.current.burden - a.current.burden)
  .map((r) => ({ name: r.name, value: r.current.burden / 100 }));
const changeBars = [...sidos].sort((a, b) => b.change.burden - a.change.burden)
  .map((r) => ({ name: r.name, value: r.change.burden / 100 }));

// 서울 권역
const zones = [...(D.seoulZones as any[])].sort((a, b) => b.burden - a.burden);
const topZone = zones[0];

// 금리
const rateYear: Record<number, number[]> = {};
for (const [ym, v] of Object.entries(D.rate.monthly as Record<string, number>)) {
  (rateYear[+ym.slice(0, 4)] ??= []).push(v);
}
const ratePts = Object.entries(rateYear).map(([y, a]) => [Number(y), a.reduce((s, x) => s + x, 0) / a.length / 100] as [number, number]);
const rateSpec = {
  type: "line" as const,
  yFormat: "pct1" as const,
  zeroBased: true,
  height: 240,
  series: [{ name: "주택담보대출 금리 (연평균)", color: "var(--series-1)", data: ratePts, label: true }],
};
const lastRateYear = ratePts[ratePts.length - 1];
const sensRows = [nat, ...sidos].map((r) => [r.name, p1(r.sensitivity["-1"]), p1(r.sensitivity["0"]), p1(r.sensitivity["1"])]);

// 시나리오: 클라이언트에서 토글 (데이터 직렬화)
const scenRegions = lineRegions.map((l) => ({
  id: l.id, name: R[l.id].name, color: l.color,
  hist: histPts(R[l.id], "burden", 100),
  outlook: R[l.id].outlook,
}));
const scenSido = [nat, ...sidos].map((r) => ({ id: r.id, name: r.name, now: r.current.burden, outlook: r.outlook }));
const scenJson = JSON.stringify({ regions: scenRegions, sido: scenSido, cy }).replace(/</g, "\\u003c");

// 계산기
const calcJson = JSON.stringify({ ...D.calculator, A }).replace(/</g, "\\u003c");
const defaultIncome = Math.round(nat.current.income / 100) * 100;

const seoulFirst = seoul.hist[fy];
// ---- 시각화 확장
const sidoNames = Object.fromEntries(sidos.map((r) => [r.id, r.name]));
const histMetric = (k: "burden" | "pir" | "pyeong") => ({
  labels: histYears,
  values: histYears.map((y) => Object.fromEntries(sidos.map((r) => [r.id, r.hist[y]?.[k] == null ? null : k === "burden" ? r.hist[y][k] / 100 : r.hist[y][k]]))),
  start: histYears.length - 1,
});
const housingMap = [
  { key: "burden", label: "주택구입 부담률", format: "pct" as const, kind: "seq" as const, breaks: [0.1, 0.15, 0.2, 0.25, 0.3, 0.4], higherIsBetter: false,
    desc: `월 상환액 ÷ 월소득 (전용 ${A.area}㎡ · LTV ${A.ltv * 100}% · ${A.termYears}년). ▶ 를 누르면 ${histYears[0]}→${cy}년 변화를 재생합니다.`, frames: histMetric("burden") },
  { key: "pir", label: "PIR", format: "dec1" as const, kind: "seq" as const, breaks: [3, 4, 5, 6, 8, 10, 13], higherIsBetter: false,
    desc: `전용 ${A.area}㎡ 아파트 가격이 가구 연소득의 몇 배인지 (년).`, frames: histMetric("pir") },
  { key: "pyeong", label: "1년 소득 면적", format: "dec1" as const, kind: "seq-warm" as const, breaks: [1.5, 2, 2.5, 3, 3.5, 4, 5],
    desc: "가구 연소득으로 살 수 있는 아파트 전용면적(평). 작을수록 집이 비쌉니다.", frames: histMetric("pyeong") },
];
// 금리 슬라이더 지도: 금리별 부담률
const rateNow = nat.current.rate;
const rateList = [...new Set([...Array.from({ length: 21 }, (_, i) => 2 + i * 0.25), Math.round(rateNow * 100) / 100])].sort((a, b) => a - b);
const burdenAt = (r: any, rate: number) => {
  const n = A.termYears * 12, mr = rate / 100 / 12;
  const loan = r.current.price84 * A.ltv;
  const p = mr === 0 ? loan / n : (loan * mr) / (1 - Math.pow(1 + mr, -n));
  return p / (r.current.income / 12);
};
const rateMap = [
  { key: "rate", label: "금리별 주택구입 부담률", format: "pct" as const, kind: "seq" as const, breaks: [0.1, 0.15, 0.2, 0.25, 0.3, 0.4], higherIsBetter: false,
    desc: `슬라이더가 대출 금리입니다. 집값·소득은 ${cy}년 그대로 두고 금리만 바꿨습니다. 현재 금리 ${rateNow.toFixed(2)}%.`,
    frames: { labels: rateList.map((x) => `${x.toFixed(2)}%${Math.abs(x - rateNow) < 1e-6 ? " 현재" : ""}`), values: rateList.map((x) => Object.fromEntries(sidos.map((r) => [r.id, burdenAt(r, x)]))), start: rateList.findIndex((x) => Math.abs(x - rateNow) < 1e-6) } },
];
// 계산기 지도 (시도 경계)
const G = geo as any;
const calcShapes = Object.entries(G.sido).map(([id, v]: any) => ({ id, d: v.d }));

// ---- 시군구 (국토부 실거래가)
const S = sggData as any;
const SR = S.regions as Record<string, any>;
const SN = S.national;
const sm = S.meta;
const ymLabel = (ym: string) => `${ym.slice(0, 4)}년 ${+ym.slice(4)}월`;
const periodLabel = `${ymLabel(sm.period[0])}~${ymLabel(sm.period[1])}`;
const sggNames = dongneNames();
const sggVal = (k: string, f: (v: number) => number = (v) => v) =>
  Object.fromEntries(Object.entries(SR).map(([id, r]) => [id, r[k] == null ? null : f(r[k])]));
const sggList = Object.entries(SR).filter(([, r]) => r.burden != null).map(([id, r]) => ({ id, name: sggNames[id], ...r }));
const byBurden = [...sggList].sort((a, b) => b.burden - a.burden);
const over30 = sggList.filter((r) => r.burden >= 30).length;
const under10 = sggList.filter((r) => r.burden < 10).length;
const sggNotes = Object.fromEntries(Object.entries(SR).map(([id, r]) => [id, r.price84 ? `84㎡ 중위 ${(r.price84 / 1e4).toFixed(1)}억 · 매매 ${int(r.nTrade)}건` : `매매 ${int(r.nTrade)}건 (표본 부족)`]));
const buyMap = [
  { key: "burden", label: "주택구입 부담률", format: "pct" as const, kind: "seq" as const, breaks: [0.05, 0.1, 0.15, 0.2, 0.3, 0.45, 0.6], higherIsBetter: false,
    desc: `84㎡ 중위가격의 ${A.ltv * 100}%를 금리 ${sm.rate.toFixed(2)}%·${A.termYears}년으로 갚을 때 월 상환액 ÷ 시도 가구 월소득.`, values: sggVal("burden", (v) => v / 100) },
  { key: "pir", label: "PIR", format: "dec1" as const, kind: "seq" as const, breaks: [2, 3, 4, 6, 8, 12, 20], higherIsBetter: false,
    desc: "84㎡ 중위가격이 시도 가구 연소득의 몇 배인지 (년).", values: sggVal("pir") },
  { key: "price84", label: "84㎡ 가격", format: "eok" as const, kind: "seq" as const, breaks: [1, 2, 3, 5, 7, 10, 15], higherIsBetter: false,
    desc: `전용 ${sm.assumptions.areaRange[0]}~${sm.assumptions.areaRange[1]}㎡ 중개거래의 ㎡당 가격 중앙값 × 84㎡ (억원).`, values: sggVal("price84", (v) => v / 1e4) },
  { key: "volChg", label: "거래량 변화", format: "pctS" as const, kind: "div" as const, breaks: [-0.3, -0.15, -0.05, 0.05, 0.15, 0.3],
    desc: `매매 건수(해제 제외), ${ymLabel(sm.prevPeriod[0])}~${ymLabel(sm.prevPeriod[1])} 대비.`, values: sggVal("volChg") },
];
const rentMap = [
  { key: "jeonseRatio", label: "전세가율", format: "pct" as const, kind: "seq" as const, breaks: [0.5, 0.6, 0.7, 0.75, 0.8, 0.85], higherIsBetter: false,
    desc: "같은 단지 안에서 전세 보증금 ÷ 매매가(㎡당 중앙값)의 단지별 중앙값. 높을수록 집값이 조금만 내려도 보증금을 돌려받기 어렵습니다.", values: sggVal("jeonseRatio", (v) => v / 100) },
  { key: "renewUp", label: "재계약 인상률", format: "pct1S" as const, kind: "div" as const, breaks: [-0.02, -0.001, 0.001, 0.02, 0.04, 0.05],
    desc: "전세 → 전세 갱신 계약의 보증금 인상률 중앙값. 갱신요구권을 쓰면 5%까지만 올릴 수 있습니다.", values: sggVal("renewUp") },
  { key: "renewDown", label: "보증금을 내린 재계약", format: "pct" as const, kind: "seq" as const, breaks: [0.01, 0.02, 0.05, 0.1, 0.2, 0.3], higherIsBetter: false,
    desc: "전세 갱신 계약 중 보증금을 종전보다 낮춘 비율. 역전세의 신호입니다.", values: sggVal("renewDown") },
  { key: "rrShare", label: "갱신요구권 사용", format: "pct" as const, kind: "seq" as const, breaks: [0.2, 0.3, 0.35, 0.4, 0.45, 0.5],
    desc: "갱신 계약 중 세입자가 계약갱신요구권을 쓴 비율.", values: sggVal("rrShare") },
  { key: "wolseShare", label: "월세 비중", format: "pct" as const, kind: "seq" as const, breaks: [0.3, 0.4, 0.5, 0.6, 0.7, 0.8],
    desc: "아파트 전월세 계약 중 월세(보증부 월세 포함) 비율.", values: sggVal("wolseShare") },
];
// 월별 추이: 신고 기한이 지나지 않은 달은 뺀다
const SM = S.monthly;
const provisional = new Set(sm.monthsProvisional as string[]);
const ymX = (ym: string) => +ym.slice(0, 4) * 12 + (+ym.slice(4) - 1);
const monthPts = (k: string) => (SM.months as string[]).map((ym, i) => [ymX(ym), provisional.has(ym) ? null : SM[k][i]] as [number, number | null]).filter((p) => p[1] != null);
const rentTrendSpec = {
  type: "line" as const, xFormat: "ym" as const, yFormat: "pct" as const, zeroBased: true, height: 300, legend: true,
  series: [
    { name: "보증금을 내린 재계약", color: "var(--series-1)", data: monthPts("renewDown"), label: true },
    { name: "갱신요구권 사용", color: "var(--series-2)", data: monthPts("rrShare"), label: true },
    { name: "월세 비중", color: "var(--series-3)", data: monthPts("wolseShare"), label: true },
  ],
};
const tradesSpec = {
  type: "line" as const, xFormat: "ym" as const, yFormat: "int" as const, zeroBased: true, height: 260,
  series: [{ name: "아파트 매매 거래", color: "var(--series-1)", data: monthPts("trades"), fill: true }],
};
const downPeak = (SM.months as string[]).map((ym, i) => ({ ym, v: SM.renewDown[i] as number | null })).filter((x) => x.v != null && !provisional.has(x.ym)).sort((a, b) => b.v! - a.v!)[0];
const monthTable = (k: string, f: (v: number) => string) => ({
  headers: ["월", "전국"],
  rows: (SM.months as string[]).filter((ym) => !provisional.has(ym)).map((ym) => [ymLabel(ym), SM[k][SM.months.indexOf(ym)] == null ? "–" : f(SM[k][SM.months.indexOf(ym)])]),
});
const pctTxt = (v: number | null | undefined, d = 0) => (v == null ? "–" : `${(v * 100).toFixed(d)}%`);

---
<Base title="집값을 감당할 수 있을까?" active="housing" description={`소득·주택가격·금리·대출을 결합한 지역별 주택구입 부담률. 서울에서 국민평형 아파트를 사면 월소득의 ${p1(seoul.current.burden)}를 대출 상환에 씁니다.`}>
  <div class="wrap">
    <section class="hero">
      <div class="eyebrow">집값을 감당할 수 있을까? · 소득 × 주택가격 × 금리 × 대출</div>
      <h1>서울에서 국민평형을 사면, 월소득의 {Math.round(seoul.current.burden)}%가 대출 상환입니다</h1>
      <p class="lede">
        실거래 아파트 가격, 지역별 가구소득, 주택담보대출 금리를 하나로 묶었습니다. 보통 가구가 전용 {A.area}㎡ 아파트를
        집값의 {A.ltv * 100}%를 빌려 {A.termYears}년 동안 갚는다면 매달 소득의 몇 %가 나가는지 계산한 값이 <strong>주택구입 부담률</strong>입니다.
        {fy}년 {p1(seoulFirst.burden)}였던 서울의 부담률은 {cy}년 {p1(seoul.current.burden)}가 됐습니다.
      </p>
    </section>

    <div class="grid grid-4">
      <Stat label={`서울 주택구입 부담률 ${cy}`} value={d1(seoul.current.burden)} unit="%" note={`${fy}년 대비 ${sgn(seoul.change.burden)}%p`} tone="down" />
      <Stat label={`전국 주택구입 부담률 ${cy}`} value={d1(nat.current.burden)} unit="%" note={`${fy}년 대비 ${sgn(nat.change.burden)}%p`} tone="down" />
      <Stat label="서울 PIR (84㎡ 가격 ÷ 연소득)" value={d1(seoul.current.pir)} unit="년" note={`${fy}년 ${d1(seoulFirst.pir)}년 · 전국 ${d1(nat.current.pir)}년`} />
      <Stat label="서울, 1년치 소득으로 사는 면적" value={d1(seoul.current.pyeong)} unit="평" note={`${fy}년 ${d1(seoulFirst.pyeong)}평 · 전용면적 기준`} />
    </div>

    <section class="section">
      <h2>10년 사이 무엇이 달라졌나</h2>
      <p class="section-desc">연도 값은 1~12월 평균이고, {cy}년은 최근 12개월(~{meta.lastPriceMonth}) 평균입니다. 부담률은 집값·소득·금리가 함께 움직인 결과입니다. 2022년 이후 금리 상승이 부담을 한 단계 끌어올렸습니다.</p>
      <div class="grid grid-2">
        <Chart spec={burdenSpec} table={histTable("burden")} title="주택구입 부담률" sub={`월 상환액 ÷ 월소득, 전용 ${A.area}㎡ · LTV ${A.ltv * 100}% · ${A.termYears}년`} />
        <Chart spec={pirSpec} table={histTable("pir")} title="PIR: 집값은 몇 년치 소득인가" sub={`전용 ${A.area}㎡ 아파트 가격 ÷ 가구 연소득 (년)`} />
      </div>
    </section>

    <section class="section">
      <h2>시도별 지도</h2>
      <p class="section-desc">같은 국민평형이라도 서울의 부담률은 가장 낮은 지역의 약 {Math.round(burdenBars[0].value / burdenBars[burdenBars.length - 1].value)}배입니다. 지표를 바꾸거나 ▶ 로 {histYears[0]}년부터의 변화를 재생해 보세요.</p>
      <KoreaMap level="sido" metrics={housingMap} names={sidoNames} title="시도별 집값 부담" sub={`연도 값은 1~12월 평균, ${cy}년은 최근 12개월`} />
      <div class="card" style="margin-top:16px">
        <h3 class="card-title">부담률 변화 ({fy}→{cy})</h3>
        <p class="card-sub">%p, 클수록 빠르게 악화</p>
        <BarList items={changeBars} format="pct1" color="var(--series-2)" />
      </div>
    </section>

    <section class="section">
      <h2>서울 안에서도 세 배 차이</h2>
      <p class="section-desc">한국부동산원 서울 5개 권역의 실거래가에 서울 평균 가구소득({int(seoul.current.income)}만원)을 적용했습니다. {topZone.name}에서 국민평형을 사려면 {d1(topZone.pir)}년치 소득이 필요합니다.</p>
      <div class="grid grid-2">
        <div class="card">
          <h3 class="card-title">권역별 주택구입 부담률</h3>
          <p class="card-sub">{cy}년 (최근 12개월)</p>
          <BarList items={zones.map((z) => ({ name: z.name, value: z.burden / 100 }))} format="pct1" />
        </div>
        <div class="card">
          <h3 class="card-title">권역별 지표</h3>
          <div class="table-wrap">
            <table>
              <thead><tr><th>권역</th><th class="num">84㎡ 가격</th><th class="num">월 상환액</th><th class="num">PIR</th><th class="num">1년 소득 면적</th></tr></thead>
              <tbody>
                {zones.map((z) => (
                  <tr><td>{z.name}</td><td class="num">{won(z.price84 * 1e4)}</td><td class="num">{int(z.payment)}만원</td><td class="num">{d1(z.pir)}년</td><td class="num">{d1(z.pyeong)}평</td></tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="small muted" style="margin-top:10px">도심권: 종로·중구·용산 / 동북권: 성동·광진·동대문·중랑·성북·강북·도봉·노원 / 동남권: 서초·강남·송파·강동 / 서북권: 은평·서대문·마포 / 서남권: 양천·강서·구로·금천·영등포·동작·관악</p>
        </div>
      </div>
    </section>

    <section class="section" id="sgg">
      <h2>시군구로 내려가 보면</h2>
      <p class="section-desc">
        국토교통부 아파트 매매 실거래 {int(SN.nTrade)}건({periodLabel})으로 229개 시군구의 국민평형 가격을 다시 계산했습니다.
        같은 금리·시도 소득을 적용해도 부담률이 30%를 넘는 시군구가 {over30}곳, 10%도 안 되는 곳이 {under10}곳입니다.
        가장 높은 {byBurden[0].name}는 {p1(byBurden[0].burden)}입니다.
      </p>
      <KoreaMap metrics={buyMap} names={sggNames} notes={sggNotes} title="시군구 집값 부담" sub={`${periodLabel} 실거래 · 소득은 시도 평균`} />
      <p class="small muted" style="margin-top:8px">
        여기서는 거래 한 건 한 건의 중앙값을 써서, 위 시도 지도(한국부동산원 평균가격)보다 값이 낮게 나옵니다. 비싼 단지 몇 곳이 평균을 끌어올리는 효과가 빠지기 때문입니다.
        소득은 시군구 자료가 없어 시도 평균을 썼으므로, 같은 시도 안의 차이는 집값 차이입니다. 매매가 {sm.assumptions.minN}건 미만인 곳은 비워 두었습니다.
      </p>
      <div style="margin-top:16px">
        <Chart spec={tradesSpec} title="월별 아파트 매매 거래량" sub={`전국, 해제된 계약 제외 · 신고 기한(30일)이 지나지 않은 최근 달은 뺐습니다`} table={monthTable("trades", (v) => int(v))} />
      </div>
    </section>

    <section class="section" id="renewal">
      <h2>전세 재계약, 보증금은 얼마나 올랐나</h2>
      <p class="section-desc">
        2021년 전월세 신고제 이후 실거래에는 갱신 계약 여부, 종전 보증금, 갱신요구권 사용 여부가 함께 기록됩니다.
        최근 12개월 전세 재계약 {int(SN.nRenew)}건의 보증금 인상률 중앙값은 {pctTxt(SN.renewUp, 1)}입니다.
        {downPeak && <>역전세가 한창이던 {ymLabel(downPeak.ym)}에는 재계약의 {pctTxt(downPeak.v)}가 보증금을 <strong>내렸습니다</strong>.</>}
      </p>
      <div class="grid grid-4">
        <Stat label="재계약 보증금 인상률 (중앙값)" value={(SN.renewUp * 100).toFixed(1)} unit="%" note={`5% 넘게 올린 계약 ${pctTxt(SN.renewOver5)}`} />
        <Stat label="보증금을 내린 재계약" value={(SN.renewDown * 100).toFixed(1)} unit="%" note={downPeak ? `정점 ${ymLabel(downPeak.ym)} ${pctTxt(downPeak.v)}` : undefined} />
        <Stat label="갱신요구권 사용 비율" value={(SN.rrShare * 100).toFixed(0)} unit="%" note="갱신 계약 중" />
        <Stat label="아파트 전월세 중 월세" value={(SN.wolseShare * 100).toFixed(0)} unit="%" note={`전세가율 ${SN.jeonseRatio.toFixed(0)}% (같은 단지 기준)`} />
      </div>
      <div style="margin-top:16px">
        <Chart spec={rentTrendSpec} title="역전세가 지나간 자리" sub="전국 아파트 전월세 계약, 월별" table={monthTable("renewDown", (v) => pctTxt(v, 1))} />
      </div>
      <div style="margin-top:16px">
        <KoreaMap metrics={rentMap} names={sggNames} title="시군구 전월세 지도" sub={`${periodLabel} 실거래`} />
      </div>
    </section>

    <section class="section">
      <h2>금리가 1%p 움직이면</h2>
      <p class="section-desc">주택담보대출 금리(신규취급액)는 {lastRateYear[0]}년 평균 {(lastRateYear[1] * 100).toFixed(2)}%입니다. 다른 조건이 그대로일 때 금리가 1%p 오르면 서울의 부담률은 {p1(seoul.sensitivity["0"])}에서 {p1(seoul.sensitivity["1"])}로 오릅니다.</p>
      <KoreaMap level="sido" metrics={rateMap} names={sidoNames} speed={280} title="금리를 움직여 보세요" sub="슬라이더를 끌거나 ▶ 를 누르면 금리 2%→7%에서 시도별 부담률이 어떻게 바뀌는지 보입니다" id="rate-map" />
      <div class="grid grid-2" style="margin-top:16px">
        <Chart spec={rateSpec} title="예금은행 주택담보대출 금리" sub="신규취급액 기준, 연평균" table={{ headers: ["연도", "금리"], rows: ratePts.map(([y, v]) => [String(y), `${(v * 100).toFixed(2)}%`]) }} />
        <div class="card">
          <h3 class="card-title">금리 민감도: 현재 부담률</h3>
          <p class="card-sub">현재 금리 {nat.current.rate.toFixed(2)}% 기준 ±1%p</p>
          <div class="table-wrap" style="max-height:380px">
            <table>
              <thead><tr><th>지역</th><th class="num">−1%p</th><th class="num">현재</th><th class="num">+1%p</th></tr></thead>
              <tbody>{sensRows.map((r) => <tr>{r.map((c, i) => <td class={i ? "num" : ""}>{c}</td>)}</tr>)}</tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="scenario">
      <h2>2030년, 부담은 어디로</h2>
      <p class="section-desc">집값과 금리 시나리오를 고르면 2030년까지의 부담률을 다시 계산합니다. 소득은 지역별 최근 3년 증가율로 늘고, 금리는 2년에 걸쳐 목표 수준으로 이동한다고 가정합니다. <strong>예측이 아니라 "이 조건이면 이렇게 된다"는 조건부 시나리오입니다.</strong></p>
      <div class="controls">
        <div class="seg" role="group" aria-label="집값 시나리오" data-scen="price">
          <button type="button" data-v="down" aria-pressed="false">집값 연 −2%</button>
          <button type="button" data-v="flat" aria-pressed="false">집값 횡보</button>
          <button type="button" data-v="trend" aria-pressed="true">{fy}년 이후 추세 지속</button>
        </div>
        <div class="seg" role="group" aria-label="금리 시나리오" data-scen="rate">
          <button type="button" data-v="cut" aria-pressed="false">금리 −1%p</button>
          <button type="button" data-v="hold" aria-pressed="true">금리 유지</button>
          <button type="button" data-v="hike" aria-pressed="false">금리 +1%p</button>
        </div>
      </div>
      <div class="grid grid-2">
        <figure class="card" style="margin:0">
          <h3 class="card-title">주택구입 부담률 시나리오</h3>
          <p class="card-sub" id="scen-sub">실선 실측, 점선 시나리오</p>
          <div class="chart" id="scen-chart"></div>
        </figure>
        <div class="card">
          <h3 class="card-title">2030년 시도별 부담률</h3>
          <p class="card-sub">선택한 시나리오 · 현재 대비 변화</p>
          <div class="table-wrap" style="max-height:380px">
            <table>
              <thead><tr><th>지역</th><th class="num">{cy}</th><th class="num">2030</th><th class="num">변화</th></tr></thead>
              <tbody id="scen-table"></tbody>
            </table>
          </div>
        </div>
      </div>
      <script type="application/json" id="scen-data" set:html={scenJson} />
    </section>

    <section class="section" id="calculator">
      <h2>내 조건이면 어디를 살 수 있나</h2>
      <p class="section-desc">연소득·자기자본·금리를 넣으면 지역별 평균 시세로 집을 살 때의 월 상환액과 소득 대비 비율을 계산합니다. 모자란 금액은 모두 대출(원리금균등)로 메운다고 가정합니다. 실제 대출 한도(LTV·DSR)와 단지별 가격은 다릅니다.</p>
      <div class="card">
        <div class="controls calc-controls">
          <label class="field">가구 연소득 (만원)<input type="number" id="c-income" min="0" step="100" value={defaultIncome} inputmode="numeric" /></label>
          <label class="field">자기자본 (만원)<input type="number" id="c-equity" min="0" step="1000" value="10000" inputmode="numeric" /></label>
          <label class="field">대출 금리 (%)<input type="number" id="c-rate" min="0" max="20" step="0.1" value={nat.current.rate.toFixed(1)} inputmode="decimal" /></label>
          <label class="field">만기 (년)<input type="number" id="c-term" min="5" max="50" step="5" value={A.termYears} inputmode="numeric" /></label>
          <label class="field">전용면적
            <select id="c-area"><option value={A.areaSmall}>{A.areaSmall}㎡ (25평형)</option><option value={A.area} selected>{A.area}㎡ (34평형)</option></select>
          </label>
        </div>
        <p class="insight" id="c-summary" aria-live="polite"></p>
        <div class="calc-viz">
          <div class="calc-map">
            <svg viewBox={`0 0 ${G.w} ${G.h}`} role="img" aria-label="시도별 판정 지도" id="c-map">
              {calcShapes.map((sh) => <path d={sh.d} data-id={sh.id} />)}
            </svg>
            <div class="tooltip" id="c-tt" role="status"></div>
            <div class="calc-legend">
              <span><i style="background:var(--good)"></i>여유 (25% 이하)</span>
              <span><i style="background:var(--warning)"></i>빠듯 (40% 이하)</span>
              <span><i style="background:var(--critical)"></i>어려움</span>
            </div>
          </div>
          <div>
            <div class="calc-bars-head small muted"><span>지역</span><span>월소득 대비 상환액 (점선 25% · 40%)</span><span></span></div>
            <div class="calc-bars" id="c-bars" role="list"></div>
          </div>
        </div>
        <details class="table-view">
          <summary>표로 보기 (시세·대출·감당 가능 면적)</summary>
          <div class="table-wrap">
            <table id="c-table">
              <thead><tr><th>지역</th><th class="num">평균 시세</th><th class="num">필요 대출</th><th class="num">월 상환액</th><th class="num">월소득 대비</th><th>판정</th><th class="num">감당 가능 면적</th></tr></thead>
              <tbody></tbody>
            </table>
          </div>
        </details>
        <p class="small muted" style="margin-top:10px">판정 기준: 월소득 대비 상환액 25% 이하 "여유", 40% 이하 "빠듯", 40% 초과 "어려움"(DSR 40% 규제 수준). 감당 가능 면적은 상환액을 월소득의 40%로 맞췄을 때 살 수 있는 전용면적입니다. 평균 시세는 최근 12개월 실거래 ㎡당 평균가격 × 면적입니다.</p>
      </div>
      <script type="application/json" id="calc-data" set:html={calcJson} />
    </section>

    <section class="section">
      <h2>대출은 얼마나 쌓였나</h2>
      <p class="section-desc">한국은행 차주당 가계대출 잔액(만원). 30·40대 차주의 평균 잔액은 1억원을 넘었습니다.</p>
      <Chart
        spec={{
          type: "line",
          yFormat: "int",
          height: 260,
          series: Object.entries(D.loans.byAge).map(([k, v]: any, i) => ({
            name: k, color: `var(--series-${i + 1})`, label: true,
            data: Object.entries(v).map(([y, x]: any) => [Number(y), x]),
          })),
        }}
        title="차주당 가계대출 잔액"
        sub="연령대별, 만원"
        table={{
          headers: ["연도", ...Object.keys(D.loans.byAge)],
          rows: Object.keys(D.loans.byAge["전체"]).map((y) => [y, ...Object.values(D.loans.byAge).map((v: any) => `${int(v[y])}만원`)]),
        }}
      />
    </section>

    <section class="section card method" id="method">
      <h2>방법론</h2>
      <h3>1. 주택구입 부담률</h3>
      <p>한국부동산원 아파트 매매 실거래 ㎡당 평균가격에 전용 {A.area}㎡를 곱해 '국민평형' 가격을 구합니다. 그 {A.ltv * 100}%를 한국은행 주택담보대출 평균금리(신규취급액)로 {A.termYears}년 원리금균등 상환할 때의 월 상환액을 계산하고, 가계금융복지조사의 지역별 가구 월소득으로 나눕니다.</p>
      <pre class="formula">월 상환액 = 대출금 × r ÷ (1 − (1 + r)^−n),  r = 연금리 ÷ 12, n = {A.termYears * 12}
주택구입 부담률 = 월 상환액 ÷ (가구 연소득 ÷ 12)
PIR = {A.area}㎡ 가격 ÷ 가구 연소득
1년치 소득 면적(평) = 가구 연소득 ÷ ㎡당 가격 ÷ {A.pyeong}</pre>
      <h3>2. 시점 맞추기</h3>
      <p>실거래 평균가격은 그달 어떤 단지·면적이 거래됐는지에 따라 크게 흔들리므로 12개월 평균을 씁니다. 가계금융복지조사의 소득은 조사 전년도 소득이라 1년 앞당겨 맞췄고, 아직 발표되지 않은 {meta.lastIncomeYear + 1}년 이후 소득은 지역별 최근 3년 연평균 증가율로 연장한 추정치입니다. 금리는 전국 단일 값을 모든 지역에 적용합니다.</p>
      <h3>3. 2030 시나리오</h3>
      <p>집값 3가지(연 −2%, 횡보, {fy}년 이후 지역별 연평균 상승률 지속)와 금리 3가지(−1%p, 유지, +1%p, 2년에 걸쳐 이동)를 조합한 9개 경로를 계산합니다. 미래 집값을 맞히려는 예측이 아니라 조건별 부담 수준을 보여주는 시뮬레이션입니다.</p>
      <h3>4. 시군구 지표 (국토교통부 실거래가)</h3>
      <p>국토교통부 아파트 매매·전월세 실거래 자료를 시군구별로 모았습니다({periodLabel}, 신고 기한 30일이 지난 달까지). 84㎡ 가격은 전용 {sm.assumptions.areaRange[0]}~{sm.assumptions.areaRange[1]}㎡ 중개거래(해제·직거래 제외)의 ㎡당 가격 중앙값에 84를 곱했습니다. 부담률·PIR은 위와 같은 식에 시도 가구소득을 넣었습니다. 전세가율은 단지 구성 차이를 없애려고 같은 단지 안에서 전세 보증금과 매매가를 비교한 뒤 단지별 비율의 중앙값을 썼습니다. 재계약 인상률은 종전·이번 계약이 모두 전세인 갱신 계약만 씁니다. 2026년 새로 생긴 전남광주통합특별시 코드와 인천의 새 구(제물포·영종·서해·검단)는 법정동 기준으로 2025년 시군구 경계에 다시 나눴습니다.</p>
      <h3>한계</h3>
      <ul>
        <li>시군구 부담률은 시도 평균 소득을 써서, 같은 시도 안 소득 차이(예: 강남구와 노원구)는 반영되지 않습니다.</li>
        <li>평균 가구소득 기준이라 무주택 실수요자의 실제 부담은 이보다 클 수 있습니다.</li>
        <li>LTV {A.ltv * 100}%는 단순 가정이며 실제 대출 규제(LTV·DSR)와 개인 조건은 다릅니다.</li>
        <li>거래가 급감한 해(예: 2022년)에는 실거래 평균이 거래 구성 변화로 왜곡됩니다.</li>
        <li>서울 권역 지표는 서울 평균소득을 사용한 근사치입니다. 광주·전남은 2026년 통합 이후에도 한국부동산원 권역 구분에 따라 따로 표시합니다.</li>
      </ul>
      {meta.notes.length > 0 && <ul class="small muted">{meta.notes.map((n: string) => <li>{n}</li>)}</ul>}
      <h3>데이터 출처</h3>
      <ul>{[...meta.sources, ...sm.sources.slice(0, 2)].map((s: string) => <li>{s}</li>)}</ul>
    </section>
  </div>
</Base>

<style>
  :global(.grid > *),
  :global(.card) {
    min-width: 0;
  }
  .calc-controls label.field {
    flex: 1 1 140px;
  }
  .calc-controls input,
  .calc-controls select {
    width: 100%;
  }
  .calc-viz {
    display: grid;
    gap: 20px;
    margin-top: 16px;
  }
  @media (min-width: 860px) {
    .calc-viz {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      align-items: start;
    }
  }
  .calc-map {
    position: relative;
  }
  .calc-map svg {
    width: 100%;
    height: auto;
    max-height: 520px;
    display: block;
  }
  .calc-map :global(path) {
    fill: var(--surface-2);
    stroke: var(--surface-1);
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
    transition: fill 0.4s ease;
    cursor: default;
  }
  .calc-map :global(path.on) {
    stroke: var(--text-primary);
    stroke-width: 2px;
  }
  .calc-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    font-size: 12.5px;
    color: var(--text-secondary);
    margin-top: 8px;
  }
  .calc-legend span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .calc-legend i {
    width: 12px;
    height: 12px;
    border-radius: 3px;
  }
  .calc-bars-head {
    display: grid;
    grid-template-columns: minmax(84px, 120px) 1fr 92px;
    gap: 10px;
    position: relative;
    margin-bottom: 6px;
  }
  .calc-bars-head .th25,
  .calc-bars-head .th40 {
    display: none;
  }
  .calc-bars {
    display: grid;
    gap: 3px;
    position: relative;
  }
  :global(.cb-row) {
    display: grid;
    grid-template-columns: minmax(84px, 120px) 1fr 92px;
    gap: 10px;
    align-items: center;
    font-size: 13px;
    padding: 2px 4px;
    border-radius: 6px;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  :global(.cb-row.on) {
    background: var(--surface-2);
  }
  :global(.cb-name) {
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  :global(.cb-track) {
    position: relative;
    height: 14px;
  }
  :global(.cb-fill) {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    border-radius: 0 4px 4px 0;
    transition: width 0.5s cubic-bezier(0.2, 0.7, 0.2, 1), background-color 0.4s;
  }
  :global(.cb-th) {
    position: absolute;
    top: -3px;
    bottom: -3px;
    width: 0;
    border-left: 1px dashed var(--text-muted);
  }
  :global(.cb-val) {
    text-align: right;
    font-variant-numeric: tabular-nums;
    font-weight: 650;
    white-space: nowrap;
  }
  @media (max-width: 520px) {
    .calc-bars-head,
    :global(.cb-row) {
      grid-template-columns: 72px 1fr 86px;
      gap: 8px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.cb-fill),
    .calc-map :global(path) {
      transition: none;
    }
  }
  .verdict {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }
  .verdict::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--dot);
  }
</style>

<script>
  import { mount } from "../../lib/charts";
  import { won, int } from "../../lib/format";

  // ---------- 시나리오
  const S = JSON.parse(document.getElementById("scen-data")!.textContent || "{}");
  const state: Record<string, string> = { price: "trend", rate: "hold" };
  const chartEl = document.getElementById("scen-chart") as HTMLElement;
  const tbody = document.getElementById("scen-table") as HTMLTableSectionElement;

  function drawScenario() {
    const series: any[] = [];
    for (const r of S.regions) {
      const out = r.outlook[state.price][state.rate];
      const last = r.hist[r.hist.length - 1];
      series.push({ name: r.name, color: r.color, data: r.hist });
      series.push({
        name: `${r.name} (시나리오)`, color: r.color, dash: true, label: true, hideInTooltip: false,
        data: [last, ...Object.entries(out).map(([y, v]: any) => [Number(y), v.burden / 100])],
      });
    }
    mount(chartEl, { type: "line", yFormat: "pct", zeroBased: true, height: 320, projStart: S.cy, series, legend: true } as any);
    tbody.textContent = "";
    for (const r of S.sido) {
      const v = r.outlook[state.price][state.rate]["2030"].burden;
      const tr = document.createElement("tr");
      const d = v - r.now;
      for (const [i, txt] of [r.name, `${r.now.toFixed(1)}%`, `${v.toFixed(1)}%`, `${d > 0 ? "+" : ""}${d.toFixed(1)}%p`].entries()) {
        const td = document.createElement("td");
        if (i) td.className = "num";
        td.textContent = txt;
        tr.appendChild(td);
      }
      tbody.appendChild(tr);
    }
  }
  document.querySelectorAll<HTMLElement>("[data-scen]").forEach((g) => {
    const k = g.dataset.scen!;
    g.querySelectorAll<HTMLButtonElement>("button").forEach((b) =>
      b.addEventListener("click", () => {
        state[k] = b.dataset.v!;
        g.querySelectorAll("button").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
        drawScenario();
      }),
    );
  });
  drawScenario();

  // ---------- 계산기
  const C = JSON.parse(document.getElementById("calc-data")!.textContent || "{}");
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const ctbody = document.querySelector("#c-table tbody") as HTMLTableSectionElement;
  const summary = document.getElementById("c-summary")!;
  const pay = (P: number, ratePct: number, years: number) => {
    const n = years * 12, r = ratePct / 100 / 12;
    if (P <= 0) return 0;
    return r === 0 ? P / n : (P * r) / (1 - Math.pow(1 + r, -n));
  };
  const loanFor = (monthly: number, ratePct: number, years: number) => {
    const n = years * 12, r = ratePct / 100 / 12;
    return r === 0 ? monthly * n : (monthly * (1 - Math.pow(1 + r, -n))) / r;
  };
  const verdicts = [
    { max: 25, label: "여유", dot: "var(--status-good, #0ca30c)" },
    { max: 40, label: "빠듯", dot: "var(--status-warning, #fab219)" },
    { max: Infinity, label: "어려움", dot: "var(--status-critical, #d03b3b)" },
  ];

  function calc() {
    const income = Math.max(+$("c-income").value || 0, 0);
    const equity = Math.max(+$("c-equity").value || 0, 0);
    const rate = Math.max(+$("c-rate").value || 0, 0);
    const term = Math.min(Math.max(+$("c-term").value || 30, 1), 50);
    const area = +(document.getElementById("c-area") as HTMLSelectElement).value;
    const mInc = income / 12;
    const maxBudget = equity + loanFor(mInc * 0.4, rate, term); // 만원
    const rows = [
      ...C.regions.filter((r: any) => !["capital", "noncapital"].includes(r.id)).map((r: any) => ({ name: r.name, priceM2: r.priceM2 })),
      ...C.seoulZones.map((z: any) => ({ name: `서울 ${z.name}`, priceM2: z.priceM2 })),
    ].map((r: any) => {
      const price = r.priceM2 * area;
      const loan = Math.max(price - equity, 0);
      const p = pay(loan, rate, term);
      const ratio = mInc > 0 ? (p / mInc) * 100 : Infinity;
      return { ...r, price, loan, p, ratio, maxArea: maxBudget / r.priceM2 };
    }).sort((a: any, b: any) => a.ratio - b.ratio);

    ctbody.textContent = "";
    let ok = 0;
    for (const r of rows) {
      const v = verdicts.find((x) => r.ratio <= x.max)!;
      if (r.ratio <= 40) ok++;
      const tr = document.createElement("tr");
      const cells = [r.name, won(r.price * 1e4), won(r.loan * 1e4), `${int(r.p)}만원`, isFinite(r.ratio) ? `${r.ratio.toFixed(0)}%` : "–", "", `${r.maxArea.toFixed(0)}㎡ (${(r.maxArea / 3.3058).toFixed(0)}평)`];
      cells.forEach((txt, i) => {
        const td = document.createElement("td");
        if (i === 5) {
          const s = document.createElement("span");
          s.className = "verdict";
          s.style.setProperty("--dot", v.dot);
          s.textContent = v.label;
          td.appendChild(s);
        } else {
          if (i) td.className = "num";
          td.textContent = txt;
        }
        tr.appendChild(td);
      });
      ctbody.appendChild(tr);
    }
    drawViz(rows);
    summary.textContent = `연소득 ${int(income)}만원, 자기자본 ${int(equity)}만원, 금리 ${rate}%라면 월소득의 40%(${int(mInc * 0.4)}만원)까지 상환할 때 최대 약 ${won(maxBudget * 1e4)}짜리 집을 살 수 있습니다. 전용 ${area}㎡ 기준으로 ${rows.length}개 지역 중 ${ok}곳이 '빠듯' 이내입니다.`;
  }
  // ---------- 계산기 시각화: 판정 지도 + 막대
  const barsEl = document.getElementById("c-bars")!;
  const mapEl = document.getElementById("c-map")!;
  const tt = document.getElementById("c-tt")!;
  const nameToId: Record<string, string> = Object.fromEntries(C.regions.map((r: any) => [r.name, r.id]));
  const vColor = (ratio: number) => (ratio <= 25 ? "var(--good)" : ratio <= 40 ? "var(--warning)" : "var(--critical)");
  const vLabel = (ratio: number) => (ratio <= 25 ? "여유" : ratio <= 40 ? "빠듯" : "어려움");
  const SCALE = 100; // 막대 축 0~100%
  let lastRows: any[] = [];
  const rowEls = new Map<string, HTMLElement>();
  function highlight(name: string | null) {
    mapEl.querySelectorAll("path").forEach((p) => p.classList.toggle("on", !!name && p.dataset.id === nameToId[name]));
    rowEls.forEach((el, n) => el.classList.toggle("on", n === name));
  }
  function drawViz(rows: any[]) {
    lastRows = rows;
    const ROW = 23;
    barsEl.style.height = `${rows.length * ROW}px`;
    rows.forEach((r, i) => {
      let el = rowEls.get(r.name);
      if (!el) {
        el = document.createElement("div");
        el.className = "cb-row";
        el.setAttribute("role", "listitem");
        el.style.position = "absolute";
        el.style.left = "0";
        el.style.right = "0";
        el.innerHTML = `<span class="cb-name"></span><span class="cb-track"><span class="cb-fill"></span><span class="cb-th" style="left:25%"></span><span class="cb-th" style="left:40%"></span></span><span class="cb-val"></span>`;
        el.querySelector(".cb-name")!.textContent = r.name;
        el.addEventListener("pointerenter", () => highlight(r.name));
        el.addEventListener("pointerleave", () => highlight(null));
        barsEl.appendChild(el);
        rowEls.set(r.name, el);
      }
      el.style.transform = `translateY(${i * ROW}px)`;
      const f = el.querySelector<HTMLElement>(".cb-fill")!;
      const ratio = isFinite(r.ratio) ? r.ratio : SCALE;
      f.style.width = `${Math.min(ratio, SCALE)}%`;
      f.style.background = vColor(ratio);
      el.querySelector(".cb-val")!.textContent = isFinite(r.ratio) ? `${r.ratio.toFixed(0)}% ${vLabel(r.ratio)}` : "–";
    });
    for (const r of rows) {
      const id = nameToId[r.name];
      const p = id ? mapEl.querySelector<SVGPathElement>(`path[data-id="${id}"]`) : null;
      if (p) p.style.fill = vColor(r.ratio);
    }
  }
  mapEl.querySelectorAll<SVGPathElement>("path").forEach((p) => {
    p.addEventListener("pointermove", (e) => {
      const r = lastRows.find((x) => nameToId[x.name] === p.dataset.id);
      if (!r) return;
      highlight(r.name);
      tt.innerHTML = "";
      const t = document.createElement("div");
      t.className = "tt-title";
      t.textContent = r.name;
      tt.appendChild(t);
      for (const [k, v] of [["월 상환액", `${int(r.p)}만원`], ["월소득 대비", `${r.ratio.toFixed(0)}% · ${vLabel(r.ratio)}`], ["평균 시세", won(r.price * 1e4)], ["감당 가능 면적", `${r.maxArea.toFixed(0)}㎡`]]) {
        const row = document.createElement("div");
        row.className = "tt-row";
        row.innerHTML = `<span class="tt-key"></span><span class="tt-val"></span>`;
        row.querySelector(".tt-key")!.textContent = k;
        row.querySelector(".tt-val")!.textContent = v;
        tt.appendChild(row);
      }
      const box = (mapEl.parentElement as HTMLElement).getBoundingClientRect();
      const x = e.clientX - box.left, y = e.clientY - box.top;
      const w = tt.offsetWidth;
      tt.style.left = `${Math.max(0, x + 14 + w > box.width ? x - w - 14 : x + 14)}px`;
      tt.style.top = `${Math.max(0, y - 20)}px`;
      tt.style.opacity = "1";
    });
    p.addEventListener("pointerleave", () => {
      tt.style.opacity = "0";
      highlight(null);
    });
  });

  ["c-income", "c-equity", "c-rate", "c-term", "c-area"].forEach((id) => document.getElementById(id)!.addEventListener("input", calc));
  calc();
</script>
