---
import Base from "../../layouts/Base.astro";
import { SERVICES } from "../../lib/nav";
const docs = import.meta.glob("../../../docs/modules/*.md", { eager: true }) as Record<string, any>;
const bySlug = Object.fromEntries(Object.entries(docs).map(([p, m]) => [p.split("/").pop()!.replace(".md", ""), m]));
const base = import.meta.env.BASE_URL;
// 모듈 문서는 GitHub 에서 단독으로 읽히도록 # 제목을 쓰지만, 이 페이지 안에서는 섹션이므로 한 단계씩 내린다(# → h2)
const demote = (html: string) => html.replace(/<(\/?)h([1-5])\b/g, (_, slash, n) => `<${slash}h${+n + 1}`);
const html = Object.fromEntries(await Promise.all(Object.entries(bySlug).map(async ([k, m]) => [k, demote(await m.compiledContent())])));
---
<Base title="방법론과 한계" active="methodology" description="숫자 너머의 모든 지표가 어떻게 계산되는지 공개합니다. KOSIS OpenAPI 자동 수집, 시군구 지역 표준화, 코호트 요인법 인구 추계, 과거 데이터 검증 오차와 서비스별 한계.">
  <div class="wrap">
    <section class="hero">
      <div class="eyebrow">방법론</div>
      <h1>어떻게 계산했나</h1>
      <p class="lede">이 사이트의 모든 숫자는 통계청 KOSIS OpenAPI에서 자동 수집한 공공 통계로 계산됩니다. 결합 지표와 추계는 이 사이트가 독자적으로 만든 것으로, 국가승인통계나 공식 전망이 아닙니다.</p>
    </section>
    <section class="card method">
      <h2>공통 원칙</h2>
      <ul>
        <li><strong>재현 가능성:</strong> 수집·계산 코드(<code>etl/</code>)를 공개하며, 매월 자동으로 최신 통계를 다시 받아 재계산합니다.</li>
        <li><strong>지역 표준화:</strong> 분석 단위는 2025년 말 기준 시·군·자치구 229곳입니다(일반구·출장소 제외). 2026년 출범한 전남광주통합특별시 자료는 이전 광주·전남 단위로 되돌려 맞췄고, 주민등록(행정코드)과 지방지표(통계용 코드)는 시도와 이름으로 연결했습니다.</li>
        <li><strong>시나리오:</strong> 미래 값은 하나의 예측이 아니라 가정에 따른 범위입니다. 출산율은 통계청 장래인구추계(2022년 기준)의 저위·중위·고위를 따르되 최신 실제 수준에서 출발합니다.</li>
        <li><strong>검증:</strong> 가능한 경우 과거 시점의 데이터만으로 같은 방법을 적용해 실제와 비교한 오차를 공개합니다(예: 학교 추계 1년 후 평균 오차 약 1%, 6년 후 약 8%).</li>
      </ul>
      <h3>공통 인구 추계 엔진</h3>
      <pre class="formula">인구(a세, t+1) = 인구(a−1세, t) × 코호트 변화율(a)
  · 코호트 변화율: 최근 3년(2022→2025) 평균, 작은 지역은 시도 값으로 수축 보정
  · 지역 고유 순이동 효과: 연 ±8% 상한, 매년 15%씩 전국 평균으로 감쇠
0세(t) = 20~44세 여성(t) × 아동비(최근 3년) × 출산율 지수(시나리오, t)</pre>
    </section>
    {SERVICES.map((s) => bySlug[s.slug] && (
      <section class="section card method" id={s.slug}>
        <div class="eyebrow"><a href={`${base}${s.slug}/`}>{s.title} →</a></div>
        <Fragment set:html={html[s.slug]} />
      </section>
    ))}
  </div>
</Base>
