---
import Base from "../../layouts/Base.astro";
import Chart from "../../components/Chart.astro";
import Stat from "../../components/Stat.astro";
import BarList from "../../components/BarList.astro";
import ChartSwitch from "../../components/ChartSwitch.astro";
import KoreaMap from "../../components/KoreaMap.astro";
import data from "../../data/wage.json";
import { pts } from "../../lib/series";
import { int, compact, pct, won } from "../../lib/format";

const d = data as any;
const M = d.meta;
const H = d.headline;
const nat = d.national as any[];
const REF = M.refYear as number;
const BASE = M.baseYear as number;
const LAST = M.lastYear as number;
const ref = nat.find((r) => r.year === REF);
const b = nat.find((r) => r.year === BASE);
const lastRow = nat.find((r) => r.year === LAST);
const estNote = `${LAST}년 임금 ${M.estimate2026.wageMonths}개월·물가 ${M.estimate2026.cpiMonths}개월 자료로 만든 잠정치`;

// 1) 2015=100 지수 비교
const idx = (k: string) => nat.map((r) => [r.year, Math.round((r[k] / ref[k]) * 1000) / 10] as [number, number]);
const lines = [
  { k: "nominal", name: "명목 월급", c: "var(--series-1)" },
  { k: "real", name: "실질 (소비자물가)", c: "var(--series-2)" },
  { k: "realLiving", name: "실질 (생활물가)", c: "var(--series-3)" },
  { k: "netReal", name: "세후 실질", c: "var(--series-7)" },
];
const idxSpec = {
  type: "line" as const,
  yFormat: "int" as const,
  projStart: BASE,
  hLines: [{ y: 100, label: `${REF}=100` }],
  series: lines.map((l) => ({ name: l.name, color: l.c, data: idx(l.k), label: true })),
  height: 340,
};
const idxTable = {
  headers: ["연도", "명목", "실질(CPI)", "실질(생활물가)", "세후 실질"],
  rows: nat.map((r) => [
    `${r.year}${r.estimate ? " (잠정)" : ""}`,
    ...lines.map((l) => (Math.round((r[l.k] / ref[l.k]) * 1000) / 10).toFixed(1)),
  ]),
};

// 2) 실질 월급 수준 (2025년 원)
const lvlSpec = {
  type: "line" as const,
  yFormat: "won" as const,
  projStart: BASE,
  series: [
    { name: "실질 월급 (세전)", color: "var(--series-2)", data: pts(Object.fromEntries(nat.map((r) => [r.year, r.real]))), label: true },
    { name: "실질 월급 (세후)", color: "var(--series-7)", data: pts(Object.fromEntries(nat.map((r) => [r.year, r.netReal]))), label: true },
  ],
  height: 280,
};
const lvlTable = {
  headers: ["연도", "명목 월급", "실질 세전", "세금", "4대보험", "세후 실질", "공제율"],
  rows: nat.map((r) => [`${r.year}${r.estimate ? " (잠정)" : ""}`, int(r.nominal), int(r.real), int(r.tax), int(r.insurance), int(r.netReal), pct(r.burdenRate, 1)]),
};
const peak2021 = nat.find((r) => r.year === 2021);
const stagnant = H.stagnantYears as number[];

// 3) 품목별 구매력 (정책 극단값 제외)
const EXCLUDE: Record<string, string> = { J01101: "유치원납입금" };
const items = (d.items as any[]).filter((i) => !EXCLUDE[i.code] && i.code !== "0" && i.powerChange != null);
const excluded = (d.items as any[]).filter((i) => EXCLUDE[i.code]);
const itemBars = items.map((i) => ({ name: i.name, value: i.powerChange })).sort((a, b) => a.value - b.value);
const worstItem = items.reduce((a, b) => (a.powerChange < b.powerChange ? a : b));
const bestItem = items.reduce((a, b) => (a.powerChange > b.powerChange ? a : b));
const cpiItem = (d.items as any[]).find((i) => i.code === "0");

// 4) 산업·시도
const ind = d.industries as any[];
const indBars = ind.map((r) => ({ name: r.name, value: r.realChange }));
const regs = d.regions as any[];
const reg10 = regs.filter((r) => r.realChange != null).map((r) => ({ name: r.name, value: r.realChange }));
const reg5 = [...regs].sort((a, b) => b.realChange5 - a.realChange5).map((r) => ({ name: r.name, value: r.realChange5 }));
const neg5 = regs.filter((r) => r.realChange5 < 0).map((r) => r.name);

// 5) 2030 시나리오
const S = d.scenarios as any;
const scenNames: Record<string, string> = {
  target: `물가 ${pct(S.target.inflation, 1)} (한국은행 목표)`,
  recent10: `물가 ${pct(S.recent10.inflation, 1)} (최근 10년 평균)`,
  recent5: `물가 ${pct(S.recent5.inflation, 1)} (최근 5년 평균)`,
};
const scenColors: Record<string, string> = { target: "var(--series-3)", recent10: "var(--series-1)", recent5: "var(--series-2)" };
const scenSpec = {
  type: "line" as const,
  yFormat: "won" as const,
  projStart: LAST,
  series: [
    { name: "실질 월급 (실측·잠정)", color: "var(--text-secondary)", data: nat.map((r) => [r.year, r.real] as [number, number]) },
    ...Object.keys(S).map((k) => ({
      name: scenNames[k],
      color: scenColors[k],
      data: Object.entries(S[k].path).map(([y, v]: any) => [+y, v.real] as [number, number]),
      dash: true,
      label: true,
    })),
  ],
  height: 300,
};
const scenTable = {
  headers: ["시나리오", "2030 명목", "2030 실질(세전)", "2030 실질(세후)"],
  rows: Object.keys(S).map((k) => [scenNames[k], int(S[k].path[2030].nominal), int(S[k].path[2030].real), int(S[k].path[2030].net)]),
};
const scenNetGap = S.target.path[2030].net - S.recent5.path[2030].net;

const calcJson = JSON.stringify({ c: d.calculator, last: LAST, base: BASE }).replace(/</g, "\\u003c");
const h1 = `월급은 ${pct(H.nominalChange2015, 0)} 올랐지만, 손에 쥐는 구매력은 ${pct(H.netRealChange2015, 0)} 늘었습니다`;
// ---- 시각화 확장
// 지수: 실질 월급 전년 대비 증감 (막대)
const yoy = nat.slice(1).map((r, i) => ({ y: r.year, v: r.real / nat[i].real - 1, est: r.estimate }));
const yoySpec = {
  type: "column" as const, yFormat: "pct1" as const, height: 340,
  categories: yoy.map((r) => `${r.y}${r.est ? "*" : ""}`),
  values: yoy.map((r) => Math.round(r.v * 10000) / 10000),
  colors: yoy.map((r) => (r.v < 0 ? "var(--div-neg)" : "var(--div-pos)")),
};
const yoyNomSpec = {
  type: "column" as const, yFormat: "pct1" as const, height: 340,
  categories: yoy.map((r) => `${r.y}${r.est ? "*" : ""}`),
  values: nat.slice(1).map((r, i) => Math.round((r.nominal / nat[i].nominal - 1) * 10000) / 10000),
};
// 월급 구성 (명목): 세후 실수령 + 세금 + 4대보험
const compSpec = {
  type: "stack" as const, yFormat: "won" as const, height: 280,
  categories: nat.map((r) => `${r.year}${r.estimate ? "*" : ""}`),
  projFrom: nat.findIndex((r) => r.estimate),
  series: [
    { name: "실수령 (세후)", color: "var(--series-1)", values: nat.map((r) => r.net) },
    { name: "4대보험", color: "var(--series-4)", values: nat.map((r) => r.insurance) },
    { name: "소득세·지방세", color: "var(--series-2)", values: nat.map((r) => r.tax) },
  ],
};
const burdenRateSpec = {
  type: "line" as const, yFormat: "pct1" as const, height: 280, projStart: BASE, zeroBased: true,
  series: [{ name: "세금+4대보험 ÷ 월급", color: "var(--series-2)", data: nat.map((r) => [r.year, r.burdenRate] as [number, number]), label: true, fill: true }],
};
// 품목 구매력 레이스 (REF=100)
const raceItems = (d.items as any[]).filter((i) => !EXCLUDE[i.code] && i.power);
const raceYears = Object.keys(raceItems[0].power).map(Number).filter((y) => y >= REF);
const raceSpec = {
  type: "race" as const, top: raceItems.length, speed: 750, format: "int" as const,
  start: raceYears.length - 1, projFrom: raceYears.indexOf(LAST),
  names: raceItems.map((i) => (i.code === "0" ? "물가 전체 (기준)" : i.name)),
  colors: raceItems.map((i) => (i.code === "0" ? "var(--neutral-series)" : i.powerChange < 0 ? "var(--div-neg)" : "var(--div-pos)")),
  frames: raceYears.map((y) => ({ label: y, values: raceItems.map((i) => i.power[y] ?? null) })),
};
const pickItems = ["김밥", "커피(외식)", "휴대전화료", "전세", "휘발유", "총지수"];
const pickColors = ["var(--series-2)", "var(--series-4)", "var(--series-3)", "var(--series-1)", "var(--series-5)", "var(--neutral-series)"];
const itemLineSpec = {
  type: "line" as const, yFormat: "int" as const, height: 360, projStart: BASE,
  hLines: [{ y: 100, label: `${REF}=100` }],
  series: pickItems.map((n, k) => {
    const it = (d.items as any[]).find((i) => i.name === n)!;
    return { name: n === "총지수" ? "물가 전체" : n, color: pickColors[k], data: Object.entries(it.power).filter(([y]) => +y >= 2011).map(([y, v]: any) => [+y, v] as [number, number]), label: true, width: n === "총지수" ? 1.5 : 2 };
  }),
};
// 산업: 2015 실질 수준 × 변화율
const indScatter = {
  type: "scatter" as const, height: 380,
  xLabel: `${REF}년 실질 상용임금`, yLabel: `${REF}→${BASE} 실질 변화`, xFormat: "won" as const, yFormat: "pctS" as const,
  yRef: H.realChange2015,
  labels: (() => {
    const byY = [...ind].sort((a, b) => b.realChange - a.realChange);
    const byX = [...ind].sort((a, b) => b.real2015 - a.real2015);
    return [...new Set([...byY.slice(0, 2), ...byY.slice(-2), ...byX.slice(0, 2)].map((r) => r.name))];
  })(),
  points: ind.map((r) => ({ x: r.real2015, y: r.realChange, label: r.name, color: r.realChange < H.realChange2015 ? "var(--series-2)" : "var(--series-1)", note: `${won(r.real2015)} → ${won(r.real2025)}` })),
};
// 시도 지도
const regNames = Object.fromEntries(regs.map((r) => [r.code, r.name]));
const regYears = Object.keys(regs[0].series).map(Number).filter((y) => y >= REF);
const yrs5 = regYears.filter((y) => y >= BASE - 5);
const wageMap = [
  { key: "real10", label: `실질 변화 (${REF} 대비)`, format: "pctS" as const, kind: "div" as const, breaks: [-0.05, 0, 0.05, 0.1, 0.15, 0.2],
    desc: `${REF}년 대비 실질 상용임금 변화 (각 시도 물가로 디플레이트). ▶ 로 해마다 벌어지는 차이를 재생합니다. 세종은 2020년부터 자료가 있습니다.`,
    frames: { labels: regYears, values: regYears.map((y) => Object.fromEntries(regs.map((r) => [r.code, r.series[REF] && r.series[y] ? r.series[y] / r.series[REF] - 1 : null]))), start: regYears.length - 1 } },
  { key: "real5", label: `최근 5년 (${BASE - 5} 대비)`, format: "pct1S" as const, kind: "div" as const, breaks: [-0.04, -0.02, 0, 0.02, 0.04, 0.06],
    desc: `고물가 시기를 포함한 최근 5년. 실질임금이 줄어든 곳: ${neg5.join(", ") || "없음"}.`,
    frames: { labels: yrs5, values: yrs5.map((y) => Object.fromEntries(regs.map((r) => [r.code, r.series[BASE - 5] && r.series[y] ? r.series[y] / r.series[BASE - 5] - 1 : null]))), start: yrs5.length - 1 } },
  { key: "level", label: "실질 월급 수준", format: "won" as const, kind: "seq" as const, breaks: [3.0e6, 3.3e6, 3.6e6, 3.9e6, 4.2e6, 4.5e6],
    desc: `상용근로자 월평균 임금, ${BASE}년 원화 가치.`,
    frames: { labels: regYears, values: regYears.map((y) => Object.fromEntries(regs.map((r) => [r.code, r.series[y] ?? null]))), start: regYears.length - 1 } },
];
const simJson = JSON.stringify({
  hist: nat.map((r) => [r.year, r.real]), last: LAST, lastReal: lastRow.real, base: BASE, bReal: b.real,
  g: H.wageCagr5, pi: H.cpiCagr5, scen: Object.fromEntries(Object.keys(S).map((k) => [k, Object.entries(S[k].path).map(([y, v]: any) => [+y, v.real])])),
  names: scenNames, colors: scenColors,
}).replace(/</g, "\\u003c");

---
<Base title="내 월급의 실질 가치" active="wage" description={`임금·물가·주거비·세금 통계를 결합한 실질 구매력 비교. ${REF}→${BASE}년 평균 월급은 명목 ${pct(H.nominalChange2015, 0, true)}, 세후 실질 ${pct(H.netRealChange2015, 0, true)}.`}>
  <div class="wrap">
    <section class="hero">
      <div class="eyebrow">내 월급의 실질 가치 · 임금 × 물가 × 주거비 × 세금</div>
      <h1>{h1}</h1>
      <p class="lede">
        고용노동부 평균 임금에 소비자물가·생활물가·주거비 지수, 그리고 연도별 세법과 4대보험 요율을 결합했습니다.{" "}
        {REF}년 평균 월급 {won(ref.nominal)}은 {BASE}년 {won(b.nominal)}이 되었지만, 물가와 세금·보험료를 빼고 나면 실제로 늘어난 구매력은 훨씬 작습니다.
      </p>
    </section>

    <div class="grid grid-4">
      <Stat label={`명목 월급 ${REF}→${BASE}`} value={pct(H.nominalChange2015, 1, true)} note={`${won(ref.nominal)} → ${won(b.nominal)}`} />
      <Stat label="실질 (소비자물가 기준)" value={pct(H.realChange2015, 1, true)} note={`생활물가 기준 ${pct(H.realLivingChange2015, 1, true)}`} />
      <Stat label="세후 실질 월급" value={pct(H.netRealChange2015, 1, true)} note="세금·4대보험 근로자 부담분 차감 후" />
      <Stat label={`세금+보험료 비중 ${BASE}`} value={pct(H.burden2025, 1)} note={`${REF}년 ${pct(H.burden2015, 1)}에서 상승 (평균 월급 기준)`} tone="down" />
    </div>

    <section class="section">
      <h2>같은 월급, 다른 잣대</h2>
      <p class="section-desc">
        {REF}년을 100으로 둔 지수입니다. 명목 월급과 실질 월급 사이의 간격이 물가가 가져간 몫이고, 실질과 세후 실질 사이의 간격이 누진세와 보험료 인상이 가져간 몫입니다.
        오른쪽 음영 구간은 {estNote}입니다.
      </p>
      <ChartSwitch views={[
        { label: "지수", spec: idxSpec },
        { label: "실질 증감률", spec: yoySpec, note: "실질 월급(소비자물가 기준)의 전년 대비 변화. 빨간 막대는 월급이 물가를 따라가지 못한 해입니다. * 잠정" },
        { label: "명목 증감률", spec: yoyNomSpec, note: "명목 월급의 전년 대비 변화. 실질 증감률과 비교하면 물가가 가져간 몫이 보입니다. * 잠정" },
      ]} table={idxTable} title={`평균 월급 지수 (${REF}=100)`} sub="1인 이상 사업체 전체 근로자 월평균 임금총액 · 같은 데이터를 지수 선 / 연간 증감률 막대로 바꿔 볼 수 있습니다" />
    </section>

    <section class="section grid grid-2">
      <ChartSwitch views={[
        { label: "실질 월급", spec: lvlSpec },
        { label: "월급 구성", spec: compSpec, note: "명목 월급이 실수령·4대보험·세금으로 나뉘는 모습 (그해 원화). * 잠정" },
        { label: "공제율", spec: burdenRateSpec },
      ]} table={lvlTable} title={`실질 월급 (${BASE}년 원화 가치)`} sub="세전 / 세금·4대보험 차감 후" />
      <div class="card insight">
        <h3 class="card-title">실질임금이 멈췄던 3년</h3>
        <p>
          고물가가 덮친 {stagnant.join("·")}년, 평균 실질 월급은 {2021}년 수준({won(peak2021.real)})을 한 번도 넘지 못했습니다.{" "}
          {BASE}년에야 {won(b.real)}으로 겨우 회복했습니다.
        </p>
        <p>
          세후로 보면 더 뚜렷합니다. 세후 실질 월급은 {2021}년 {won(peak2021.netReal)}, {BASE}년 {won(b.netReal)}으로 4년 동안 사실상 제자리입니다.{" "}
          명목 소득이 오르면 더 높은 세율 구간에 들어가는데(누진세), 과세표준 구간은 거의 그대로였기 때문입니다.
        </p>
        <p class="small muted">자가주거비포함 물가로 재면 {REF}→{BASE} 실질 상승은 {pct(H.realOwnHousingChange2015, 1, true)}입니다. 집값·임대료의 체감은 지역과 점유 형태(자가·전세·월세)에 따라 크게 다릅니다.</p>
      </div>
    </section>

    <section class="section card" id="calc">
      <h2 style="margin-top:0">그때 그 연봉, 지금은 얼마?</h2>
      <p class="section-desc">연도와 그해 연봉을 넣으면 같은 구매력을 갖기 위해 지금 필요한 연봉을 세 가지 잣대로 계산합니다. 세후 비교는 그해와 {LAST}년 세법·보험료율을 각각 적용한 간이 계산입니다.</p>
      <div class="controls">
        <label class="field">연도
          <select id="c-year"></select>
        </label>
        <label class="field">그해 연봉 (만원)
          <input id="c-pay" type="number" inputmode="numeric" min="100" max="100000" step="100" value="3000" />
        </label>
      </div>
      <div class="grid grid-4" id="c-out" style="margin-top:16px">
        <div class="stat"><div class="stat-label">소비자물가 기준</div><div class="stat-value" id="o-cpi">–</div><div class="stat-note" id="n-cpi"></div></div>
        <div class="stat"><div class="stat-label">생활물가 기준</div><div class="stat-value" id="o-life">–</div><div class="stat-note" id="n-life"></div></div>
        <div class="stat"><div class="stat-label">평균 임금 대비 같은 위치</div><div class="stat-value" id="o-wage">–</div><div class="stat-note" id="n-wage"></div></div>
        <div class="stat"><div class="stat-label">세후 구매력 유지에 필요한 세전 연봉</div><div class="stat-value" id="o-net">–</div><div class="stat-note" id="n-net"></div></div>
      </div>
      <div class="grid grid-2 calc-viz" style="margin-top:16px">
        <div>
          <h3 class="card-title">같은 구매력에 필요한 연봉</h3>
          <p class="card-sub">그해 연봉과 지금 필요한 연봉 비교</p>
          <div class="cmp-bars" id="c-bars" role="list"></div>
        </div>
        <div>
          <h3 class="card-title">해마다 필요했던 연봉</h3>
          <p class="card-sub" id="c-path-sub">그해 연봉을 물가·평균 임금만큼 올렸다면</p>
          <div class="chart" id="c-path"></div>
        </div>
      </div>
      <p class="small muted" style="margin-top:12px" id="c-foot"></p>
      <script type="application/json" id="calc-data" set:html={calcJson} />
    </section>

    <section class="section">
      <h2>월급으로 살 수 있는 양은 어떻게 변했나</h2>
      <p class="section-desc">
        같은 비율의 평균 월급으로 그 품목을 {REF}년보다 몇 % 더(덜) 살 수 있는지입니다. (임금 상승률 ÷ 품목 가격 상승률) − 1.{" "}
        {worstItem.name}은 가격이 {pct(worstItem.priceChange, 0, true)} 올라 구매력이 {pct(worstItem.powerChange, 1, true)}, {bestItem.name}은(는) {pct(bestItem.powerChange, 0, true)}입니다.
        물가 전체(총지수)로는 {pct(cpiItem.powerChange, 1, true)}.
      </p>
      <ChartSwitch views={[
        { label: "구매력 레이스", spec: raceSpec, note: `${REF}=100. ▶ 를 누르면 해마다 순위가 바뀌는 모습을 재생합니다. 파란 막대는 ${LAST}년까지 구매력이 늘어난 품목, 빨간 막대는 줄어든 품목, 회색은 물가 전체입니다.` },
        { label: "추이", spec: itemLineSpec, note: "대표 품목의 구매력 지수 추이. 100 아래로 내려가면 같은 월급으로 그 품목을 덜 살 수 있다는 뜻입니다." },
      ]} id="items" title="품목별 구매력 지수" sub={`평균 월급으로 살 수 있는 양, ${REF}=100`} />
      <div class="card" style="margin-top:16px">
        <h3 class="card-title">{REF}→{LAST} 구매력 변화</h3>
        <p class="card-sub">(임금 상승률 ÷ 품목 가격 상승률) − 1</p>
        <BarList items={itemBars} format="pct1" diverging />
        <p class="small muted" style="margin-top:12px">
          제외: {excluded.map((i) => `${i.name}(가격지수 ${pct(i.priceChange, 0, true)}, 무상보육·유아교육 지원 확대에 따른 정책 효과)`).join(", ")}. 가격지수 기반의 상대 비교이며 절대 가격(원)이 아닙니다.
        </p>
      </div>
    </section>

    <section class="section">
      <h2>어디서, 어떤 일을 하느냐에 따라</h2>
      <p class="section-desc">시도별 실질 상용임금은 각 시도의 소비자물가로 나눠 계산했습니다. 지표를 바꾸거나 ▶ 로 {REF}년부터의 변화를 재생해 보세요.</p>
      <KoreaMap level="sido" metrics={wageMap} names={regNames} title="시도별 실질 상용임금" sub={`e-지방지표 시도별 상용근로자 월평균 임금 ÷ 시도 소비자물가 (${BASE}년 원화)`} />
      <div class="grid grid-2" style="margin-top:16px">
        <figure class="card" style="margin:0">
          <h3 class="card-title">임금이 높던 산업이 더 올랐나?</h3>
          <p class="card-sub">가로: {REF}년 실질 상용임금 · 세로: {REF}→{BASE} 실질 변화 · 점선: 전체 평균({pct(H.realChange2015, 1, true)})</p>
          <div class="chart" data-chart><script type="application/json" set:html={JSON.stringify(indScatter).replace(/</g, "\\u003c")} /></div>
        </figure>
        <div class="card">
          <h3 class="card-title">산업별 실질 상용임금 변화</h3>
          <p class="card-sub">{REF} → {BASE}, 소비자물가 기준</p>
          <BarList items={indBars} format="pct" diverging />
        </div>
      </div>
    </section>

    <section class="section">
      <h2>2030년, 실질 월급은?</h2>
      <p class="section-desc">
        예측이 아닌 시나리오입니다. 명목 월급은 최근 5년 연평균 증가율({pct(H.wageCagr5, 1)})이 이어진다고 두고 물가만 바꿨습니다.
        최근 5년 같은 고물가({pct(S.recent5.inflation, 1)})가 계속되면 2030년 세후 실질 월급은 {won(S.recent5.path[2030].net)}로 {BASE}년({won(b.netReal)})과 거의 같고,
        물가가 목표치 2%로 안정되면 {won(S.target.path[2030].net)}입니다. 물가 1%p 남짓의 차이가 세후 월 {won(scenNetGap)}의 차이를 만듭니다.
      </p>
      <Chart spec={scenSpec} table={scenTable} title={`실질 월급 시나리오 (${BASE}년 원화, 세전)`} sub="점선: 물가 가정별 경로" />
      <div class="card" id="wsim" style="margin-top:16px">
        <h3 class="card-title">직접 정해 보는 2030년</h3>
        <p class="card-sub">명목 임금 상승률과 물가 상승률을 바꾸면 실질 월급 경로를 다시 계산합니다 (세전, {BASE}년 원화).</p>
        <div class="sim">
          <div class="sim-controls">
            <div class="slider">
              <div class="slider-top"><label for="w-g">명목 임금 상승률 (연)</label><output id="w-og"></output></div>
              <input type="range" id="w-g" min="0" max="0.07" step="0.0025" value={H.wageCagr5.toFixed(4)} />
              <div class="slider-hint"><span>0%</span><span>최근 5년 {pct(H.wageCagr5, 1)}</span><span>7%</span></div>
            </div>
            <div class="slider">
              <div class="slider-top"><label for="w-pi">물가 상승률 (연)</label><output id="w-opi"></output></div>
              <input type="range" id="w-pi" min="0" max="0.07" step="0.0025" value={H.cpiCagr5.toFixed(4)} />
              <div class="slider-hint"><span>0%</span><span>목표 2%</span><span>7%</span></div>
            </div>
            <div class="sim-out" id="w-out"></div>
          </div>
          <div class="chart" id="w-chart"></div>
        </div>
        <script type="application/json" id="wsim-data" set:html={simJson} />
      </div>
    </section>

    <section class="section card method" id="method">
      <h2>방법론</h2>
      <h3>1. 실질임금</h3>
      <p>고용노동부 사업체노동력조사의 1인 이상 사업체 전체 근로자 월평균 임금총액({M.firstYear}년~)을 물가지수로 나눠 {BASE}년 원화 가치로 환산했습니다. 물가 잣대는 소비자물가지수(CPI), 자주 사는 품목만 모은 생활물가지수, 자가 거주자의 주거비까지 넣은 자가주거비포함지수 세 가지입니다.</p>
      <pre class="formula">실질 월급(t) = 명목 월급(t) × 물가지수({BASE}) ÷ 물가지수(t)</pre>
      <h3>2. 세후 월급 (간이 계산)</h3>
      <p>연도별 소득세법(근로소득공제·세율 구간·근로소득세액공제·표준세액공제)과 국민연금·건강보험·장기요양·고용보험 근로자 부담 요율을 코드로 구현했습니다. {M.assumptions} 실제 원천징수액은 부양가족, 비과세 수당, 각종 공제에 따라 달라집니다.</p>
      <h3>3. 품목별 구매력</h3>
      <pre class="formula">구매력 지수(t) = [임금(t) ÷ 임금({REF})] ÷ [품목 가격지수(t) ÷ 품목 가격지수({REF})] × 100</pre>
      <p>산업별은 상용근로자 임금총액을 전국 소비자물가로, 시도별은 e-지방지표 시도별 상용 월평균 임금을 각 시도 소비자물가로 나눴습니다.</p>
      <h3>4. 2030 시나리오와 {LAST}년 잠정치</h3>
      <p>명목 임금은 {BASE - 5}~{BASE}년 연평균 증가율을 유지한다고 두고, 물가는 한국은행 목표 2%, 최근 10년 평균({pct(H.cpiCagr10, 1)}), 최근 5년 평균({pct(H.cpiCagr5, 1)}) 세 가지로 가정했습니다. 세후는 {LAST}년 세법·요율을 고정해 명목소득이 오를수록 세 부담이 커지는 효과가 반영됩니다. {estNote}이며, 전년 같은 달 대비 증가율을 {BASE}년 연간값에 적용했습니다.</p>
      <h3>한계</h3>
      <ul>
        <li>평균 임금은 고임금자와 산업 구성 변화의 영향을 받습니다. 중위 임금이 아닙니다.</li>
        <li>세금 계산은 1인·최소 공제 가정이며, 연중 바뀐 요율과 국민연금 상한은 연 단위로 근사했습니다.</li>
        <li>품목 구매력은 가격지수 기반의 상대값입니다. 주거비 체감은 지역과 점유 형태에 따라 크게 다릅니다.</li>
      </ul>
      <h3>데이터 출처</h3>
      <ul>{M.sources.map((s: string) => <li>{s}</li>)}</ul>
    </section>
  </div>
</Base>

<script>
  import { mount } from "../../lib/charts";
  type Calc = {
    c: { cpi: Record<string, number>; living: Record<string, number>; wage: Record<string, number>; taxTable: Record<string, Record<string, number>> };
    last: number;
    base: number;
  };
  const D: Calc = JSON.parse(document.getElementById("calc-data")!.textContent || "{}");
  const C = D.c;
  const LAST = String(D.last);
  const yearSel = document.getElementById("c-year") as HTMLSelectElement;
  const payIn = document.getElementById("c-pay") as HTMLInputElement;
  const years = Object.keys(C.cpi).map(Number).filter((y) => y < D.last).sort((a, b) => b - a);
  for (const y of years) {
    const o = document.createElement("option");
    o.value = String(y);
    o.textContent = `${y}년`;
    if (y === 2015) o.selected = true;
    yearSel.appendChild(o);
  }
  const nf = new Intl.NumberFormat("ko-KR", { maximumFractionDigits: 0 });
  const man = (won: number) => `${nf.format(Math.round(won / 1e4))}만원`;

  // 세후 월급표(월 200~1000만원 격자)를 선형 보간
  const grid = Object.keys(C.taxTable).map(Number).sort((a, b) => a - b);
  function netMonthly(grossMonthly: number, year: string): number | null {
    const g = grossMonthly / 1e4;
    const col = (m: number) => C.taxTable[String(m)]?.[year];
    if (col(grid[0]) == null) return null;
    const ratio = (m: number) => col(m)! / (m * 1e4);
    if (g <= grid[0]) return grossMonthly * ratio(grid[0]);
    if (g >= grid[grid.length - 1]) return grossMonthly * ratio(grid[grid.length - 1]);
    for (let i = 0; i < grid.length - 1; i++) {
      const a = grid[i], b = grid[i + 1];
      if (g >= a && g <= b) {
        const t = (g - a) / (b - a);
        return grossMonthly * (ratio(a) * (1 - t) + ratio(b) * t);
      }
    }
    return null;
  }
  function grossForNet(targetNet: number, year: string): number {
    let lo = targetNet, hi = targetNet * 2.5;
    for (let i = 0; i < 60; i++) {
      const mid = (lo + hi) / 2;
      (netMonthly(mid, year) ?? 0) < targetNet ? (lo = mid) : (hi = mid);
    }
    return (lo + hi) / 2;
  }
  const set = (id: string, t: string) => ((document.getElementById(id) as HTMLElement).textContent = t);

  function update() {
    const y = yearSel.value;
    const pay = Math.max(Number(payIn.value) || 0, 0) * 1e4;
    if (!pay) return;
    const cpi = (pay * C.cpi[LAST]) / C.cpi[y];
    set("o-cpi", man(cpi));
    set("n-cpi", `물가 ${((C.cpi[LAST] / C.cpi[y] - 1) * 100).toFixed(1)}% 상승`);
    if (C.living[y]) {
      set("o-life", man((pay * C.living[LAST]) / C.living[y]));
      set("n-life", `장바구니 물가 ${((C.living[LAST] / C.living[y] - 1) * 100).toFixed(1)}% 상승`);
    } else {
      set("o-life", "–");
      set("n-life", "생활물가지수는 1995년부터");
    }
    if (C.wage[y]) {
      set("o-wage", man((pay * C.wage[LAST]) / C.wage[y]));
      set("n-wage", `평균 월급 ${((C.wage[LAST] / C.wage[y] - 1) * 100).toFixed(1)}% 상승`);
    } else {
      set("o-wage", "–");
      set("n-wage", "임금 통계는 2011년부터");
    }
    const netThen = netMonthly(pay / 12, y);
    if (netThen != null) {
      const needNet = (netThen * C.cpi[LAST]) / C.cpi[y];
      const gross = grossForNet(needNet, LAST) * 12;
      set("o-net", man(gross));
      set("n-net", `그해 세후 월 ${man(netThen)} → 지금 세후 월 ${man(needNet)} 필요`);
    } else {
      set("o-net", "–");
      set("n-net", "세후 계산은 2011년부터");
    }
    set("c-foot", `${y}년 연봉 ${man(pay)} 기준. ${LAST}년 값은 잠정치. 세후는 부양가족 없는 1인 근로자 간이 계산.`);
    const ntn = netMonthly(pay / 12, y);
    (window as any).__wageViz?.(
      {
        then: pay,
        cpi,
        life: C.living[y] ? (pay * C.living[LAST]) / C.living[y] : null,
        wage: C.wage[y] ? (pay * C.wage[LAST]) / C.wage[y] : null,
        net: ntn != null ? grossForNet((ntn * C.cpi[LAST]) / C.cpi[y], LAST) * 12 : null,
      },
      y,
      pay,
    );
  }
  yearSel.addEventListener("change", update);
  payIn.addEventListener("input", update);

  // ---------- 계산기 시각화
  const barsEl = document.getElementById("c-bars")!;
  const pathEl = document.getElementById("c-path")!;
  const BAR_DEFS = [
    { k: "then", name: "그해 연봉 (명목)", color: "var(--neutral-series)" },
    { k: "cpi", name: "소비자물가만큼", color: "var(--series-2)" },
    { k: "life", name: "생활물가만큼", color: "var(--series-3)" },
    { k: "wage", name: "평균 임금만큼", color: "var(--series-1)" },
    { k: "net", name: "세후 구매력 유지", color: "var(--series-7)" },
  ];
  const barRows = BAR_DEFS.map((b) => {
    const r = document.createElement("div");
    r.className = "cmp-row";
    r.setAttribute("role", "listitem");
    r.innerHTML = `<span class="cmp-name"></span><span class="cmp-track"><span class="cmp-fill"></span></span><span class="cmp-val"></span>`;
    r.querySelector(".cmp-name")!.textContent = b.name;
    (r.querySelector(".cmp-fill") as HTMLElement).style.background = b.color;
    barsEl.appendChild(r);
    return r;
  });
  (window as any).__wageViz = (vals: Record<string, number | null>, y: string, pay: number) => {
    const max = Math.max(...Object.values(vals).map((v) => v ?? 0), 1);
    BAR_DEFS.forEach((b, i) => {
      const v = vals[b.k];
      const r = barRows[i];
      r.hidden = v == null;
      (r.querySelector(".cmp-fill") as HTMLElement).style.width = v == null ? "0" : `${(v / max) * 100}%`;
      r.querySelector(".cmp-val")!.textContent = v == null ? "–" : man(v);
    });
    const ys = Object.keys(C.cpi).map(Number).filter((t) => t >= Number(y) && t <= D.last);
    const series: any[] = [
      { name: "소비자물가만큼", color: "var(--series-2)", data: ys.map((t) => [t, (pay * C.cpi[t]) / C.cpi[y]]), label: true },
    ];
    if (C.wage[y]) series.push({ name: "평균 임금만큼", color: "var(--series-1)", data: ys.filter((t) => C.wage[t]).map((t) => [t, (pay * C.wage[t]) / C.wage[y]]), label: true });
    if (ys.length > 1) mount(pathEl, { type: "line", yFormat: "won", height: 220, zeroBased: false, animate: false, series } as any);
    else pathEl.textContent = "";
  };
  update();

  // ---------- 2030 시뮬레이터
  const W = JSON.parse(document.getElementById("wsim-data")!.textContent || "{}");
  const gIn = document.getElementById("w-g") as HTMLInputElement;
  const piIn = document.getElementById("w-pi") as HTMLInputElement;
  const wOut = document.getElementById("w-out")!;
  const wChart = document.getElementById("w-chart")!;
  const pctTxt = (v: number, d = 1) => `${v > 0 ? "+" : ""}${(v * 100).toFixed(d)}%`;
  function wsim() {
    const g = +gIn.value, pi = +piIn.value;
    (document.getElementById("w-og") as HTMLElement).textContent = (g * 100).toFixed(2).replace(/0$/, "") + "%";
    (document.getElementById("w-opi") as HTMLElement).textContent = (pi * 100).toFixed(2).replace(/0$/, "") + "%";
    const path: [number, number][] = [[W.last, W.lastReal]];
    for (let t = W.last + 1; t <= 2030; t++) path.push([t, W.lastReal * Math.pow((1 + g) / (1 + pi), t - W.last)]);
    const v30 = path[path.length - 1][1];
    wOut.innerHTML = "";
    for (const [k, v, n] of [
      ["2030 실질 월급", man(v30), `${W.base}년 대비 ${pctTxt(v30 / W.bReal - 1)}`],
      ["실질 증가율 (연)", pctTxt((1 + g) / (1 + pi) - 1, 2), g < pi ? "월급이 물가를 못 따라감" : "월급이 물가보다 빠름"],
    ]) {
      const el = document.createElement("div");
      el.className = "stat";
      el.innerHTML = `<div class="stat-label"></div><div class="stat-value"></div><div class="stat-note"></div>`;
      el.querySelector(".stat-label")!.textContent = k;
      el.querySelector(".stat-value")!.textContent = v;
      el.querySelector(".stat-note")!.textContent = n;
      if (k.startsWith("실질 증가율")) (el.querySelector(".stat-value") as HTMLElement).className = `stat-value ${g < pi ? "delta-down" : "delta-up"}`;
      wOut.appendChild(el);
    }
    mount(wChart, {
      type: "line", yFormat: "won", height: 300, zeroBased: false, projStart: W.last, animate: false,
      series: [
        { name: "실측·잠정", color: "var(--text-secondary)", data: W.hist.filter((p: any) => p[0] >= 2015) },
        ...Object.keys(W.scen).map((k) => ({ name: W.names[k], color: W.colors[k], dash: true, width: 1.5, muted: true, data: [[W.last, W.lastReal], ...W.scen[k]] })),
        { name: "내 가정", color: "var(--text-primary)", data: path, label: true, width: 2.5 },
      ],
    } as any);
  }
  gIn.addEventListener("input", wsim);
  piIn.addEventListener("input", wsim);
  wsim();
</script>

