---
import "../styles/global.css";
import { SERVICES, NAV_GROUPS, pageTitle } from "../lib/nav";
import { ogKey } from "../lib/og";
import updated from "../data/updated.json";
interface Props {
  title: string;
  description?: string;
  active?: string;
  noindex?: boolean;
}
const { noindex = false, title, description = "통계청 KOSIS 공공 통계를 결합해 기존에 없던 지표와 시나리오 기반 미래 추계를 만듭니다.", active } = Astro.props;
const base = import.meta.env.BASE_URL;
const fullTitle = title === "홈" ? "숫자 너머 — 공공 통계로 보는 대한민국의 미래" : `${title} | 숫자 너머`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`${base}og/${noindex ? "index" : ogKey(Astro.url.pathname, base)}.png`, Astro.site).href;
const home = new URL(base, Astro.site).href;
const svc = SERVICES.find((s) => s.slug === active);
// 검색 결과용 구조화 데이터: 홈은 WebSite, 나머지는 이동 경로(BreadcrumbList)
const crumbs = [{ name: "숫자 너머", url: home }];
if (active === "methodology") crumbs.push({ name: "방법론과 한계", url: canonical });
else if (active === "glossary") crumbs.push({ name: "용어 사전", url: canonical });
else if (active === "changes") crumbs.push({ name: "수정 이력", url: canonical });
else if (svc) {
  const svcUrl = new URL(`${base}${svc.slug}/`, Astro.site).href;
  crumbs.push({ name: svc.name, url: svcUrl });
  if (svcUrl !== canonical) crumbs.push({ name: title, url: canonical });
}
const ld = title === "홈"
  ? { "@context": "https://schema.org", "@type": "WebSite", name: "숫자 너머", alternateName: "stats.euiyun.com", url: home, inLanguage: "ko", description }
  : { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: crumbs.map((c, i) => ({ "@type": "ListItem", position: i + 1, name: c.name, item: c.url })) };
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Google Tag Manager -->
    <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-MCRXH58R"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      dataLayer.push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Euiyun Lab" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content="숫자 너머" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <meta name="theme-color" content="#f9f9f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0d0d" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      try {
        const t = localStorage.getItem("theme");
        if (t) document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body id="top" data-updated={updated.updated} data-page-title={title === "홈" ? "숫자 너머" : svc && title === pageTitle(svc.slug) ? svc.name : title}>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={base}>
          <svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="13" width="4" height="9" rx="1.5" fill="var(--series-1)"></rect><rect x="10" y="8" width="4" height="14" rx="1.5" fill="var(--series-1)" opacity="0.7"></rect><path d="M17 3 L22 3 L22 8" fill="none" stroke="var(--series-2)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path><path d="M14 11 L22 3" fill="none" stroke="var(--series-2)" stroke-width="2.2" stroke-linecap="round" stroke-dasharray="3 2.4"></path></svg>
          숫자 너머
        </a>
        <nav class="nav" id="site-nav" aria-label="서비스">
          {NAV_GROUPS.map((g) => {
            const items = g.slugs.map((sl) => SERVICES.find((s) => s.slug === sl)!);
            const here = items.some((s) => s.slug === active);
            return (
              <details class="nav-group" data-nav-group>
                <summary class={here ? "is-here" : undefined}>{g.title}<svg class="nav-caret" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5 5 6.5 8 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></summary>
                <div class="nav-panel">
                  {items.map((s) => (
                    <a href={`${base}${s.slug}/`} aria-current={active === s.slug ? "page" : undefined}>
                      <span class="nav-item-title">{s.name}</span>
                      <span class="nav-item-desc">{s.desc}</span>
                    </a>
                  ))}
                </div>
              </details>
            );
          })}
          <span class="nav-sep" aria-hidden="true"></span>
          <a class="nav-link" href={`${base}map/`} aria-current={active === "map" ? "page" : undefined}>지도</a>
          <a class="nav-link" href={`${base}track/`} aria-current={active === "track" ? "page" : undefined}>성적표</a>
          <a class="nav-link" href={`${base}methodology/`} aria-current={active === "methodology" || active === "glossary" || active === "changes" ? "page" : undefined}>방법론</a>
        </nav>
        <button class="menu-btn" type="button" aria-controls="site-nav" aria-expanded="false" id="menu-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
          <span id="menu-label">메뉴</span>
        </button>
        <div class="born" id="born">
          <button class="born-btn" type="button" id="born-btn" aria-haspopup="dialog" aria-expanded="false" aria-controls="born-pop" title="내 정보: 페이지마다 내 나이·동네에 맞춘 숫자를 함께 보여 줍니다">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="3.6"></circle><path d="M4.5 20.5c1.2-3.8 4-5.6 7.5-5.6s6.3 1.8 7.5 5.6"></path></svg>
            <span class="born-label" id="born-label" data-born-text="내 정보"></span><span class="born-region" id="born-region" data-born-text=""></span>
          </button>
          <script is:inline>
            // 깜빡임 없이 칩 글자를 먼저 채운다 (자세한 검사는 lib/profile.ts)
            try {
              let p = JSON.parse(localStorage.getItem("profile") || "null");
              if (!p) { const b = Number(localStorage.getItem("born")); p = b ? { born: b } : {}; }
              const lb = document.getElementById("born-label");
              if (p.born >= 1920 && p.born <= new Date().getFullYear()) lb.dataset.bornText = p.born + "년생";
              else if (p.region && p.region.name) lb.dataset.bornText = "내 정보";
              if (p.region && p.region.name) document.getElementById("born-region").dataset.bornText = p.region.name;
              if (p.born || p.region) document.getElementById("born").classList.add("is-set");
            } catch (e) {}
          </script>
          <div class="born-hint" id="born-hint" role="status" hidden>
            <p><strong>내 정보를 알려 주세요</strong>출생연도와 사는 곳을 넣으면 모든 페이지의 통계를 내 나이·내 동네 기준으로 보여 드립니다. 이 브라우저에만 저장됩니다.</p>
            <div class="born-hint-act">
              <button type="button" class="born-save" id="born-hint-yes">입력하기</button>
              <button type="button" class="born-clear" id="born-hint-no">괜찮아요</button>
            </div>
          </div>
          <div class="born-pop" id="born-pop" role="dialog" aria-labelledby="born-pop-title" hidden>
            <form id="born-form" autocomplete="off">
              <p class="born-title" id="born-pop-title">내 정보</p>
              <label class="born-field">출생연도
                <input id="born-input" type="number" inputmode="numeric" min="1920" max={String(new Date().getFullYear())} step="1" placeholder="예: 1990" />
              </label>
              <div class="born-field">성별
                <div class="seg seg-sm" id="born-sex" role="group" aria-label="성별">
                  <button type="button" data-v="male" aria-pressed="false">남자</button>
                  <button type="button" data-v="female" aria-pressed="false">여자</button>
                </div>
              </div>
              <label class="born-field">사는 곳
                <select id="born-region-sel"><option value="">선택 안 함</option></select>
              </label>
              <div class="born-row">
                <button type="submit" class="born-save">적용</button>
                <a class="born-more" href={`${base}me/#me-form`}>연봉·가구·자녀 더 입력 →</a>
              </div>
              <p class="born-note">이 브라우저에만 저장되며 서버나 분석 도구로 보내지 않습니다.</p>
              <button type="button" class="born-clear" id="born-clear">내 정보 모두 지우기</button>
            </form>
          </div>
        </div>
        <button class="theme-btn" type="button" aria-label="다크 모드 전환" id="theme-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
        </button>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>
          데이터: 통계청 KOSIS 국가통계포털 OpenAPI(행정안전부, 교육부, 고용노동부, 한국부동산원, 한국은행 등 작성기관 자료). 공공누리 제1유형 출처표시.
          이 사이트의 추계·지표는 공공 통계를 결합해 독자적으로 계산한 값이며 국가승인통계가 아닙니다.
        </p>
        <p>자료 갱신 <time datetime={updated.updated}>{updated.updated}</time> · 매월 2회 KOSIS 최신 자료를 받아 검증한 뒤 반영합니다.</p>
        <p><a href={`${base}methodology/`}>방법론과 한계</a> · <a href={`${base}glossary/`}>용어 사전</a> · <a href={`${base}changes/`}>수정 이력</a> · <a href={`${base}track/`}>예측 성적표</a> · <a href="https://github.com/geniuskey/stats">소스 코드</a> · © 2026 <a href="https://euiyun.com">Euiyun Lab</a></p>
      </div>
    </footer>
    <script>
      import { autoMount } from "../lib/charts";
      import { autoMountMaps } from "../lib/map";
      import { initMotion } from "../lib/anim";
      import { initFigures } from "../lib/figure";
      import { initToc } from "../lib/toc";
      import { getProfile, setProfile, clearProfile, onProfile, BORN_MIN, bornMax, type Sex } from "../lib/profile";
      initFigures();
      initToc();
      // 같은 제목의 그림이 한 페이지에 둘 이상이면 앵커가 겹치지 않게 -2, -3을 붙인다
      const seen = new Map<string, number>();
      document.querySelectorAll<HTMLElement>("figure[id^='fig-']").forEach((f) => {
        const n = (seen.get(f.id) ?? 0) + 1;
        seen.set(f.id, n);
        if (n > 1) f.id = `${f.id}-${n}`;
      });
      const btn = document.getElementById("theme-btn");
      btn?.addEventListener("click", () => {
        const root = document.documentElement;
        const dark = root.dataset.theme ? root.dataset.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        root.dataset.theme = dark ? "light" : "dark";
        try {
          localStorage.setItem("theme", root.dataset.theme);
        } catch (e) {}
      });
      // 상단 메뉴: 묶음은 하나만 열고, 바깥을 누르거나 Esc면 닫는다. 좁은 화면은 '메뉴' 버튼으로 전체를 펼친다.
      const header = document.querySelector<HTMLElement>(".site-header")!;
      const groups = [...document.querySelectorAll<HTMLDetailsElement>("[data-nav-group]")];
      const menuBtn = document.getElementById("menu-btn")!;
      const narrow = matchMedia("(max-width: 860px)");
      const closeGroups = (except?: HTMLDetailsElement) => groups.forEach((g) => g !== except && (g.open = false));
      const setMenu = (on: boolean) => {
        header.classList.toggle("menu-open", on);
        menuBtn.setAttribute("aria-expanded", String(on));
        document.getElementById("menu-label")!.textContent = on ? "닫기" : "메뉴";
        groups.forEach((g) => (g.open = on));
      };
      groups.forEach((g) => {
        g.addEventListener("toggle", () => {
          if (g.open && !narrow.matches) closeGroups(g);
        });
        g.querySelector("summary")!.addEventListener("click", (e) => {
          if (narrow.matches) e.preventDefault(); // 모바일 패널에서는 묶음을 항상 펼쳐 둔다
        });
      });
      menuBtn.addEventListener("click", () => setMenu(!header.classList.contains("menu-open")));
      narrow.addEventListener("change", () => setMenu(false));
      document.addEventListener("click", (e) => {
        if (!header.contains(e.target as Node)) {
          closeGroups();
          if (header.classList.contains("menu-open")) setMenu(false);
        }
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          closeGroups();
          setMenu(false);
        }
      });
      // 내 정보 칩
      const bornBox = document.getElementById("born")!;
      const bornBtn = document.getElementById("born-btn")!;
      const bornPop = document.getElementById("born-pop")!;
      const bornInput = document.getElementById("born-input") as HTMLInputElement;
      const bornLabel = document.getElementById("born-label")!;
      const bornRegion = document.getElementById("born-region")!;
      const regionSel = document.getElementById("born-region-sel") as HTMLSelectElement;
      const sexSeg = document.getElementById("born-sex")!;
      let sexPick: Sex | "" = "";
      const paintSex = () => sexSeg.querySelectorAll<HTMLButtonElement>("button").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.v === sexPick)));
      sexSeg.querySelectorAll<HTMLButtonElement>("button").forEach((b) =>
        b.addEventListener("click", () => {
          sexPick = sexPick === b.dataset.v ? "" : (b.dataset.v as Sex);
          paintSex();
        }),
      );
      // 시군구 목록은 창을 처음 열 때 받아 온다
      let regionsLoaded: Promise<void> | null = null;
      const loadRegions = () =>
        (regionsLoaded ??= fetch(`${import.meta.env.BASE_URL}regions.json`)
          .then((r) => r.json())
          .then((list: [string, string, string][]) => {
            const groups = new Map<string, HTMLOptGroupElement>();
            for (const [id, name, sido] of list) {
              if (!groups.has(sido)) {
                const g = document.createElement("optgroup");
                g.label = sido;
                groups.set(sido, g);
                regionSel.appendChild(g);
              }
              const o = document.createElement("option");
              o.value = id;
              o.textContent = `${sido} ${name}`;
              o.dataset.name = name;
              o.dataset.sido = sido;
              groups.get(sido)!.appendChild(o);
            }
          })
          .catch(() => {
            regionsLoaded = null;
          }));
      const fillForm = () => {
        const p = getProfile();
        bornInput.value = p.born?.toString() ?? "";
        sexPick = p.sex ?? "";
        paintSex();
        loadRegions()?.then(() => (regionSel.value = p.region?.id ?? ""));
      };
      const setPop = (on: boolean) => {
        bornPop.hidden = !on;
        bornBtn.setAttribute("aria-expanded", String(on));
        if (on) {
          hideHint(true);
          closeGroups();
          if (header.classList.contains("menu-open")) setMenu(false);
          fillForm();
          setTimeout(() => bornInput.focus(), 0);
        }
      };
      // 첫 방문 안내: 내 정보가 없고 아직 닫은 적이 없으면 칩 아래에 한 번 띄운다
      const hint = document.getElementById("born-hint")!;
      const HINT_KEY = "born-hint";
      const hideHint = (remember: boolean) => {
        hint.hidden = true;
        if (remember) {
          try {
            localStorage.setItem(HINT_KEY, "1");
          } catch (e) {}
        }
      };
      const isEmpty = () => Object.keys(getProfile()).length === 0;
      try {
        if (isEmpty() && !localStorage.getItem(HINT_KEY)) setTimeout(() => isEmpty() && bornPop.hidden && (hint.hidden = false), 1200);
      } catch (e) {}
      document.getElementById("born-hint-yes")!.addEventListener("click", (e) => {
        e.stopPropagation();
        hideHint(true);
        setPop(true);
      });
      document.getElementById("born-hint-no")!.addEventListener("click", () => hideHint(true));
      onProfile((p) => {
        if (!isEmpty()) hideHint(true);
        bornLabel.dataset.bornText = p.born ? `${p.born}년생` : "내 정보";
        bornRegion.dataset.bornText = p.region?.name ?? "";
        bornBox.classList.toggle("is-set", p.born != null || p.region != null);
      });
      bornBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        setPop(bornPop.hidden);
      });
      // 본문의 '내 정보 입력' 버튼: 같은 클릭이 바깥 클릭으로 닫지 않게 다음 틱에 연다 (헤더는 sticky라 늘 보인다)
      window.addEventListener("born:open", () => setTimeout(() => setPop(true), 0));
      document.getElementById("born-form")!.addEventListener("submit", (e) => {
        e.preventDefault();
        const raw = bornInput.value.trim();
        const v = Number(raw);
        if (raw && (!Number.isInteger(v) || v < BORN_MIN || v > bornMax())) {
          bornInput.setCustomValidity(`${BORN_MIN}~${bornMax()} 사이의 연도를 넣어 주세요`);
          bornInput.reportValidity();
          return;
        }
        const o = regionSel.selectedOptions[0];
        setProfile({
          born: raw ? v : null,
          sex: sexPick || null,
          region: o && o.value ? { id: o.value, name: o.dataset.name!, sido: o.dataset.sido!, sidoCode: o.value.slice(0, 2) } : null,
        });
        setPop(false);
      });
      bornInput.addEventListener("input", () => bornInput.setCustomValidity(""));
      document.getElementById("born-clear")!.addEventListener("click", () => {
        if (!confirm("이 브라우저에 저장된 내 정보(출생연도·사는 곳·연봉 등)를 모두 지울까요?")) return;
        clearProfile();
        setPop(false);
      });
      document.addEventListener("click", (e) => {
        if (!bornPop.hidden && !bornBox.contains(e.target as Node)) setPop(false);
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !bornPop.hidden) {
          setPop(false);
          bornBtn.focus();
        }
      });
      autoMount();
      autoMountMaps();
      initMotion();
      // 차트 형태 토글
      document.querySelectorAll<HTMLElement>("[data-switch]").forEach((fig) => {
        const btns = fig.querySelectorAll<HTMLButtonElement>("[data-view]");
        btns.forEach((b) =>
          b.addEventListener("click", () => {
            const v = b.dataset.view;
            btns.forEach((x) => {
              x.setAttribute("aria-pressed", String(x === b));
              x.setAttribute("aria-selected", String(x === b));
            });
            fig.querySelectorAll<HTMLElement>("[data-panel]").forEach((p) => {
              const on = p.dataset.panel === v;
              p.hidden = !on;
              if (on) {
                p.classList.remove("cs-in");
                void p.offsetWidth;
                p.classList.add("cs-in");
                autoMount(p);
              }
            });
          }),
        );
      });
      // 일반 페이지 스크립트가 그린 뒤 추가되는 요소용
      (window as any).__viz = { autoMount, autoMountMaps, initMotion };
    </script>
  </body>
</html>
