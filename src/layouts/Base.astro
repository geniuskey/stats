---
import "../styles/global.css";
import { SERVICES, NAV_GROUPS } from "../lib/nav";
import { ogKey } from "../lib/og";
import updated from "../data/updated.json";
interface Props {
  title: string;
  description?: string;
  active?: string;
  noindex?: boolean;
}
const { noindex = false, title, description = "통계청 KOSIS 공공 통계를 결합해 기존에 없던 지표와 시나리오 기반 미래 추계를 만듭니다.", active } = Astro.props;
const base = import.meta.env.BASE_URL;
const fullTitle = title === "홈" ? "숫자 너머 — 공공 통계로 보는 대한민국의 미래" : `${title} | 숫자 너머`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(`${base}og/${noindex ? "index" : ogKey(Astro.url.pathname, base)}.png`, Astro.site).href;
const home = new URL(base, Astro.site).href;
const svc = SERVICES.find((s) => s.slug === active);
// 검색 결과용 구조화 데이터: 홈은 WebSite, 나머지는 이동 경로(BreadcrumbList)
const crumbs = [{ name: "숫자 너머", url: home }];
if (active === "methodology") crumbs.push({ name: "방법론과 한계", url: canonical });
else if (svc) {
  const svcUrl = new URL(`${base}${svc.slug}/`, Astro.site).href;
  crumbs.push({ name: svc.title, url: svcUrl });
  if (svcUrl !== canonical) crumbs.push({ name: title, url: canonical });
}
const ld = title === "홈"
  ? { "@context": "https://schema.org", "@type": "WebSite", name: "숫자 너머", alternateName: "stats.euiyun.com", url: home, inLanguage: "ko", description }
  : { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: crumbs.map((c, i) => ({ "@type": "ListItem", position: i + 1, name: c.name, item: c.url })) };
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content="숫자 너머" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <meta name="theme-color" content="#f9f9f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0d0d" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      try {
        const t = localStorage.getItem("theme");
        if (t) document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={base}>
          <svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="13" width="4" height="9" rx="1.5" fill="var(--series-1)"></rect><rect x="10" y="8" width="4" height="14" rx="1.5" fill="var(--series-1)" opacity="0.7"></rect><path d="M17 3 L22 3 L22 8" fill="none" stroke="var(--series-2)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path><path d="M14 11 L22 3" fill="none" stroke="var(--series-2)" stroke-width="2.2" stroke-linecap="round" stroke-dasharray="3 2.4"></path></svg>
          숫자 너머
        </a>
        <nav class="nav" id="site-nav" aria-label="서비스">
          {NAV_GROUPS.map((g) => {
            const items = g.slugs.map((sl) => SERVICES.find((s) => s.slug === sl)!);
            const here = items.some((s) => s.slug === active);
            return (
              <details class="nav-group" data-nav-group>
                <summary class={here ? "is-here" : undefined}>{g.title}<svg class="nav-caret" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5 5 6.5 8 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></summary>
                <div class="nav-panel">
                  {items.map((s) => (
                    <a href={`${base}${s.slug}/`} aria-current={active === s.slug ? "page" : undefined}>
                      <span class="nav-item-title">{s.title}</span>
                      <span class="nav-item-desc">{s.desc}</span>
                    </a>
                  ))}
                </div>
              </details>
            );
          })}
          <span class="nav-sep" aria-hidden="true"></span>
          <a class="nav-link" href={`${base}map/`} aria-current={active === "map" ? "page" : undefined}>지도</a>
          <a class="nav-link" href={`${base}track/`} aria-current={active === "track" ? "page" : undefined}>성적표</a>
          <a class="nav-link" href={`${base}methodology/`} aria-current={active === "methodology" ? "page" : undefined}>방법론</a>
        </nav>
        <button class="menu-btn" type="button" aria-controls="site-nav" aria-expanded="false" id="menu-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
          메뉴
        </button>
        <button class="theme-btn" type="button" aria-label="다크 모드 전환" id="theme-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
        </button>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>
          데이터: 통계청 KOSIS 국가통계포털 OpenAPI(행정안전부, 교육부, 고용노동부, 한국부동산원, 한국은행 등 작성기관 자료). 공공누리 제1유형 출처표시.
          이 사이트의 추계·지표는 공공 통계를 결합해 독자적으로 계산한 값이며 국가승인통계가 아닙니다.
        </p>
        <p>자료 갱신 <time datetime={updated.updated}>{updated.updated}</time> · 매월 2회 KOSIS 최신 자료를 받아 검증한 뒤 반영합니다.</p>
        <p><a href={`${base}methodology/`}>방법론과 한계</a> · <a href="https://github.com/geniuskey/stats">소스 코드</a></p>
      </div>
    </footer>
    <script>
      import { autoMount } from "../lib/charts";
      import { autoMountMaps } from "../lib/map";
      import { initMotion } from "../lib/anim";
      const btn = document.getElementById("theme-btn");
      btn?.addEventListener("click", () => {
        const root = document.documentElement;
        const dark = root.dataset.theme ? root.dataset.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        root.dataset.theme = dark ? "light" : "dark";
        try {
          localStorage.setItem("theme", root.dataset.theme);
        } catch (e) {}
      });
      // 상단 메뉴: 묶음은 하나만 열고, 바깥을 누르거나 Esc면 닫는다. 좁은 화면은 '메뉴' 버튼으로 전체를 펼친다.
      const header = document.querySelector<HTMLElement>(".site-header")!;
      const groups = [...document.querySelectorAll<HTMLDetailsElement>("[data-nav-group]")];
      const menuBtn = document.getElementById("menu-btn")!;
      const narrow = matchMedia("(max-width: 860px)");
      const closeGroups = (except?: HTMLDetailsElement) => groups.forEach((g) => g !== except && (g.open = false));
      const setMenu = (on: boolean) => {
        header.classList.toggle("menu-open", on);
        menuBtn.setAttribute("aria-expanded", String(on));
        groups.forEach((g) => (g.open = on));
      };
      groups.forEach((g) => {
        g.addEventListener("toggle", () => {
          if (g.open && !narrow.matches) closeGroups(g);
        });
        g.querySelector("summary")!.addEventListener("click", (e) => {
          if (narrow.matches) e.preventDefault(); // 모바일 패널에서는 묶음을 항상 펼쳐 둔다
        });
      });
      menuBtn.addEventListener("click", () => setMenu(!header.classList.contains("menu-open")));
      narrow.addEventListener("change", () => setMenu(false));
      document.addEventListener("click", (e) => {
        if (!header.contains(e.target as Node)) {
          closeGroups();
          if (header.classList.contains("menu-open")) setMenu(false);
        }
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          closeGroups();
          setMenu(false);
        }
      });
      autoMount();
      autoMountMaps();
      initMotion();
      // 차트 형태 토글
      document.querySelectorAll<HTMLElement>("[data-switch]").forEach((fig) => {
        const btns = fig.querySelectorAll<HTMLButtonElement>("[data-view]");
        btns.forEach((b) =>
          b.addEventListener("click", () => {
            const v = b.dataset.view;
            btns.forEach((x) => {
              x.setAttribute("aria-pressed", String(x === b));
              x.setAttribute("aria-selected", String(x === b));
            });
            fig.querySelectorAll<HTMLElement>("[data-panel]").forEach((p) => {
              const on = p.dataset.panel === v;
              p.hidden = !on;
              if (on) {
                p.classList.remove("cs-in");
                void p.offsetWidth;
                p.classList.add("cs-in");
                autoMount(p);
              }
            });
          }),
        );
      });
      // 일반 페이지 스크립트가 그린 뒤 추가되는 요소용
      (window as any).__viz = { autoMount, autoMountMaps, initMotion };
    </script>
  </body>
</html>
