---
// 가로 막대 목록 (순위). 값은 막대 끝 오른쪽에 텍스트 토큰으로 표기.
import { fmt, type Fmt } from "../lib/format";
interface Props {
  items: { name: string; value: number; href?: string }[];
  format?: Fmt;
  diverging?: boolean;
  color?: string;
}
const { items, format = "pct", diverging = false, color = "var(--series-1)" } = Astro.props;
const maxAbs = Math.max(...items.map((i) => Math.abs(i.value)), 1e-9);
const hasNeg = items.some((i) => i.value < 0);
const hasPos = items.some((i) => i.value > 0);
const zero = hasNeg && hasPos ? 50 : hasNeg ? 100 : 0;
const scale = hasNeg && hasPos ? 50 : 100;
---
<div class="bar-list" role="list">
  {items.map((it) => {
    const w = (Math.abs(it.value) / maxAbs) * scale;
    const neg = it.value < 0;
    const c = diverging ? (neg ? "var(--div-neg)" : "var(--div-pos)") : color;
    const style = neg ? `right:${100 - zero}%;width:${w}%;background:${c}` : `left:${zero}%;width:${w}%;background:${c}`;
    return (
      <div class="bar-row" role="listitem">
        <span class="bar-name">{it.href ? <a href={it.href}>{it.name}</a> : it.name}</span>
        <span class="bar-track">
          <span class={`bar-fill ${neg ? "neg" : ""}`} style={style}></span>
          {hasNeg && <span class="bar-zero" style={`left:${zero}%`}></span>}
        </span>
        <span class="bar-val">{fmt(it.value, format === "pct" ? "pct" : format).replace(/^(\d)/, it.value > 0 && hasNeg ? "+$1" : "$1")}</span>
      </div>
    );
  })}
</div>
