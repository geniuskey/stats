---
interface Props {
  label: string;
  value: string;
  unit?: string;
  note?: string;
  tone?: "up" | "down";
  count?: boolean;
}
const { label, value, unit, note, tone, count = true } = Astro.props;
---
<div class="stat reveal">
  <div class="stat-label">{label}</div>
  <div data-count={count ? "" : undefined} class={`stat-value ${tone === "down" ? "delta-down" : tone === "up" ? "delta-up" : ""}`}>{value}{unit && <small>{unit}</small>}</div>
  {note && <div class="stat-note">{note}</div>}
</div>
