---
// 서비스 카드용 애니메이션 스파크라인 (서버 SVG, CSS로 선 그리기). 실측은 실선, 추계는 점선.
interface Props {
  actual: [number, number][];
  proj?: [number, number][];
  color?: string;
  w?: number;
  h?: number;
}
const { actual, proj = [], color = "var(--series-1)", w = 220, h = 54 } = Astro.props;
const all = [...actual, ...proj];
const xs = all.map((p) => p[0]),
  ys = all.map((p) => p[1]);
const x0 = Math.min(...xs),
  x1 = Math.max(...xs),
  y0 = Math.min(...ys),
  y1 = Math.max(...ys);
const pad = 5;
const X = (x: number) => pad + ((x - x0) / (x1 - x0 || 1)) * (w - pad * 2);
const Y = (y: number) => pad + (1 - (y - y0) / (y1 - y0 || 1)) * (h - pad * 2);
const path = (ps: [number, number][]) => ps.map(([x, y], i) => `${i ? "L" : "M"}${X(x).toFixed(1)},${Y(y).toFixed(1)}`).join("");
const projPath = proj.length ? path(actual.length ? [actual[actual.length - 1], ...proj] : proj) : "";
const area = actual.length > 1 ? `${path(actual)}L${X(actual[actual.length - 1][0]).toFixed(1)},${h}L${X(actual[0][0]).toFixed(1)},${h}Z` : "";
const last = all[all.length - 1];
---
<svg class="spark" viewBox={`0 0 ${w} ${h}`} preserveAspectRatio="none" aria-hidden="true">
  {area && <path d={area} fill={color} opacity="0.1" class="spark-area" />}
  <path d={path(actual)} fill="none" stroke={color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="spark-line" vector-effect="non-scaling-stroke" />
  {projPath && <path d={projPath} fill="none" stroke={color} stroke-width="2" stroke-dasharray="4 3" stroke-linecap="round" class="spark-proj" vector-effect="non-scaling-stroke" />}
  <circle cx={X(last[0])} cy={Y(last[1])} r="3.5" fill={color} class="spark-dot" />
</svg>
