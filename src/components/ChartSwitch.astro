---
// 같은 데이터를 여러 시각 형태로: 상단 토글로 차트 유형을 바꾼다. 숨겨진 차트는 처음 열 때 그린다.
import type { ChartSpec } from "../lib/charts";
interface View {
  label: string;
  spec: ChartSpec;
  note?: string;
}
interface Props {
  h?: 2 | 3;
  views: View[];
  table?: { headers: string[]; rows: (string | number)[][] };
  title?: string;
  sub?: string;
  id?: string;
}
const { views, table, title, sub, id, h = 3 } = Astro.props;
// 페이지에서 h1 바로 다음에 오는 카드면 h={2}로 제목 단계를 건너뛰지 않게 한다
const H = h === 2 ? "h2" : "h3";
---
<figure class="card chart-switch" style="margin:0" id={id} data-switch>
  <div class="cs-head">
    <div>
      {title && <H class="card-title">{title}</H>}
      {sub && <p class="card-sub">{sub}</p>}
    </div>
    <div class="seg seg-sm" role="tablist" aria-label="차트 형태" hidden={views.length < 2}>
      {views.map((v, i) => <button type="button" role="tab" data-view={i} aria-pressed={i === 0 ? "true" : "false"} aria-selected={i === 0 ? "true" : "false"}>{v.label}</button>)}
    </div>
  </div>
  {views.map((v, i) => (
    <div class="cs-panel" data-panel={i} hidden={i > 0} role="tabpanel">
      {v.note && <p class="small muted" style="margin:0 0 8px">{v.note}</p>}
      <div class="chart" data-chart>
        <script type="application/json" set:html={JSON.stringify(v.spec).replace(/</g, "\\u003c")} />
      </div>
    </div>
  ))}
  {table && (
    <details class="table-view">
      <summary>표로 보기</summary>
      <div class="table-wrap">
        <table>
          <thead><tr>{table.headers.map((h, i) => <th class={i ? "num" : ""}>{h}</th>)}</tr></thead>
          <tbody>{table.rows.map((r) => <tr>{r.map((c, i) => <td class={i ? "num" : ""}>{c}</td>)}</tr>)}</tbody>
        </table>
      </div>
    </details>
  )}
</figure>
